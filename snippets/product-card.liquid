{%- liquid
  assign first_variant = product.first_available_variant | default: product.variants[0]
  assign on_sale = false
  if first_variant.compare_at_price > first_variant.price
    assign on_sale = true
    assign savings = first_variant.compare_at_price | minus: first_variant.price | times: 100 | divided_by: first_variant.compare_at_price
  endif
  assign color_option = product.options_with_values | where: 'name', 'Colour' | first
  unless color_option
    assign color_option = product.options_with_values | where: 'name', 'Color' | first
  endunless

  assign size_option = product.options_with_values | where: 'name', 'Size' | first
  unless size_option
    assign size_option = product.options_with_values | where: 'name', 'UK Size' | first
  endunless
  unless size_option
    assign size_option = product.options_with_values | where: 'name', 'Shoe Size' | first
  endunless

  assign size_position = 0
  for option in product.options
    assign option_down = option | downcase
    if option_down == 'size' or option_down == 'uk size' or option_down == 'shoe size'
      assign size_position = forloop.index
    endif
  endfor

  assign low_stock = false
  assign total_inventory = 0
  for variant in product.variants
    if variant.available
      assign total_inventory = total_inventory | plus: variant.inventory_quantity
    endif
  endfor
  if total_inventory > 0 and total_inventory < 6
    assign low_stock = true
  endif

  assign is_new = false
  if product.tags contains 'new-arrival' or product.tags contains 'New' or product.tags contains 'new'
    assign is_new = true
  endif
  assign is_trending = false
  if product.tags contains 'trending' or product.tags contains 'Trending'
    assign is_trending = true
  endif
-%}

<article class="product-card fade-up" aria-label="{{ product.title | escape }}">
  <a class="product-card__media" href="{{ product.url }}" aria-tabindex="-1" tabindex="-1" aria-hidden="true">
    {%- if product.featured_image != blank -%}
      <img
        class="product-card__img"
        src="{{ product.featured_image | image_url: width: 600 }}"
        srcset="
          {{ product.featured_image | image_url: width: 400 }} 400w,
          {{ product.featured_image | image_url: width: 600 }} 600w,
          {{ product.featured_image | image_url: width: 800 }} 800w
        "
        sizes="(max-width:480px) 50vw, (max-width:768px) 50vw, (max-width:1024px) 33vw, 25vw"
        alt="{{ product.featured_image.alt | escape | default: product.title }}"
        loading="lazy"
        width="{{ product.featured_image.width }}"
        height="{{ product.featured_image.height }}"
      >
      {%- if product.images.size > 1 -%}
        <img
          class="product-card__img product-card__img--alt"
          src="{{ product.images[1] | image_url: width: 600 }}"
          alt="{{ product.images[1].alt | escape | default: product.title }}"
          loading="lazy"
          width="{{ product.images[1].width }}"
          height="{{ product.images[1].height }}"
          aria-hidden="true"
        >
      {%- endif -%}
    {%- else -%}
      <div class="product-card__placeholder">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
      </div>
    {%- endif -%}

    <div class="product-card__badges">
      {%- if on_sale -%}<span class="badge badge--sale">-{{ savings }}%</span>{%- endif -%}
      {%- if is_new -%}<span class="badge badge--new">New</span>{%- endif -%}
      {%- if is_trending -%}<span class="badge badge--trending">🔥 Trending</span>{%- endif -%}
      {%- unless product.available -%}<span class="badge badge--soldout">Sold Out</span>{%- endunless -%}
      {%- if product.tags contains 'best-seller' or product.tags contains 'bestseller' -%}<span class="badge badge--bestseller">Best Seller</span>{%- endif -%}
    </div>

    {%- if low_stock and product.available -%}
      <div class="product-card__low-stock">
        <span class="low-stock-dot"></span> Only {{ total_inventory }} left
      </div>
    {%- endif -%}

    <button class="product-card__wishlist" aria-label="Save {{ product.title | escape }} to wishlist" type="button">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
      </svg>
    </button>

    {%- if size_option and product.available -%}
      <div class="product-card__quick-sizes" role="group" aria-label="Quick add by size">
        <p class="product-card__quick-sizes-label">Quick Add</p>
        <div class="product-card__quick-sizes-grid">
          {%- for size_val in size_option.values limit: 10 -%}
            {%- assign size_avail = false -%}
            {%- assign size_variant_id = '' -%}
            {%- for variant in product.variants -%}
              {%- if size_position == 1 and variant.option1 == size_val -%}
                {%- if variant.available -%}
                  {%- assign size_avail = true -%}
                  {%- assign size_variant_id = variant.id -%}
                {%- endif -%}
              {%- elsif size_position == 2 and variant.option2 == size_val -%}
                {%- if variant.available -%}
                  {%- assign size_avail = true -%}
                  {%- assign size_variant_id = variant.id -%}
                {%- endif -%}
              {%- elsif size_position == 3 and variant.option3 == size_val -%}
                {%- if variant.available -%}
                  {%- assign size_avail = true -%}
                  {%- assign size_variant_id = variant.id -%}
                {%- endif -%}
              {%- endif -%}
            {%- endfor -%}
            {%- if size_avail -%}
              <button
                class="qs-chip"
                data-variant-id="{{ size_variant_id }}"
                data-product-title="{{ product.title | escape }}"
                aria-label="Add size {{ size_val }} to bag"
                type="button"
              >{{ size_val }}</button>
            {%- else -%}
              <span class="qs-chip qs-chip--sold" aria-label="Size {{ size_val }} sold out">{{ size_val }}</span>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    {%- elsif product.variants.size == 1 and product.available -%}
      <button class="product-card__quick-add" data-variant-id="{{ first_variant.id }}" aria-label="Quick add {{ product.title | escape }} to bag" type="button">
        Quick Add
      </button>
    {%- elsif product.available -%}
      <a class="product-card__quick-add" href="{{ product.url }}">Select Options</a>
    {%- endif -%}
  </a>

  <div class="product-card__body">
    {%- if product.vendor != blank -%}
      <div class="product-card__vendor">{{ product.vendor }}</div>
    {%- endif -%}
    <h3 class="product-card__title">
      <a href="{{ product.url }}" style="color:inherit">{{ product.title }}</a>
    </h3>
    <div class="product-card__price">
      {%- if on_sale -%}
        <span class="product-card__price-was">{{ first_variant.compare_at_price | money }}</span>
        <span class="product-card__price-current product-card__price-current--sale">{{ first_variant.price | money }}</span>
        <span class="product-card__price-save">Save {{ savings }}%</span>
      {%- else -%}
        <span class="product-card__price-current">
          {%- if product.price_varies -%}From {% endif -%}
          {{ product.price_min | money }}
        </span>
      {%- endif -%}
    </div>

    {%- if size_option -%}
      <div class="product-card__size-row" aria-label="Available sizes">
        {%- for size_val in size_option.values limit: 9 -%}
          {%- assign size_avail = false -%}
          {%- for variant in product.variants -%}
            {%- if variant.available -%}
              {%- if size_position == 1 and variant.option1 == size_val -%}
                {%- assign size_avail = true -%}
              {%- elsif size_position == 2 and variant.option2 == size_val -%}
                {%- assign size_avail = true -%}
              {%- elsif size_position == 3 and variant.option3 == size_val -%}
                {%- assign size_avail = true -%}
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
          <span class="size-pip{% unless size_avail %} size-pip--sold{% endunless %}" title="{% if size_avail %}Size {{ size_val }}{% else %}Size {{ size_val }} — Sold Out{% endif %}">{{ size_val }}</span>
        {%- endfor -%}
        {%- if size_option.values.size > 9 -%}
          <span class="size-pip size-pip--more">+{{ size_option.values.size | minus: 9 }}</span>
        {%- endif -%}
      </div>
    {%- elsif color_option and color_option.values.size > 1 -%}
      <div class="product-card__colors" aria-label="Colours available">
        {%- for color in color_option.values limit: 5 -%}
          <span class="color-swatch" style="background-color:{{ color | downcase | replace: ' ', '' }}" title="{{ color }}" aria-label="{{ color }}"></span>
        {%- endfor -%}
        {%- if color_option.values.size > 5 -%}
          <span style="font-size:0.7rem;color:var(--color-text-muted)">+{{ color_option.values.size | minus: 5 }}</span>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</article>
