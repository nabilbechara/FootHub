{%- liquid
  assign first_variant = product.first_available_variant | default: product.variants[0]
  assign on_sale = false
  if first_variant.compare_at_price > first_variant.price
    assign on_sale = true
    assign savings = first_variant.compare_at_price | minus: first_variant.price | times: 100 | divided_by: first_variant.compare_at_price
  endif
  assign color_option = product.options_with_values | where: 'name', 'Colour' | first
  unless color_option
    assign color_option = product.options_with_values | where: 'name', 'Color' | first
  endunless
-%}

<article class="product-card fade-up" aria-label="{{ product.title | escape }}">
  <a class="product-card__media" href="{{ product.url }}" aria-tabindex="-1" tabindex="-1" aria-hidden="true">
    {%- if product.featured_image != blank -%}
      <img
        class="product-card__img"
        src="{{ product.featured_image | image_url: width: 600 }}"
        srcset="
          {{ product.featured_image | image_url: width: 400 }} 400w,
          {{ product.featured_image | image_url: width: 600 }} 600w,
          {{ product.featured_image | image_url: width: 800 }} 800w
        "
        sizes="(max-width:480px) 100vw, (max-width:768px) 50vw, (max-width:1024px) 33vw, 25vw"
        alt="{{ product.featured_image.alt | escape | default: product.title }}"
        loading="lazy"
        width="{{ product.featured_image.width }}"
        height="{{ product.featured_image.height }}"
      >
      {%- if product.images.size > 1 -%}
        <img
          class="product-card__img product-card__img--alt"
          src="{{ product.images[1] | image_url: width: 600 }}"
          alt="{{ product.images[1].alt | escape | default: product.title }}"
          loading="lazy"
          width="{{ product.images[1].width }}"
          height="{{ product.images[1].height }}"
          aria-hidden="true"
        >
      {%- endif -%}
    {%- else -%}
      <div style="width:100%;height:100%;background:var(--color-gray-100);display:flex;align-items:center;justify-content:center;color:var(--color-gray-300)">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
      </div>
    {%- endif -%}

    <div class="product-card__badges">
      {%- if on_sale -%}<span class="badge badge--sale">-{{ savings }}%</span>{%- endif -%}
      {%- if product.tags contains 'new-arrival' or product.tags contains 'New' -%}<span class="badge badge--new">New</span>{%- endif -%}
      {%- unless product.available -%}<span class="badge badge--soldout">Sold Out</span>{%- endunless -%}
      {%- if product.tags contains 'best-seller' or product.tags contains 'bestseller' -%}<span class="badge badge--bestseller">Best Seller</span>{%- endif -%}
    </div>

    <button class="product-card__wishlist" aria-label="Save {{ product.title | escape }} to wishlist" type="button">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
      </svg>
    </button>

    {%- if product.variants.size == 1 and product.available -%}
      <button class="product-card__quick-add" data-variant-id="{{ first_variant.id }}" aria-label="Quick add {{ product.title | escape }} to bag" type="button">
        Quick Add
      </button>
    {%- elsif product.available -%}
      <a class="product-card__quick-add" href="{{ product.url }}">Select Options</a>
    {%- endif -%}
  </a>

  <div class="product-card__body">
    {%- if product.vendor != blank -%}
      <div class="product-card__vendor">{{ product.vendor }}</div>
    {%- endif -%}
    <h3 class="product-card__title">
      <a href="{{ product.url }}" style="color:inherit">{{ product.title }}</a>
    </h3>
    <div class="product-card__price">
      {%- if on_sale -%}
        <span class="product-card__price-was">{{ first_variant.compare_at_price | money }}</span>
        <span class="product-card__price-current">{{ first_variant.price | money }}</span>
        <span class="product-card__price-save">-{{ savings }}%</span>
      {%- else -%}
        <span class="product-card__price-current">
          {%- if product.price_varies -%}From {% endif -%}
          {{ product.price_min | money }}
        </span>
      {%- endif -%}
    </div>
    {%- if color_option and color_option.values.size > 1 -%}
      <div class="product-card__colors" aria-label="Colours available">
        {%- for color in color_option.values limit: 5 -%}
          <span class="color-swatch" style="background-color:{{ color | downcase | replace: ' ', '' }}" title="{{ color }}" aria-label="{{ color }}"></span>
        {%- endfor -%}
        {%- if color_option.values.size > 5 -%}
          <span style="font-size:0.7rem;color:var(--color-text-muted)">+{{ color_option.values.size | minus: 5 }}</span>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</article>
