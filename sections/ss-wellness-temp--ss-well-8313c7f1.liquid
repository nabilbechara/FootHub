        .lst-rev-body-wrap-{{ block.id }}:not(.l4rev-expanded) .lst-rev-read-less-{{ block.id }} {
          display: none;
        }
        .lst-rev-reply-{{ block.id }} {
          margin-top: 10px;
          padding: 10px 12px;
          background: {{ block.settings.reply_bg_color }};
          border-radius: {{ block.settings.card_radius | times: 0.4 | round: 0 }}px;
          border-left: 3px solid {{ block.settings.card_border_color }};
        }
        .lst-rev-reply-meta-{{ block.id }} {
          display: flex;
          align-items: baseline;
          flex-wrap: wrap;
