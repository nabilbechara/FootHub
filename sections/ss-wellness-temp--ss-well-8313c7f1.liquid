                    {% if block.settings[_st_stat_key] != blank %}
                      <p
                        class="lst-stats-card-stat-{{ block.id }}"
                        {% if block.settings.enable_count_animation %}
                          data-countup="{{ block.settings[_st_stat_key] }}"
                        {% endif %}
                      >
                        {{ block.settings[_st_stat_key] }}
                      </p>
                    {% endif %}
                    {% if block.settings[_st_text_key] != blank %}
                      <p class="lst-stats-card-text-{{ block.id }}">{{ block.settings[_st_text_key] }}</p>
                    {% endif %}
                  </div>
                {% endif %}
              {% endfor %}
            </div>

            {% if block.settings.disclaimer != blank %}
              <div class="lst-stats-disclaimer-{{ block.id }}">{{ block.settings.disclaimer }}</div>
            {% endif %}
          </div>

          {% if block.settings.enable_count_animation %}
            <script>
              (function () {
                var els = document.querySelectorAll('.lst-stats-{{ block.id }} [data-countup]');
                if (!els.length) return;
                var ran = false;
                var obs = new IntersectionObserver(
                  function (entries) {
                    if (ran || !entries[0].isIntersecting) return;
                    ran = true;
                    obs.disconnect();
                    els.forEach(function (el) {
                      var raw = el.getAttribute('data-countup');
                      var match = raw.match(/^([^0-9]*)(\d+(?:\.\d+)?)(.*)$/);
                      if (!match) return;
                      var pre = match[1],
                        num = parseFloat(match[2]),
                        suf = match[3];
                      var dur = 1400,
                        start = null;
                      function step(ts) {
                        if (!start) start = ts;
                        var p = Math.min((ts - start) / dur, 1);
                        var ease = 1 - Math.pow(1 - p, 3);
                        var cur = num % 1 === 0 ? Math.round(ease * num) : (ease * num).toFixed(1);
                        el.textContent = pre + cur + suf;
                        if (p < 1) requestAnimationFrame(step);
                      }
                      requestAnimationFrame(step);
                    });
                  },
                  { threshold: 0.4 }
                );
                var card = document.querySelector('.lst-stats-cards-{{ block.id }}');
                if (card) obs.observe(card);
              })();
            </script>
          {% endif %}

          {% if _stats_has_video %}
            <script>
              (function () {
                var wrap = document.querySelector('.lst-stats-{{ block.id }}');
                if (!wrap) return;
                var vid = wrap.querySelector('[data-stats-video]');
                var playBtn = wrap.querySelector('[data-stats-play]');
                var playIcon = playBtn && playBtn.querySelector('[data-stats-play-icon] path');
                var d_pause = 'M6 19h4V5H6v14zm8-14v14h4V5h-4z';
                var d_play = 'M8 5v14l11-7z';

                function isMobilePosterLayout() {
                  return window.matchMedia('(max-width: 767px)').matches || wrap.getBoundingClientRect().width <= 767;
                }

                function syncStatsPoster() {
                  if (!vid) return;
                  var desktopPoster = vid.getAttribute('data-stats-poster-desktop');
                  var mobilePoster = vid.getAttribute('data-stats-poster-mobile');
                  var nextPoster =
                    isMobilePosterLayout() && mobilePoster ? mobilePoster : desktopPoster || mobilePoster;
                  if (nextPoster && vid.getAttribute('poster') !== nextPoster) {
                    vid.setAttribute('poster', nextPoster);
                  }
                }

                syncStatsPoster();
                window.addEventListener('resize', syncStatsPoster);
                if ('ResizeObserver' in window) {
                  var statsPosterObserver = new ResizeObserver(syncStatsPoster);
                  statsPosterObserver.observe(wrap);
                }

                if (playBtn && vid) {
                  setTimeout(function () {
                    vid.play().catch(function () {
                      if (playIcon) playIcon.setAttribute('d', d_play);
                    });
                  }, 100);
                  playBtn.addEventListener('click', function () {
                    if (vid.paused) {
                      vid.play();
                      if (playIcon) playIcon.setAttribute('d', d_pause);
                    } else {
                      vid.pause();
                      if (playIcon) playIcon.setAttribute('d', d_play);
                    }
                  });
                }
              })();
            </script>
          {% endif %}
