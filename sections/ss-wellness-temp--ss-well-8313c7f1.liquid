          border-style: solid;
          border-color: {{ block.settings.variant_picker_border_color }};
          border-radius: {{ block.settings.variant_picker_radius }}px;
          background-color: transparent;
          font-size: {{ text_size_mobile }}px;
          color: {{ block.settings.variant_picker_text_color }};
          cursor: pointer;
          -webkit-appearance: none;
          -moz-appearance: none;
          appearance: none;
          background-image: url("data:image/svg+xml,%3Csvg width='20' height='20' viewBox='0 0 20 20' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath fill-rule='evenodd' clip-rule='evenodd' d='M5.71967 8.46967C6.01256 8.17678 6.48744 8.17678 6.78033 8.46967L10.25 11.9393L13.7197 8.46967C14.0126 8.17678 14.4874 8.17678 14.7803 8.46967C15.0732 8.76256 15.0732 9.23744 14.7803 9.53033L10.7803 13.5303C10.4874 13.8232 10.0126 13.8232 9.71967 13.5303L5.71967 9.53033C5.42678 9.23744 5.42678 8.76256 5.71967 8.46967Z' fill='{{ block.settings.variant_picker_text_color | url_encode }}'/%3E%3C/svg%3E");
          background-repeat: no-repeat;
          background-position: right 12px center;
          background-size: 20px 20px;
          line-height: 1.4;
          box-sizing: border-box;
          outline: none;
          font-family: var(--l4text-font, inherit);
          font-weight: var(--l4text-weight, inherit);
          font-style: var(--l4text-style, inherit);
        }
        .lst-fp-variant-select-{{ block.id }}:focus {
          outline: none;
          box-shadow: none;
        }
        .lst-fp-variant-pills-{{ block.id }} {
          display: flex;
          flex-wrap: wrap;
          gap: 8px;
        }
        .lst-fp-variant-pill-{{ block.id }} {
          padding: 8px 16px;
          border-width: 1px;
          border-style: solid;
          border-color: {{ block.settings.variant_picker_border_color }};
          border-radius: {{ block.settings.variant_picker_radius }}px;
          background-color: transparent;
          color: {{ block.settings.variant_picker_text_color }};
          font-size: {{ text_size_mobile }}px;
          cursor: pointer;
          line-height: 1.4;
          font-family: var(--l4text-font, inherit);
          font-weight: var(--l4text-weight, inherit);
          font-style: var(--l4text-style, inherit);
          transition: background-color 0.15s, color 0.15s;
        }
        .lst-fp-variant-pill-{{ block.id }}:disabled,
        .lst-fp-variant-pill-{{ block.id }}.disabled {
          opacity: 0.4;
          cursor: not-allowed;
          text-decoration: line-through;
        }
        .lst-fp-variant-pill-{{ block.id }}.active {
          background-color: {{ section.settings.btn_filled_bg_color }};
          border-color: {{ section.settings.btn_filled_bg_color }};
          color: {{ section.settings.btn_filled_color }};
        }
        .lst-fp-variant-pill-{{ block.id }}:hover:not(:disabled):not(.disabled):not(.active) {
          background-color: {{ block.settings.variant_picker_border_color }};
          color: {{ section.settings.btn_filled_color }};
        }
        .lst-fp-shipping-{{ block.id }} {
          font-size: {{ text_size_mobile | minus: 2 }}px;
          line-height: {{ section.settings.text_line_height }}%;
          color: {{ block.settings.shipping_color }};
          font-family: var(--l4text-font, inherit);
          font-weight: var(--l4text-weight, inherit);
          font-style: var(--l4text-style, inherit);
          text-align: center;
          margin-bottom: 18px;
        }
        .lst-fp-trust-{{ block.id }} {
          display: flex;
          align-items: center;
          gap: 12px;
          margin-top: auto;
          padding-top: 18px;
          border-top: 1px solid {{ block.settings.trust_divider_color }};
        }
        .lst-fp-trust-icon-{{ block.id }} {
          width: {{ block.settings.trust_icon_size }}px;
          height: {{ block.settings.trust_icon_size }}px;
          flex-shrink: 0;
          object-fit: contain;
        }
        .lst-fp-trust-title-{{ block.id }} {
          font-size: {{ text_size_mobile }}px;
          color: {{ block.settings.trust_title_color }};
          font-family: var(--l4heading-font, inherit);
          margin: 0 0 2px;
          font-weight: var(--l4heading-weight, inherit);
          font-style: var(--l4heading-style, inherit);
        }
        .lst-fp-trust-sub-{{ block.id }} {
          font-size: {{ text_size_mobile | minus: 2 }}px;
          color: {{ block.settings.trust_sub_color }};
          line-height: {{ section.settings.text_line_height }}%;
          font-family: var(--l4text-font, inherit);
          font-weight: var(--l4text-weight, inherit);
          margin: 0;
          font-style: italic;
        }
        .lst-fp-right-{{ block.id }} {
          display: flex;
          flex-direction: column;
        }
        .lst-fp-img-{{ block.id }} {
          display: block;
          width: 100%;
          height: 260px;
          object-fit: cover;
          object-position: center;
          flex-shrink: 0;
        }
        .lst-fp-feats-card-{{ block.id }} {
          background: {{ block.settings.feats_card_bg_color }};
          padding: 20px {{ section.settings.padding_horizontal_mobile }}rem;
          flex: 1;
        }
        .lst-fp-feat-heading-{{ block.id }} {
          font-size: {{ text_size_mobile | minus: 2 }}px;
          letter-spacing: 0.12em;
          text-transform: uppercase;
          font-weight: var(--l4text-weight, inherit);
          font-style: var(--l4text-style, inherit);
          color: {{ block.settings.feat_heading_color }};
          font-family: var(--l4text-font, inherit);
          line-height: {{ section.settings.text_line_height }}%;
          margin: 0 0 14px;
        }
        .lst-fp-feats-list-{{ block.id }} {
          list-style: none;
          margin: 0;
          padding: 0;
          display: flex;
          flex-direction: column;
          gap: 10px;
        }
        .lst-fp-feat-{{ block.id }} {
          display: flex;
          align-items: flex-start;
          gap: 10px;
        }
        .lst-fp-feat-chk-{{ block.id }} {
          display: flex;
          align-items: center;
          width: 18px;
          height: 18px;
          flex-shrink: 0;
          margin-top: 1px;
          color: {{ block.settings.feat_check_color }};
        }
        .lst-fp-feat-chk-{{ block.id }} svg,
        .lst-fp-feat-chk-{{ block.id }} img {
          display: block;
          width: 18px;
          height: 18px;
          object-fit: contain;
        }
        .lst-fp-feat-text-{{ block.id }} {
          font-size: {{ text_size_mobile | minus: 1 }}px;
          color: {{ block.settings.feat_text_color }};
          font-family: var(--l4text-font, inherit);
          font-weight: var(--l4text-weight, inherit);
          font-style: var(--l4text-style, inherit);
          line-height: {{ section.settings.text_line_height }}%;
        }
        .lst-fp-feat-text-{{ block.id }} strong {
          color: {{ block.settings.feat_strong_color }};
          font-weight: 700;
        }
        @media (min-width: 1024px) {
          .lst-fp-card-{{ block.id }} {
            flex-direction: row;
          }
          .lst-fp-left-{{ block.id }} {
            flex: 1;
            padding: 40px 40px 40px;
          }
          .lst-fp-right-{{ block.id }} {
            flex: 1;
          }
          .lst-fp-img-{{ block.id }} {
            height: 340px;
          }
          .lst-fp-title-{{ block.id }} {
            font-size: {{ heading_size }}px;
            margin-bottom: 12px;
          }
          .lst-fp-desc-{{ block.id }} {
            font-size: {{ text_size }}px;
            margin-bottom: 22px;
          }
          .lst-fp-price-{{ block.id }} {
            font-size: {{ heading_size }}px;
          }
          .lst-fp-price-pre-{{ block.id }} {
            font-size: {{ text_size }}px;
          }
          .lst-fp-price-suf-{{ block.id }} {
            font-size: {{ text_size | minus: 1 }}px;
          }
          .lst-fp-compare-badge-{{ block.id }} {
            font-size: {{ text_size | minus: 3 }}px;
          }
          .lst-fp-compare-note-{{ block.id }} {
            font-size: {{ text_size | minus: 2 }}px;
          }
          .lst-fp-shipping-{{ block.id }} {
            font-size: {{ text_size | minus: 2 }}px;
          }
          .lst-fp-trust-title-{{ block.id }} {
            font-size: {{ text_size }}px;
          }
          .lst-fp-trust-sub-{{ block.id }} {
            font-size: {{ text_size | minus: 2 }}px;
          }
          .lst-fp-btn-{{ block.id }} {
            font-size: {{ btn_size }}px;
            padding: {{ btn_padding_v }}px {{ btn_padding_h }}px;
          }
          .lst-fp-feats-card-{{ block.id }} {
            padding: 28px 32px;
          }
          .lst-fp-feat-heading-{{ block.id }} {
            font-size: {{ text_size | minus: 2 }}px;
            margin-bottom: 18px;
          }
          .lst-fp-feat-text-{{ block.id }} {
            font-size: {{ text_size | minus: 1 }}px;
          }
          .lst-fp-variant-select-{{ block.id }} {
            font-size: {{ text_size }}px;
          }
          .lst-fp-variant-pill-{{ block.id }} {
            font-size: {{ text_size }}px;
          }
        }
    {% endcase %}
  {%- endstyle -%}
{% endfor %}

<div class="lst-section-{{ section.id }}">
  {% for block in section.blocks %}
    {% case block.type %}
      {% when 'ambassadors' %}
        <div class="lst-amb-{{ block.id }} l4-block" {{ block.shopify_attributes }}>
          <div class="lst-amb-inner-{{ block.id }} l4-inner">
            {% if block.settings.badge != blank
              or block.settings.heading != blank
              or block.settings.accent_text != blank
            %}
              <div class="lst-amb-header-{{ block.id }} l4-header">
                {% if block.settings.badge != blank %}
                  <span class="lst-amb-badge-{{ block.id }} l4-badge">{{ block.settings.badge }}</span>
                {% endif %}
                {% if block.settings.heading != blank %}
                  <div class="lst-amb-heading-{{ block.id }} l4-heading">{{ block.settings.heading }}</div>
                {% endif %}
                {% if block.settings.accent_text != blank %}
                  <p class="lst-amb-accent-{{ block.id }} l4-accent{% if block.settings.accent_gradient != blank %} l4-accent--gradient{% endif %}">
                    {{ block.settings.accent_text }}
                  </p>
                {% endif %}
              </div>
            {% endif %}

            {%- capture amb_cards -%}
              {% for i in (1..6) %}
                {%- assign amb_image_key = 'card' | append: i | append: '_image' -%}
                {%- assign amb_name_key = 'card' | append: i | append: '_name' -%}
                {%- assign amb_role_key = 'card' | append: i | append: '_role' -%}
                {%- assign amb_tag_key = 'card' | append: i | append: '_tag' -%}
                {%- assign amb_quote_key = 'card' | append: i | append: '_quote' -%}
                {%- assign amb_image = block.settings[amb_image_key] -%}
                {%- assign amb_name = block.settings[amb_name_key] -%}
                {%- assign amb_role = block.settings[amb_role_key] -%}
                {%- assign amb_tag = block.settings[amb_tag_key] -%}
                {%- assign amb_quote = block.settings[amb_quote_key] -%}
                {% if amb_name != blank or amb_image != blank %}
                  <div class="lst-amb-card-wrap-{{ block.id }}">
                    <div class="lst-amb-card-{{ block.id }}">
                      <div class="lst-amb-card-img-wrap-{{ block.id }}">
                        {% if amb_image != blank %}
                          {{
                            amb_image
                            | image_url: width: 800
                            | image_tag: loading: 'lazy', widths: '400, 600, 800', alt: amb_image.alt
                          }}
                        {% else %}
                          <div style="width:100%;height:100%;background:#F3F3F3;display:flex;align-items:center;justify-content:center;">
                            {{ 'image' | placeholder_svg_tag }}
                          </div>
                        {% endif %}
                      </div>

                      {% if amb_quote != blank %}
                        <div class="lst-amb-card-overlay-{{ block.id }}"></div>
                      {% endif %}

                      <div class="lst-amb-card-default-{{ block.id }}">
                        {% if amb_role != blank %}
                          <p class="lst-amb-role-d-{{ block.id }}">{{ amb_role }}</p>
                        {% endif %}
                        {% if amb_name != blank %}
                          <p class="lst-amb-name-d-{{ block.id }}">{{ amb_name }}</p>
                        {% endif %}
                        {% if amb_tag != blank %}
                          <span class="lst-amb-tag-{{ block.id }}">{{ amb_tag }}</span>
                        {% endif %}
                      </div>

                      {% if amb_quote != blank or amb_name != blank or amb_role != blank %}
                        <div class="lst-amb-card-hover-{{ block.id }}">
                          {% if amb_role != blank %}
                            <p class="lst-amb-role-h-{{ block.id }}">{{ amb_role }}</p>
                          {% endif %}
                          {% if amb_name != blank %}
                            <p class="lst-amb-name-h-{{ block.id }}">{{ amb_name }}</p>
                          {% endif %}
                      {% if amb_quote != blank %}
                        <p class="lst-amb-quote-{{ block.id }}">{{ amb_quote }}</p>
                      {% endif %}
                        </div>
                      {% endif %}
                    </div>
                  </div>
                {% endif %}
              {% endfor %}
            {%- endcapture -%}

            <div class="lst-amb-grid-{{ block.id }}">
              {{ amb_cards }}
            </div>

            <div class="lst-amb-swiper-wrap-{{ block.id }}">
              <div class="swiper lst-amb-swiper-{{ block.id }}">
                <div class="swiper-wrapper">
                  {{ amb_cards | replace: 'class="lst-amb-card-wrap-', 'class="swiper-slide lst-amb-card-wrap-' }}
                </div>
                <div class="swiper-pagination"></div>
              </div>
            </div>

            <script>
              var ambSwiper_{{ block.id | replace: '-', '_' }} = null;
              var ambMq_{{ block.id | replace: '-', '_' }} = window.matchMedia('(min-width: 1024px)');

              function matchAmbHeights_{{ block.id | replace: '-', '_' }}() {
                var wrap = document.querySelector('.lst-amb-{{ block.id }}');
                if (!wrap) return;
                var defaults = wrap.querySelectorAll('.lst-amb-card-default-{{ block.id }}');
                var maxH = 0;
                defaults.forEach(function(el) { el.style.height = 'auto'; });
                defaults.forEach(function(el) {
                  if (el.offsetHeight > maxH) maxH = el.offsetHeight;
                });
                if (maxH > 0) {
                  defaults.forEach(function(el) { el.style.height = maxH + 'px'; });
                }
              }

              function initAmbSwiper_{{ block.id | replace: '-', '_' }}() {
                var swiperWrap = document.querySelector('.lst-amb-swiper-{{ block.id }}');
                if (!swiperWrap) return;
                var isDesktop = ambMq_{{ block.id | replace: '-', '_' }}.matches;

                if (isDesktop) {
                  if (ambSwiper_{{ block.id | replace: '-', '_' }}) {
                    ambSwiper_{{ block.id | replace: '-', '_' }}.destroy(true, true);
                    ambSwiper_{{ block.id | replace: '-', '_' }} = null;
                  }
                } else {
                  if (!ambSwiper_{{ block.id | replace: '-', '_' }}) {
                    ambSwiper_{{ block.id | replace: '-', '_' }} = new Swiper(swiperWrap, {
                      slidesPerView: 1.2,
                      spaceBetween: 16,
                      pagination: { el: swiperWrap.querySelector('.swiper-pagination'), clickable: true },
                      breakpoints: { 768: { slidesPerView: 2.2 } }
                    });
                  }
                }
                matchAmbHeights_{{ block.id | replace: '-', '_' }}();
              }

              document.addEventListener('DOMContentLoaded', initAmbSwiper_{{ block.id | replace: '-', '_' }});
              window.addEventListener('load', matchAmbHeights_{{ block.id | replace: '-', '_' }});
              window.addEventListener('resize', function() {
                clearTimeout(window.ambResizeTimer_{{ block.id | replace: '-', '_' }});
                window.ambResizeTimer_{{ block.id | replace: '-', '_' }} = setTimeout(matchAmbHeights_{{ block.id | replace: '-', '_' }}, 150);
              });
              ambMq_{{ block.id | replace: '-', '_' }}.addEventListener('change', initAmbSwiper_{{ block.id | replace: '-', '_' }});

              if (typeof Shopify !== 'undefined' && Shopify.designMode) {
                document.addEventListener('shopify:section:unload', function(e) {
                  if (e.detail && e.detail.sectionId === '{{ section.id }}' && ambSwiper_{{ block.id | replace: '-', '_' }}) {
                    ambSwiper_{{ block.id | replace: '-', '_' }}.destroy(true, true);
                    ambSwiper_{{ block.id | replace: '-', '_' }} = null;
                  }
                });
                document.addEventListener('shopify:section:load', function() {
                  setTimeout(initAmbSwiper_{{ block.id | replace: '-', '_' }}, 100);
                  setTimeout(matchAmbHeights_{{ block.id | replace: '-', '_' }}, 200);
                });
                document.addEventListener('shopify:block:select', function(e) {
                  if (e.detail && e.detail.blockId === '{{ block.id }}') {
                    setTimeout(initAmbSwiper_{{ block.id | replace: '-', '_' }}, 100);
                    setTimeout(matchAmbHeights_{{ block.id | replace: '-', '_' }}, 200);
                  }
                });
              }
            </script>

            {% if block.settings.show_rating %}
              {% if block.settings.stars > 0
                or block.settings.rating_text != blank
                or block.settings.reviews_text != blank
              %}
                <div class="lst-amb-rating-{{ block.id }}">
                  {% if block.settings.stars > 0 %}
                    <div class="lst-amb-stars-{{ block.id }}">
                      {% if section.settings.stars_icon != blank %}
                        {% for _si in (1..block.settings.stars) -%}
                          {{-
                            section.settings.stars_icon
                            | image_url: width: 100
                            | image_tag: widths: '50, 100', loading: 'lazy'
                          -}}
                        {%- endfor %}
                      {% else %}
                        {%- assign _asc = section.settings.stars_color -%}
                        {%- assign _asbc = section.settings.stars_bg_color -%}
                        {%- assign _ashc = section.settings.stars_bg_half_color -%}
                        {%- assign _abid = block.id -%}
                        {%- assign _ar = block.settings.stars -%}
                        {% for _si in (1..5) %}
                          {%- assign _ahalf = _si | minus: 0.5 -%}
                          {%- assign _adefs = '' -%}
                          {%- if _ar == _ahalf -%}
                            {%- assign _afill = 'url(#tg_' | append: _abid | append: '_' | append: _si | append: ')' -%}
                            {%- assign _adefs = '<defs><linearGradient id="tg_'
                              | append: _abid
                              | append: '_'
                              | append: _si
                              | append: '"><stop offset="50%" stop-color="'
                              | append: _asbc
                              | append: '" /><stop offset="50%" stop-color="'
                              | append: _ashc
                              | append: '" /></linearGradient></defs>'
                            -%}
                          {%- elsif _ar >= _si -%}
                            {%- assign _afill = _asbc -%}
                          {%- else -%}
                            {%- assign _afill = _ashc -%}
                          {%- endif -%}
                          {{
                            star_svg_base
                            | replace: '__DEFS__', _adefs
                            | replace: '__FILL__', _afill
                            | replace: '__SC__', _asc
                            | replace: '__BID__', _abid
                            | replace: '__IDX__', _si
                          }}
                        {% endfor %}
                      {% endif %}
                    </div>
                  {% endif %}
                  {% if block.settings.rating_text != blank %}
                    <span class="lst-amb-rating-text-{{ block.id }}">{{ block.settings.rating_text }}</span>
                  {% endif %}
                  {% if block.settings.reviews_text != blank %}
                    <span class="lst-amb-reviews-text-{{ block.id }}">{{ block.settings.reviews_text }}</span>
                  {% endif %}
                </div>
              {% endif %}
            {% endif %}
          </div>
        </div>

      {% when 'testimonials' %}
        {%- comment -%}Count child cards for show-more logic{%- endcomment -%}
        {%- assign _rev_total = 0 -%}
        {%- assign _rev_cf = false -%}
        {% for _b in section.blocks %}
          {% if _b.id == block.id %}
            {%- assign _rev_cf = true -%}
          {% elsif _rev_cf and _b.type == 'testimonial_card' %}
            {%- assign _rev_total = _rev_total | plus: 1 -%}
          {% elsif _rev_cf -%}
            {%- break -%}
          {%- endif %}
        {% endfor %}

        <div class="lst-rev-{{ block.id }} l4-block l4-block--clip" {{ block.shopify_attributes }}>
          <div class="lst-rev-inner-{{ block.id }} l4-inner">
            {% if block.settings.badge != blank
              or block.settings.heading != blank
              or block.settings.accent_text != blank
            %}
              <div class="lst-rev-header-{{ block.id }} l4-header">
                {% if block.settings.badge != blank %}
                  <span class="lst-rev-badge-{{ block.id }} l4-badge">{{ block.settings.badge }}</span>
                {% endif %}
                {% if block.settings.heading != blank %}
                  <div class="lst-rev-heading-{{ block.id }} l4-heading">{{ block.settings.heading }}</div>
                {% endif %}
                {% if block.settings.accent_text != blank %}
                  <p class="lst-rev-accent-{{ block.id }} l4-accent{% if block.settings.accent_gradient != blank %} l4-accent--gradient{% endif %}">
                    {{ block.settings.accent_text }}
                  </p>
                {% endif %}
              </div>
            {% endif %}

            <div class="lst-rev-ratingbar-{{ block.id }}">
              {%- assign _r = block.settings.rating -%}
              {%- assign _sc = section.settings.stars_color -%}
              {%- assign _sbc = section.settings.stars_bg_color -%}
              {%- assign _shc = section.settings.stars_bg_half_color -%}
              <div class="lst-rev-ratingbar-stars-{{ block.id }}">
                {% if section.settings.stars_icon != blank %}
                  {% if _r > 0 -%}
                    {%- for _si in (1.._r) -%}
                      {{-
                        section.settings.stars_icon
                        | image_url: width: 100
                        | image_tag: widths: '50, 100', loading: 'lazy'
                      -}}
                    {%- endfor -%}
                  {%- endif %}
                {% else %}
                  {%- assign _rbid = block.id -%}
                  {% for _si in (1..5) %}
                    {%- assign _rhalf = _si | minus: 0.5 -%}
                    {%- assign _rdefs = '' -%}
                    {%- if _r == _rhalf -%}
                      {%- assign _rfill = 'url(#tg_' | append: _rbid | append: '_' | append: _si | append: ')' -%}
                      {%- assign _rdefs = '<defs><linearGradient id="tg_'
                        | append: _rbid
                        | append: '_'
                        | append: _si
                        | append: '"><stop offset="50%" stop-color="'
                        | append: _sbc
                        | append: '" /><stop offset="50%" stop-color="'
                        | append: _shc
                        | append: '" /></linearGradient></defs>'
                      -%}
                    {%- elsif _r >= _si -%}
                      {%- assign _rfill = _sbc -%}
                    {%- else -%}
                      {%- assign _rfill = _shc -%}
                    {%- endif -%}
                    {{
                      star_svg_base
                      | replace: '__DEFS__', _rdefs
                      | replace: '__FILL__', _rfill
                      | replace: '__BID__', _rbid
                      | replace: '__IDX__', _si
                      | replace: '__SC__', _sc
                    }}
                  {% endfor %}
                {% endif %}
              </div>
              {% if block.settings.rating_text != blank %}
                <span class="lst-rev-ratingbar-text-{{ block.id }}">{{ block.settings.rating_text }}</span>
              {% endif %}
              {% if block.settings.platform_logo != blank %}
                {%- assign _rev_logo_class = 'lst-rev-platform-logo-' | append: block.id -%}
                {%- if block.settings.rating_link != blank -%}
                  <a href="{{ block.settings.rating_link }}" target="_blank" rel="noopener nofollow">
                {%- endif -%}
                {{
                  block.settings.platform_logo
                  | image_url: height: 48
                  | image_tag: class: _rev_logo_class, loading: 'lazy', alt: block.settings.platform_logo.alt
                }}
                {%- if block.settings.rating_link != blank -%}</a>{%- endif -%}
              {% endif %}
              {% if block.settings.score_text != blank %}
                <span class="lst-rev-score-{{ block.id }}">{{ block.settings.score_text }}</span>
              {% endif %}
            </div>

            {%- capture _rev_cards -%}
              {%- assign _rev_found = false -%}
              {%- assign _rev_idx = 0 -%}
              {% for _b in section.blocks %}
                {% if _b.id == block.id %}
                  {%- assign _rev_found = true -%}
                {% elsif _rev_found and _b.type == 'testimonial_card' %}
                  {%- assign _rev_idx = _rev_idx | plus: 1 -%}
                  __L4REV_SLIDE_OPEN__
                  <div class="lst-rev-card-{{ block.id }}{% if _rev_idx > block.settings.initial_count %} l4rev-extra{% endif %}">
                    {%- assign _csc = section.settings.stars_color -%}
                    {%- assign _csbc = section.settings.stars_bg_color -%}
                    {%- assign _cshc = section.settings.stars_bg_half_color -%}
                    {%- assign _cr = _b.settings.stars -%}
                    <div class="lst-rev-card-stars-{{ block.id }}">
                      {% if section.settings.stars_icon != blank %}
                        {% if _cr > 0 -%}
                          {%- for _si in (1.._cr) -%}
                            {{-
                              section.settings.stars_icon
                              | image_url: width: 80
                              | image_tag: widths: '40, 80', loading: 'lazy'
                            -}}
                          {%- endfor -%}
                        {%- endif %}
                      {% else %}
                        {%- assign _ccbid = _b.id -%}
                        {% for _csi in (1..5) %}
                          {%- assign _cchalf = _csi | minus: 0.5 -%}
                          {%- assign _ccdefs = '' -%}
                          {%- if _cr == _cchalf -%}
                            {%- assign _ccfill = 'url(#tg_'
                              | append: _ccbid
                              | append: '_'
                              | append: _csi
                              | append: ')'
                            -%}
                            {%- assign _ccdefs = '<defs><linearGradient id="tg_'
                              | append: _ccbid
                              | append: '_'
                              | append: _csi
                              | append: '"><stop offset="50%" stop-color="'
                              | append: _csbc
                              | append: '" /><stop offset="50%" stop-color="'
                              | append: _cshc
                              | append: '" /></linearGradient></defs>'
                            -%}
                          {%- elsif _cr >= _csi -%}
                            {%- assign _ccfill = _csbc -%}
                          {%- else -%}
                            {%- assign _ccfill = _cshc -%}
                          {%- endif -%}
                          {{
                            star_svg_base
                            | replace: '__DEFS__', _ccdefs
                            | replace: '__FILL__', _ccfill
                            | replace: '__BID__', _ccbid
                            | replace: '__IDX__', _csi
                            | replace: '__SC__', _csc
                          }}
                        {% endfor %}
                      {% endif %}
                    </div>
                    {% if _b.settings.reviewer_name != blank or _b.settings.time_ago != blank %}
                      <div class="lst-rev-card-meta-{{ block.id }}">
                        {% if _b.settings.reviewer_name != blank -%}
                          <span class="lst-rev-name-{{ block.id }}">{{ _b.settings.reviewer_name }}</span>
                        {%- endif %}
                        {% if _b.settings.time_ago != blank -%}
                          <span class="lst-rev-time-{{ block.id }}">{{ _b.settings.time_ago }}</span>
                        {%- endif %}
                      </div>
                    {% endif %}
                    {% if _b.settings.title != blank %}
                      <p class="lst-rev-title-{{ block.id }}">{{ _b.settings.title }}</p>
                    {% endif %}
                    {% if _b.settings.body != blank %}
                      <div class="lst-rev-body-wrap-{{ block.id }}">
                        <p class="lst-rev-body-{{ block.id }}">{{ _b.settings.body }}</p>
                        <button type="button" class="lst-rev-read-more-{{ block.id }}" data-rev-readmore>
                          Read more
                        </button>
                        <button type="button" class="lst-rev-read-less-{{ block.id }}" data-rev-readless>
                          Read less
                        </button>
                      </div>
                    {% endif %}
                    {% if _b.settings.show_reply and _b.settings.reply_author != blank %}
                      <div class="lst-rev-reply-{{ block.id }}">
                        <div class="lst-rev-reply-meta-{{ block.id }}">
                          <span class="lst-rev-reply-author-{{ block.id }}">{{ _b.settings.reply_author }}</span>
                          {% if _b.settings.reply_time != blank -%}
                            <span class="lst-rev-reply-time-{{ block.id }}">{{ _b.settings.reply_time }}</span>
                          {%- endif %}
                        </div>
                        {% if _b.settings.reply_body != blank %}
                          <p class="lst-rev-reply-body-{{ block.id }}">{{ _b.settings.reply_body }}</p>
                        {% endif %}
                      </div>
                    {% endif %}
                  </div>
                  __L4REV_SLIDE_CLOSE__
                {% elsif _rev_found %}
                  {% break %}
                {% endif %}
              {% endfor %}
            {%- endcapture -%}

            {%- comment -%}Desktop grid{%- endcomment -%}
            <div class="lst-rev-grid-{{ block.id }}">
              {{ _rev_cards | replace: '__L4REV_SLIDE_OPEN__', '' | replace: '__L4REV_SLIDE_CLOSE__', '' }}
            </div>

            <div class="lst-rev-swiper-wrap-{{ block.id }}">
              <div class="swiper lst-rev-swiper-{{ block.id }}">
                <div class="swiper-wrapper">
                  {{
                    _rev_cards
                    | replace: '__L4REV_SLIDE_OPEN__', '<div class="swiper-slide">'
                    | replace: '__L4REV_SLIDE_CLOSE__', '</div>'
                    | replace: ' l4rev-extra', ''
                  }}
                </div>
                <div class="swiper-button-prev lst-rev-swiper-prev-{{ block.id }}"></div>
                <div class="swiper-button-next lst-rev-swiper-next-{{ block.id }}"></div>
                <div class="swiper-pagination lst-rev-swiper-pagination-{{ block.id }}"></div>
              </div>
              {% if block.settings.mobile_cta_text != blank and block.settings.mobile_cta_url != blank %}
                <div class="lst-rev-mobile-cta-{{ block.id }}">
                  <a href="{{ block.settings.mobile_cta_url }}" class="lst-rev-mobile-cta-link-{{ block.id }}">
                    {{- block.settings.mobile_cta_text -}}
                  </a>
                </div>
              {% endif %}
            </div>

            {% if _rev_total > block.settings.initial_count %}
              <div class="lst-rev-showmore-{{ block.id }}">
                <button type="button" class="lst-rev-showmore-btn-{{ block.id }}" data-rev-showmore>
                  {{ block.settings.show_more_text | default: 'Show more reviews' }}
                </button>
              </div>
            {% endif %}
          </div>
        </div>

        <script>
          (function () {
            var revEl = document.querySelector('.lst-rev-{{ block.id }}');
            if (!revEl) return;

            function checkTruncation() {
              revEl.querySelectorAll('.lst-rev-body-wrap-{{ block.id }}').forEach(function (wrap) {
                var body = wrap.querySelector('.lst-rev-body-{{ block.id }}');
                var moreBtn = wrap.querySelector('[data-rev-readmore]');
                var lessBtn = wrap.querySelector('[data-rev-readless]');
                if (!moreBtn || !body) return;

                moreBtn.style.display = '';
                if (lessBtn) lessBtn.style.display = '';

                if (body.clientHeight > 0 && body.scrollHeight <= body.clientHeight + 2) {
                  moreBtn.style.display = 'none';
                  if (lessBtn) lessBtn.style.display = 'none';
                }
              });
            }

            revEl.querySelectorAll('.lst-rev-body-wrap-{{ block.id }}').forEach(function (wrap) {
              var moreBtn = wrap.querySelector('[data-rev-readmore]');
              var lessBtn = wrap.querySelector('[data-rev-readless]');
              if (moreBtn) {
                moreBtn.addEventListener('click', function () {
                  wrap.classList.add('l4rev-expanded');
                });
              }
              if (lessBtn) {
                lessBtn.addEventListener('click', function () {
                  wrap.classList.remove('l4rev-expanded');
                });
              }
            });

            setTimeout(checkTruncation, 100);

            var showMoreBtn = revEl.querySelector('[data-rev-showmore]');
            if (showMoreBtn) {
              showMoreBtn.addEventListener('click', function () {
                revEl.querySelectorAll('.lst-rev-card-{{ block.id }}.l4rev-extra').forEach(function (c) {
                  c.classList.remove('l4rev-extra');
                });
                showMoreBtn.parentElement.style.display = 'none';
                setTimeout(checkTruncation, 50);
              });
            }
            function initRevSwiper() {
              if (typeof Swiper === 'undefined') return;
              var swiperEl = revEl.querySelector('.lst-rev-swiper-{{ block.id }}');
              if (!swiperEl || swiperEl.swiper) return;
              new Swiper(swiperEl, {
                slidesPerView: 1.15,
                spaceBetween: 16,
                loop: false,
                navigation: {
                  prevEl: revEl.querySelector('.lst-rev-swiper-prev-{{ block.id }}'),
                  nextEl: revEl.querySelector('.lst-rev-swiper-next-{{ block.id }}'),
                },
                pagination: {
                  el: revEl.querySelector('.lst-rev-swiper-pagination-{{ block.id }}'),
                  clickable: true,
                },
              });
            }
            if (!window._lst4SwiperLoaded) {
              window._lst4SwiperLoaded = true;
              var link = document.createElement('link');
              link.rel = 'stylesheet';
              link.href = 'https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css';
              document.head.appendChild(link);
              var sc = document.createElement('script');
              sc.src = 'https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js';
              sc.onload = function () {
                document.dispatchEvent(new CustomEvent('lst4SwiperReady'));
              };
              document.head.appendChild(sc);
            }
            document.addEventListener('lst4SwiperReady', initRevSwiper);
            if (typeof Swiper !== 'undefined') initRevSwiper();
            if (typeof Shopify !== 'undefined' && Shopify.designMode) {
              document.addEventListener('shopify:section:load', function () {
                revEl = document.querySelector('.lst-rev-{{ block.id }}');
                initRevSwiper();
              });
            }
          })();
        </script>

      {% when 'tabs' %}
        <div class="lst-tabs-{{ block.id }} l4-block" {{ block.shopify_attributes }}>
          <div class="lst-tabs-inner-{{ block.id }} l4-inner l4-inner--narrow">
            {% if block.settings.badge != blank
              or block.settings.heading != blank
              or block.settings.heading_accent != blank
              or block.settings.text != blank
            %}
              <div class="lst-tabs-header-{{ block.id }} l4-header">
                {% if block.settings.badge != blank %}
                  <div>
                    <span class="lst-tabs-badge-{{ block.id }} l4-badge">{{ block.settings.badge }}</span>
                  </div>
                {% endif %}
                {% if block.settings.heading != blank or block.settings.heading_accent != blank %}
                  <div class="lst-tabs-heading-{{ block.id }} l4-heading">
                    {% if block.settings.heading != blank %}
                      <span class="lst-tabs-heading-main-{{ block.id }}">{{ block.settings.heading }}</span>
                    {% endif %}
                    {% if block.settings.heading_accent != blank %}
                      <em class="lst-tabs-heading-accent-{{ block.id }} l4-accent{% if block.settings.heading_accent_gradient != blank %} l4-accent--gradient{% endif %}">
                        {{- block.settings.heading_accent -}}
                      </em>
                    {% endif %}
                  </div>
                {% endif %}
                {% if block.settings.text != blank %}
                  <div class="lst-tabs-text-{{ block.id }} l4-text">{{ block.settings.text }}</div>
                {% endif %}
              </div>
            {% endif %}

            <div class="lst-tabs-nav-{{ block.id }}">
              {%- assign _tf = false -%}
              {% for _b in section.blocks %}
                {% if _b.id == block.id %}
                  {%- assign _tf = true -%}
                {% elsif _tf and _b.type == 'tab_item' %}
                  <button class="lst-tabs-btn-{{ block.id }}" data-tab-btn>
                    {% if _b.settings.icon != blank -%}
                      <span aria-hidden="true">{{ _b.settings.icon }}</span>
                    {%- endif %}
                    {{ _b.settings.label }}
                  </button>
                {% elsif _tf -%}
                  {%- break -%}
                {%- endif %}
              {% endfor %}
            </div>

            <div class="lst-tabs-panels-{{ block.id }}">
              {%- assign _tf2 = false -%}
              {% for _b in section.blocks %}
                {% if _b.id == block.id %}
                  {%- assign _tf2 = true -%}
                {% elsif _tf2 and _b.type == 'tab_item' %}
                  <div class="lst-tabs-panel-{{ block.id }}">
                    <div class="lst-tabs-panel-inner-{{ block.id }}">
                      {% if _b.settings.icon != blank or _b.settings.content_title != blank %}
                        <div class="lst-tabs-panel-row-{{ block.id }}">
                          {% if _b.settings.icon != blank %}
                            <span class="lst-tabs-panel-icon-{{ block.id }}" aria-hidden="true">
                              {{- _b.settings.icon -}}
                            </span>
                          {% endif %}
                          {% if _b.settings.content_title != blank %}
                            <span class="lst-tabs-panel-title-{{ block.id }}">
                              {{- _b.settings.content_title -}}
                            </span>
                          {% endif %}
                        </div>
                      {% endif %}
                      {% if _b.settings.content_text != blank %}
                        <div class="lst-tabs-panel-text-{{ block.id }}">{{ _b.settings.content_text }}</div>
                      {% endif %}
                    </div>
                  </div>
                {% elsif _tf2 -%}
                  {%- break -%}
                {%- endif %}
              {% endfor %}
            </div>

            {% if block.settings.bottom_text != blank %}
              <div class="lst-tabs-bottom-{{ block.id }}">{{ block.settings.bottom_text }}</div>
            {% endif %}
          </div>

          <script>
            (function () {
              var wrap = document.querySelector('.lst-tabs-{{ block.id }}');
              if (!wrap) return;
              var btns = Array.from(wrap.querySelectorAll('[data-tab-btn]'));
              var panels = Array.from(wrap.querySelectorAll('.lst-tabs-panel-{{ block.id }}'));
              function activate(idx) {
                btns.forEach(function (b, i) {
                  b.classList.toggle('l4tabs-active', i === idx);
                });
                panels.forEach(function (p, i) {
                  p.classList.toggle('l4tabs-panel-active', i === idx);
                });
              }
              btns.forEach(function (btn, i) {
                btn.addEventListener('click', function () {
                  activate(i);
                });
              });
              activate(0);
            })();
          </script>
        </div>

