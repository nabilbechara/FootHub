{%- style -%}
  {% if section.settings.heading_custom_font %}
    {{ section.settings.heading_font | font_face: font_display: 'swap' }}
    {%- assign heading_font_italic = section.settings.heading_font | font_modify: 'style', 'italic' -%}
    {%- if heading_font_italic -%}
      {{ heading_font_italic | font_face: font_display: 'swap' }}
    {%- endif -%}
  {% endif %}
  {% if section.settings.accent_custom_font %}
    {{ section.settings.accent_font | font_face: font_display: 'swap' }}
  {% endif %}
  {% if section.settings.text_custom_font %}
    {{ section.settings.text_font | font_face: font_display: 'swap' }}
    {%- assign text_font_bold = section.settings.text_font | font_modify: 'weight', 'bolder' -%}
    {%- if text_font_bold -%}
      {{ text_font_bold | font_face: font_display: 'swap' }}
    {%- endif -%}
    {%- assign text_font_italic = section.settings.text_font | font_modify: 'style', 'italic' -%}
    {%- if text_font_italic -%}
      {{ text_font_italic | font_face: font_display: 'swap' }}
    {%- endif -%}
    {%- assign text_font_bold_italic = text_font_bold | font_modify: 'style', 'italic' -%}
    {%- if text_font_bold_italic -%}
      {{ text_font_bold_italic | font_face: font_display: 'swap' }}
    {%- endif -%}
  {% endif %}
  {% if section.settings.button_custom_font %}
    {{ section.settings.button_font | font_face: font_display: 'swap' }}
  {% endif %}
  {% if section.settings.badge_custom_font %}
    {{ section.settings.badge_font | font_face: font_display: 'swap' }}
  {% endif %}

  .lst-section-{{ section.id }} {
    display: flex;
    flex-direction: column;
    gap: {{ section.settings.block_gap_mobile }}px;
    margin-top: {{ section.settings.margin_top | times: 0.75 | round: 0 }}px;
    margin-bottom: {{ section.settings.margin_bottom | times: 0.75 | round: 0 }}px;
    margin-left: {{ section.settings.margin_horizontal_mobile }}rem;
    margin-right: {{ section.settings.margin_horizontal_mobile }}rem;
    {% if section.settings.section_bg_style == 'gradient' %}
      --l4sec-bg-image: {{ section.settings.section_background_gradient }};
    {% elsif section.settings.section_bg_style == 'solid' %}
      --l4sec-bg-color: {{ section.settings.section_background_color }};
    {% endif %}
    --l4badge-fs: {{ section.settings.badge_font_size_mobile | default: 11 }}px;
    --l4badge-pad: {{ section.settings.badge_padding_v | default: 5 }}px {{ section.settings.badge_padding_h | default: 14 }}px;
    --l4heading-weight: 700;
    {% if section.settings.heading_custom_font %}
      --l4heading-font: {{ section.settings.heading_font.family }}, {{ section.settings.heading_font.fallback_families }};
      --l4heading-weight: {{ section.settings.heading_font.weight }};
      --l4heading-style: {{ section.settings.heading_font.style }};
    {% endif %}
    {% if section.settings.accent_custom_font %}
      --l4accent-font: {{ section.settings.accent_font.family }}, {{ section.settings.accent_font.fallback_families }};
      --l4accent-weight: {{ section.settings.accent_font.weight }};
      --l4accent-style: {{ section.settings.accent_font.style }};
    {% endif %}
    {% if section.settings.text_custom_font %}
      --l4text-font: {{ section.settings.text_font.family }}, {{ section.settings.text_font.fallback_families }};
      --l4text-weight: {{ section.settings.text_font.weight }};
      --l4text-style: {{ section.settings.text_font.style }};
    {% endif %}
    {% if section.settings.button_custom_font %}
      --l4btn-font: {{ section.settings.button_font.family }}, {{ section.settings.button_font.fallback_families }};
      --l4btn-weight: {{ section.settings.button_font.weight }};
      --l4btn-style: {{ section.settings.button_font.style }};
    {% endif %}
    {% if section.settings.badge_custom_font %}
      --l4badge-font: {{ section.settings.badge_font.family }}, {{ section.settings.badge_font.fallback_families }};
      --l4badge-weight: {{ section.settings.badge_font.weight }};
      --l4badge-style: {{ section.settings.badge_font.style }};
    {% endif %}
  }

  .lst-section-{{ section.id }} p:not([class]) {
    font-family: inherit;
    font-size: inherit;
    line-height: inherit;
    color: inherit;
    font-weight: inherit;
    font-style: inherit;
  }
  .lst-section-{{ section.id }} p:not([class]):first-child {
    margin-top: 0;
  }
  .lst-section-{{ section.id }} p:not([class]):last-child {
    margin-bottom: 0;
  }

  .lst-section-{{ section.id }} .l4-block {
    background-image: var(--l4-block-bg-image, var(--l4sec-bg-image, none));
    background-color: var(--l4-block-bg-color, var(--l4sec-bg-color, transparent));
    padding: var(
      --l4-block-padding-mobile,
      {{ section.settings.padding_top | times: 0.75 | round: 0 }}px {{ section.settings.padding_horizontal_mobile }}rem {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px
    );
    border-radius: var(--l4-block-radius-mobile, {{ section.settings.section_radius | times: 0.6 | round: 0 }}px);
  }
  .lst-section-{{ section.id }} .l4-block--relative {
    position: relative;
  }
  .lst-section-{{ section.id }} .l4-block--clip {
    overflow: hidden;
  }
  .lst-section-{{ section.id }} .l4-block--no-pad {
    --l4-block-padding-mobile: 0;
    --l4-block-padding-desktop: 0;
  }
  .lst-section-{{ section.id }} .l4-inner {
    max-width: var(
      --l4-inner-max,
      {% if section.settings.width == 'full' %}
        none
      {% elsif section.settings.width == 'custom' %}
        {{ section.settings.content_width }}px
      {% else %}
        clamp(100px, var(--page-content-width, var(--page-width)), 100%)
      {% endif %}
    );
    margin: 0 auto;
  }
  .lst-section-{{ section.id }} .l4-inner--narrow {
    --l4-inner-max: 800px;
  }
  .lst-section-{{ section.id }} .l4-inner--cap {
    --l4-inner-max:
      {% if section.settings.width == 'full' %}
        1200px
      {% elsif section.settings.width == 'custom' %}
        {% if section.settings.content_width > 1200 %}1200{% else %}{{ section.settings.content_width }}{% endif %}px
      {% else %}
        min(clamp(100px, var(--page-content-width, var(--page-width)), 100%), 1200px)
      {% endif %};
  }
  .lst-section-{{ section.id }} .l4-header {
    text-align: center;
    margin-bottom: var(--l4-header-mb-mobile, 32px);
  }
  .lst-section-{{ section.id }} .l4-badge {
    display: inline-block;
    font-size: var(--l4badge-fs, 11px);
    letter-spacing: var(--l4-badge-ls, 0.12em);
    font-family: var(--l4badge-font, inherit);
    font-weight: var(--l4badge-weight, inherit);
    font-style: var(--l4badge-style, normal);
    color: var(--l4-badge-color, inherit);
    background: var(--l4-badge-bg, transparent);
    line-height: var(--l4-badge-line-height, normal);
    border-radius: {{ section.settings.badge_radius }}px;
    border: {{ section.settings.badge_border_thickness }}px solid var(--l4-badge-border-color, #e0e0e0);
    text-transform: {{ section.settings.badge_text_transform }};
    padding: var(--l4badge-pad);
    margin-bottom: var(--l4-badge-mb, 16px);
  }
  .lst-section-{{ section.id }} .l4-heading {
    margin: var(--l4-heading-margin-mobile, 0 0 10px);
    font-size: var(--l4-heading-size-mobile, {{ heading_size_mobile }}px);
    line-height: {{ section.settings.heading_line_height }}%;
    color: var(--l4-heading-color, inherit);
    font-family: var(--l4heading-font, inherit);
    font-weight: var(--l4heading-weight, inherit);
    font-style: var(--l4heading-style, inherit);
    max-width: var(--l4-heading-max-width, none);
  }
  .lst-section-{{ section.id }} .l4-heading * {
    margin: 0;
    font-size: inherit;
    line-height: inherit;
    color: inherit;
    font-family: inherit;
    font-weight: inherit;
    font-style: inherit;
  }
  .lst-section-{{ section.id }} .l4-accent {
    margin: var(--l4-accent-margin-mobile, 0);
    font-size: var(--l4-accent-size-mobile, {{ heading_size_mobile }}px);
    line-height: {{ section.settings.heading_line_height }}%;
    color: var(--l4-accent-color, inherit);
    font-family: var(--l4accent-font, var(--l4heading-font, inherit));
    font-weight: var(--l4accent-weight, var(--l4heading-weight, inherit));
    font-style: var(--l4accent-style, italic);
    max-width: var(--l4-accent-max-width, none);
  }
  .lst-section-{{ section.id }} .l4-accent--gradient {
    background: var(--l4-accent-gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    color: transparent;
  }
  .lst-section-{{ section.id }} .l4-text {
    margin: var(--l4-text-margin-mobile, 0);
    font-size: var(--l4-text-size-mobile, {{ text_size_mobile }}px);
    line-height: {{ section.settings.text_line_height }}%;
    color: var(--l4-text-color, inherit);
    font-family: var(--l4text-font, inherit);
    font-weight: var(--l4text-weight, inherit);
    font-style: var(--l4text-style, inherit);
    max-width: var(--l4-text-max-width, none);
  }
  .lst-section-{{ section.id }} .l4-text * {
    margin: 0;
    font-size: inherit;
    line-height: inherit;
    font-family: inherit;
  }

  @media(min-width: 1024px) {
    .lst-section-{{ section.id }} {
      gap: {{ section.settings.block_gap }}px;
      --l4badge-fs: {{ section.settings.badge_font_size | default: 11 }}px;
      margin-top: {{ section.settings.margin_top }}px;
      margin-bottom: {{ section.settings.margin_bottom }}px;
      margin-left: {{ section.settings.margin_horizontal }}rem;
      margin-right: {{ section.settings.margin_horizontal }}rem;
    }
    .lst-section-{{ section.id }} .l4-block {
      padding: var(
        --l4-block-padding-desktop,
        {{ section.settings.padding_top }}px {{ section.settings.padding_horizontal }}rem {{ section.settings.padding_bottom }}px
      );
      border-radius: var(--l4-block-radius-desktop, {{ section.settings.section_radius }}px);
    }
    .lst-section-{{ section.id }} .l4-header {
      margin-bottom: var(--l4-header-mb-desktop, var(--l4-header-mb-mobile, 32px));
    }
    .lst-section-{{ section.id }} .l4-heading {
      margin: var(--l4-heading-margin-desktop, var(--l4-heading-margin-mobile, 0 0 10px));
      font-size: var(--l4-heading-size-desktop, {{ heading_size }}px);
    }
    .lst-section-{{ section.id }} .l4-accent {
      margin: var(--l4-accent-margin-desktop, var(--l4-accent-margin-mobile, 0));
      font-size: var(--l4-accent-size-desktop, {{ heading_size }}px);
    }
    .lst-section-{{ section.id }} .l4-text {
      margin: var(--l4-text-margin-desktop, var(--l4-text-margin-mobile, 0));
      font-size: var(--l4-text-size-desktop, {{ text_size }}px);
    }
  }

  {% if section.settings.enable_animation %}
    @keyframes lst4FadeUp {
      from { opacity: 0; transform: translateY(24px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .lst-section-{{ section.id }} > * {
      opacity: 0;
    }
    .lst-section-{{ section.id }} > *.l4animated {
      animation: lst4FadeUp 0.5s ease forwards;
    }
  {% endif %}
  {% if section.settings.enable_hover_effect %}
  .lst-section-{{ section.id }} .l4-hover-btn {
      position: relative;
      backdrop-filter: saturate(1.05);
      transition: all 0.25s ease 0s;
      box-shadow: 0 8px 16px {{ btn_shadow_color }}4d, 0 4px 8px {{ btn_shadow_color }}33, inset 0 1px 0 #ffffff1a, inset 0 -1px 0 {{ btn_shadow_color }}4d;
  }
  .lst-section-{{ section.id }} .l4-hover-btn::before {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: inherit;
      background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.1), transparent);
      background-size: 200% 100%;
      background-position: 200% 0;
      transition: background-position 0.6s ease;
      pointer-events: none;
  }
  .lst-section-{{ section.id }} .l4-hover-btn:hover::before {
      background-position: -100% 0;
  }
  .lst-section-{{ section.id }} .l4-hover-btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 12px 24px {{ btn_shadow_color }}66, 0 6px 12px {{ btn_shadow_color }}4d, inset 0 1px 0 #ffffff26, inset 0 -1px 0 {{ btn_shadow_color }}66;
  }
  .lst-section-{{ section.id }} .l4-hover-btn:active {
      transform: translateY(1px);
      filter: brightness(1.00208);
      box-shadow: 0 4px 8px {{ btn_shadow_color }}4d, 0 2px 4px {{ btn_shadow_color }}33, inset 0 1px 0 #ffffff0d, inset 0 -1px 0 {{ btn_shadow_color }}33;
  }
  .lst-section-{{ section.id }} .l4-hover-btn.l4-btn-non_outline {
      background: linear-gradient(145deg, {{ section.settings.btn_filled_bg_color }}, {{ section.settings.btn_filled_bg_color | color_darken: 7.5 }}) !important;
  }
  .lst-section-{{ section.id }} .l4-hover-btn.l4-btn-non_outline:hover {
      background: linear-gradient(145deg, {{ section.settings.btn_filled_bg_hover_color }}, {{ section.settings.btn_filled_bg_hover_color | color_darken: 7.5 }}) !important;
  }
  .lst-section-{{ section.id }} .l4-hover-btn.l4-btn-outline {
      background: linear-gradient(145deg, {{ section.settings.btn_outline_bg_color }}, {{ section.settings.btn_outline_bg_color | color_darken: 7.5 }}) !important;
  }
  .lst-section-{{ section.id }} .l4-hover-btn.l4-btn-outline:hover {
      background: linear-gradient(145deg, {{ section.settings.btn_outline_bg_hover_color }}, {{ section.settings.btn_outline_bg_hover_color | color_darken: 7.5 }}) !important;
  }
  .lst-atc-error {
      display: flex;
      align-items: flex-start;
      font-size: 13px;
      line-height: 1.4;
      color: #EB001B;
      margin-bottom: 12px;
  }
  .lst-atc-error.hidden {
      display: none;
  }
  .lst-atc-error__svg-wrapper {
      display: inline-flex;
      justify-content: center;
      align-items: center;
      flex-shrink: 0;
      width: 14px;
      height: 14px;
      margin-right: 6px;
      margin-top: 2px;
  }
  .lst-atc-error__icon {
      width: 100%;
      height: 100%;
  }
  {% endif %}
{%- endstyle -%}

{% for block in section.blocks %}
  {%- style -%}
    {% case block.type %}
      {% when 'ambassadors' %}
        .lst-amb-{{ block.id }} {
          {% if block.settings.bg_style == 'gradient' %}
            --l4-block-bg-image: {{ block.settings.background_gradient }};
            --l4-block-bg-color: transparent;
          {% elsif block.settings.bg_style == 'solid' and block.settings.background_color.alpha > 0 %}
            --l4-block-bg-image: none;
            --l4-block-bg-color: {{ block.settings.background_color }};
          {% endif %}
          --l4-header-mb-mobile: 36px;
          --l4-header-mb-desktop: 48px;
          --l4-badge-color: {{ block.settings.badge_text_color }};
          --l4-badge-bg: {{ block.settings.badge_bg_color }};
          --l4-badge-border-color: {{ block.settings.badge_border_color | default: '#e0e0e0' }};
          --l4-heading-color: {{ block.settings.heading_color }};
          --l4-accent-color: {{ block.settings.accent_color }};
          {% if block.settings.accent_gradient != blank %}
            --l4-accent-gradient: {{ block.settings.accent_gradient }};
          {% endif %}
        }
        .lst-amb-grid-{{ block.id }} {
          display: none;
        }
        .lst-amb-swiper-wrap-{{ block.id }} {
          display: block;
          overflow: hidden;
          margin-left: -{{ section.settings.padding_horizontal_mobile }}rem;
          margin-right: -{{ section.settings.padding_horizontal_mobile }}rem;
          padding-left: {{ section.settings.padding_horizontal_mobile }}rem;
          padding-right: {{ section.settings.padding_horizontal_mobile }}rem;
        }
        .lst-amb-swiper-{{ block.id }} {
          padding-bottom: 40px !important;
          overflow: visible !important;
        }
        .lst-amb-swiper-{{ block.id }} .swiper-pagination-bullet {
          background: {{ block.settings.heading_color }};
          opacity: 0.4;
        }
        .lst-amb-swiper-{{ block.id }} .swiper-pagination-bullet-active {
          opacity: 1;
        }
        .lst-amb-card-wrap-{{ block.id }} {
          display: flex;
          flex-direction: column;
          gap: 12px;
        }
        .lst-amb-card-{{ block.id }} {
          position: relative;
          overflow: hidden;
          border-radius: {{ block.settings.card_radius | times: 0.6 | round: 0 }}px;
          border: {{ block.settings.card_border_thickness }}px solid {{ block.settings.card_border_color }};
          min-height: {{ block.settings.card_height_mobile }}px;
        }
        .lst-amb-card-img-wrap-{{ block.id }} {
          position: absolute;
          inset: 0;
          background: #F3F3F3;
        }
        .lst-amb-card-img-wrap-{{ block.id }} img,
        .lst-amb-card-img-wrap-{{ block.id }} svg {
          display: block;
          width: 100%;
          height: 100%;
          object-fit: cover;
        }
        .lst-amb-card-overlay-{{ block.id }} {
          position: absolute;
          inset: 0;
          z-index: 1;
          background: linear-gradient(
            to top,
            {{ block.settings.panel_bg_color | hex_to_rgba: 0.55 }} 0%,
            {{ block.settings.panel_bg_color | hex_to_rgba: 0.25 }} 40%,
            transparent 100%
          );
          opacity: 1;
          pointer-events: none;
        }
        .lst-amb-card-default-{{ block.id }} {
          position: absolute;
          bottom: 0;
          left: 0;
          right: 0;
          z-index: 2;
          background: {{ block.settings.panel_bg_color }};
          padding: 16px 18px;
          transition: opacity 0.2s ease;
          opacity: 1;
          box-sizing: border-box;
        }
        .lst-amb-card-hover-{{ block.id }} {
          position: absolute;
          inset: 0;
          z-index: 3;
          display: flex;
          flex-direction: column;
          justify-content: flex-end;
          background: linear-gradient(
            180deg,
            transparent 0%,
            {{ block.settings.panel_bg_color | hex_to_rgba: 0.45 }} 30%,
            {{ block.settings.panel_bg_color | hex_to_rgba: 0.92 }} 65%,
            {{ block.settings.panel_bg_color | hex_to_rgba: 0.98 }} 100%
          );
          backdrop-filter: blur(6px) saturate(1.05);
          -webkit-backdrop-filter: blur(6px) saturate(1.05);
          -webkit-mask-image: linear-gradient(180deg, transparent 0%, transparent 15%, #000 55%, #000 100%);
          mask-image: linear-gradient(180deg, transparent 0%, transparent 15%, #000 55%, #000 100%);
          padding: 16px 18px;
          opacity: 1;
          transition: opacity 0.42s cubic-bezier(0.22, 1, 0.36, 1);
        }
        .lst-amb-role-d-{{ block.id }} {
          margin: 0 0 4px;
          font-size: {{ text_size_mobile | minus: 2 }}px;
          color: {{ block.settings.role_default_color }};
          letter-spacing: 0.02em;
          line-height: {{ section.settings.text_line_height }}%;
            {% if section.settings.text_custom_font %}
              font-family: var(--l4text-font);
              font-weight: var(--l4text-weight);
              font-style: var(--l4text-style);
            {% endif %}
        }
        .lst-amb-name-d-{{ block.id }} {
          margin: 0 0 8px;
          font-size: {{ text_size_mobile }}px;
          font-weight: 700;
          line-height: {{ section.settings.text_line_height }}%;
          color: {{ block.settings.name_color }};
            {% if section.settings.text_custom_font %}
              font-family: var(--l4text-font);
              font-style: var(--l4text-style);
            {% endif %}
        }
        .lst-amb-tag-{{ block.id }} {
          display: inline-block;
          font-size: 10px;
          letter-spacing: 0.1em;
          text-transform: uppercase;
          color: {{ block.settings.tag_text_color }};
          background: {{ block.settings.tag_bg_color }};
          border: 1px solid {{ block.settings.tag_border_color }};
          border-radius: 100px;
          padding: 3px 10px;
          line-height: 1.4;
          font-family: var(--l4badge-font, inherit);
          font-weight: var(--l4badge-weight, inherit);
          font-style: var(--l4badge-style, normal);
        }
        .lst-amb-role-h-{{ block.id }} {
          margin: 0 0 6px;
          font-size: {{ text_size_mobile | minus: 2 }}px;
          color: {{ block.settings.role_hover_color }};
          letter-spacing: 0.1em;
          line-height: {{ section.settings.text_line_height }}%;
          text-transform: uppercase;
            {% if section.settings.text_custom_font %}
              font-family: var(--l4text-font);
              font-weight: var(--l4text-weight);
              font-style: var(--l4text-style);
            {% endif %}
        }
        .lst-amb-name-h-{{ block.id }} {
          font-style: italic;
          margin: 0 0 8px;
          font-size: {{ text_size_mobile }}px;
          font-weight: 700;
          line-height: {{ section.settings.text_line_height }}%;
          color: {{ block.settings.name_color }};
            {% if section.settings.text_custom_font %}
              font-family: var(--l4text-font);
            {% endif %}
        }
        .lst-amb-quote-{{ block.id }} {
          margin: 0;
          font-size: {{ text_size_mobile | minus: 1 }}px;
          font-style: italic;
          color: {{ block.settings.quote_color }};
          line-height: {{ section.settings.text_line_height }}%;
            {% if section.settings.text_custom_font %}
              font-family: var(--l4text-font);
              font-weight: var(--l4text-weight);
            {% endif %}
        }
        .lst-amb-rating-{{ block.id }} {
          display: flex;
          align-items: center;
          justify-content: center;
          flex-wrap: wrap;
          gap: 12px;
          margin-top: 28px;
        }
        .lst-amb-stars-{{ block.id }} {
          display: flex;
          align-items: center;
          gap: 2px;
        }
        .lst-amb-stars-{{ block.id }} svg,
        .lst-amb-stars-{{ block.id }} img {
          display: block;
          width: {{ block.settings.stars_size }}px;
          height: {{ block.settings.stars_size }}px;
          flex-shrink: 0;
        }
        .lst-amb-rating-text-{{ block.id }} {
          font-size: {{ text_size_mobile }}px;
          color: {{ block.settings.rating_text_color }};
          line-height: {{ section.settings.text_line_height }}%;
            {% if section.settings.text_custom_font %}
              font-family: var(--l4text-font);
              font-weight: var(--l4text-weight);
              font-style: var(--l4text-style);
            {% endif %}
        }
        .lst-amb-reviews-text-{{ block.id }} {
          font-size: {{ text_size_mobile }}px;
          color: {{ block.settings.reviews_text_color }};
          line-height: {{ section.settings.text_line_height }}%;
            {% if section.settings.text_custom_font %}
              font-family: var(--l4text-font);
              font-weight: var(--l4text-weight);
              font-style: var(--l4text-style);
            {% endif %}
        }
        @media(min-width: 1024px) {
          .lst-amb-grid-{{ block.id }} {
            display: grid;
            grid-template-columns: repeat({{ block.settings.columns }}, 1fr);
            gap: 16px;
          }
          .lst-amb-swiper-wrap-{{ block.id }} {
            display: none;
          }
          .lst-amb-card-{{ block.id }} {
            border-radius: {{ block.settings.card_radius }}px;
            min-height: {{ block.settings.card_height }}px;
          }
        .lst-amb-card-default-{{ block.id }} {
          transition: opacity 0.1s ease;
        }
          .lst-amb-card-hover-{{ block.id }} {
            opacity: 0;
          transition: opacity 500ms ease;
          }
          .lst-amb-card-{{ block.id }}:hover .lst-amb-card-default-{{ block.id }} {
            opacity: 0;
            transition: opacity 0s;
          }
          .lst-amb-card-{{ block.id }}:hover .lst-amb-card-hover-{{ block.id }} {
            opacity: 1;
            transition: opacity 0s;
          }
          .lst-amb-role-h-{{ block.id }},
          .lst-amb-name-h-{{ block.id }},
          .lst-amb-quote-{{ block.id }} {
            opacity: 0;
            transform: translateY(15px);
            transition: opacity 700ms cubic-bezier(0.16, 1, 0.3, 1), transform 700ms cubic-bezier(0.16, 1, 0.3, 1);
          }
          .lst-amb-card-{{ block.id }}:hover .lst-amb-role-h-{{ block.id }} {
            opacity: 1;
            transform: translateY(0);
            transition-delay: 160ms;
          }
          .lst-amb-card-{{ block.id }}:hover .lst-amb-name-h-{{ block.id }} {
            opacity: 1;
            transform: translateY(0);
            transition-delay: 210ms;
          }
          .lst-amb-card-{{ block.id }}:hover .lst-amb-quote-{{ block.id }} {
            opacity: 1;
            transform: translateY(0);
            transition-delay: 260ms;
          }
          .lst-amb-role-d-{{ block.id }} {
            font-size: {{ text_size | minus: 2 }}px;
          }
          .lst-amb-name-d-{{ block.id }} {
            font-size: {{ text_size }}px;
          }
          .lst-amb-role-h-{{ block.id }} {
            font-size: {{ text_size | minus: 2 }}px;
          }
          .lst-amb-name-h-{{ block.id }} {
            font-size: {{ text_size }}px;
          }
          .lst-amb-quote-{{ block.id }} {
            font-size: {{ text_size | minus: 1 }}px;
          }
          .lst-amb-rating-{{ block.id }} {
            margin-top: 40px;
          }
          .lst-amb-rating-text-{{ block.id }} {
            font-size: {{ text_size }}px;
          }
          .lst-amb-reviews-text-{{ block.id }} {
            font-size: {{ text_size }}px;
          }
        }
      {% when 'testimonials' %}
        .lst-rev-{{ block.id }} {
          {% if block.settings.bg_style == 'gradient' %}
            --l4-block-bg-image: {{ block.settings.background_gradient }};
