        <script>
          (function () {
            var blockId = '{{ block.id }}';
            var wrapper = document.querySelector('.lst-vs-wrapper-' + blockId);
            var track = document.querySelector('.lst-vs-track-' + blockId);
            if (!track || !wrapper) return;

            // DRAG AND AUTO-SCROLL LOGIC
            var gap = 16;
            var duration = {{ block.settings.scroll_duration }};
            var isDown = false;
            var startX;
            var scrollLeft;
            var isHovered = false;
            var scrollPos = 0;
            var lastTime = null;
            var userScrollTimeout;
            var isDragging = false;

            function getLoopWidth() {
              return (track.scrollWidth + gap) / 2;
            }

            wrapper.addEventListener('mousedown', function(e) {
              isDown = true;
              isDragging = false;
              wrapper.style.cursor = 'grabbing';
              startX = e.pageX - wrapper.offsetLeft;
              scrollLeft = wrapper.scrollLeft;
            });
            wrapper.addEventListener('mouseleave', function() {
              isDown = false;
              wrapper.style.cursor = '';
              isHovered = false;
            });
            wrapper.addEventListener('mouseenter', function() {
              isHovered = true;
            });
            window.addEventListener('mouseup', function() {
              if (isDown) {
                isDown = false;
                wrapper.style.cursor = '';
              }
            });
            wrapper.addEventListener('mousemove', function(e) {
              if(!isDown) return;
              e.preventDefault();
              var x = e.pageX - wrapper.offsetLeft;
              var walk = (x - startX) * 1.5;
              if (Math.abs(x - startX) > 5) isDragging = true;
              wrapper.scrollLeft = scrollLeft - walk;
              scrollPos = wrapper.scrollLeft;
            });
            wrapper.addEventListener('click', function(e) {
              if (isDragging) {
                e.preventDefault();
                e.stopPropagation();
              }
            }, true);
            wrapper.addEventListener('touchstart', function() {
              isDown = true;
            }, {passive: true});
            wrapper.addEventListener('touchend', function() {
              isDown = false;
            });

            wrapper.addEventListener('scroll', function() {
               var loopWidth = getLoopWidth();
               if (loopWidth <= 0) return;

               var currentScroll = wrapper.scrollLeft;
               if (currentScroll >= track.scrollWidth - wrapper.clientWidth - 1) {
                   wrapper.scrollLeft = currentScroll - loopWidth;
                   scrollPos -= loopWidth;
               } else if (currentScroll <= 1) {
                   wrapper.scrollLeft = currentScroll + loopWidth;
                   scrollPos += loopWidth;
               }

               if (Math.abs(scrollPos - wrapper.scrollLeft) > 3) {
                   scrollPos = wrapper.scrollLeft;
                   window.clearTimeout(userScrollTimeout);
                   userScrollTimeout = setTimeout(function() {
                       userScrollTimeout = null;
                   }, 50);
               }
            });

            function autoScroll(time) {
              if (lastTime === null) lastTime = time;
              var dt = time - lastTime;
              lastTime = time;
              if (dt > 50) dt = 16;
              var loopWidth = getLoopWidth();
              if (!isDown && !isHovered && !userScrollTimeout && loopWidth > 0 && duration > 0) {
                 var pixelsPerMs = loopWidth / (duration * 1000);
                 scrollPos += pixelsPerMs * dt;
                 wrapper.scrollLeft = scrollPos;
              }
              requestAnimationFrame(autoScroll);
            }
            requestAnimationFrame(autoScroll);
            window._l4Media = window._l4Media || [];
            window._l4Media = window._l4Media.filter(function (m) {
              return document.body.contains(m.el);
            });
            function _hasMedia(el) {
              for (var i = 0; i < window._l4Media.length; i++) {
                if (window._l4Media[i].el === el) return true;
              }
              return false;
            }
            track.querySelectorAll('.lst-vs-slide-' + blockId).forEach(function (slide) {
              var vid = slide.querySelector('video');
              var ifr = slide.querySelector('iframe');
              var btn = slide.querySelector('.lst-vs-mute-' + blockId);
              if (vid && !_hasMedia(vid)) window._l4Media.push({ el: vid, type: 'video', btn: btn });
              if (ifr && !_hasMedia(ifr)) window._l4Media.push({ el: ifr, type: 'iframe', btn: btn });
            });

            if ('IntersectionObserver' in window) {
              var observer = new IntersectionObserver(function (entries) {
                // Let mobile OS natively handle video power management to prevent iOS Safari from blocking JS play() calls
                if (window.innerWidth <= 768 || 'ontouchstart' in window) return;

                var isVisible = entries[0].isIntersecting;
                track.querySelectorAll('video').forEach(function (v) {
                  if (isVisible) {
                    var slide = v.closest('.lst-vs-slide-' + blockId);
                    var muteBtn = slide ? slide.querySelector('.lst-vs-mute-' + blockId) : null;
                    if (muteBtn && !muteBtn.classList.contains('unmuted')) v.muted = true;
                    v.playsInline = true;
                    v.play().catch(function () {});
                  } else {
                    v.pause();
                  }
                });
                track.querySelectorAll('iframe').forEach(function (f) {
                  var src = f.src || '';
                  if (isVisible) {
                    if (src.indexOf('youtube') > -1)
                      f.contentWindow.postMessage('{"event":"command","func":"playVideo","args":""}', '*');
                    else if (src.indexOf('vimeo') > -1) f.contentWindow.postMessage('{"method":"play"}', '*');
                  } else {
                    if (src.indexOf('youtube') > -1)
                      f.contentWindow.postMessage('{"event":"command","func":"pauseVideo","args":""}', '*');
                    else if (src.indexOf('vimeo') > -1) f.contentWindow.postMessage('{"method":"pause"}', '*');
                  }
                });
              });
              observer.observe(wrapper);
            }

            track.addEventListener('click', function (e) {
              var muteBtn = e.target.closest('.lst-vs-mute-' + blockId);
              if (!muteBtn) return;
              var slide = muteBtn.closest('.lst-vs-slide-' + blockId);
              if (!slide) return;
              var video = slide.querySelector('video');
              var iframe = slide.querySelector('iframe');
              if (!video && !iframe) return;

              var willUnmute = !muteBtn.classList.contains('unmuted');

              if (willUnmute) {
                window._l4Media.forEach(function (m) {
                  if (m.el !== video && m.el !== iframe) {
                    if (m.type === 'video') m.el.muted = true;
                    if (m.type === 'iframe') {
                      var src = m.el.src || '';
                      if (src.indexOf('youtube') > -1)
                        m.el.contentWindow.postMessage('{"event":"command","func":"mute","args":""}', '*');
                      else if (src.indexOf('vimeo') > -1)
                        m.el.contentWindow.postMessage('{"method":"setVolume","value":0}', '*');
                    }
                    if (m.btn) m.btn.classList.remove('unmuted');
                  }
                });
              }

              if (video) {
                video.muted = !willUnmute;
              } else if (iframe) {
                var src = iframe.src || '';
                if (src.indexOf('youtube') > -1) {
                  iframe.contentWindow.postMessage(
                    '{"event":"command","func":"' + (willUnmute ? 'unMute' : 'mute') + '","args":""}',
                    '*'
                  );
                } else if (src.indexOf('vimeo') > -1) {
                  iframe.contentWindow.postMessage('{"method":"setVolume","value":' + (willUnmute ? 1 : 0) + '}', '*');
                }
              }

              muteBtn.classList.toggle('unmuted', willUnmute);
            });
          })();
        </script>

