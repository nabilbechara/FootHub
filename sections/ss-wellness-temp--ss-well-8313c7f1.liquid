        {%- assign _fp_uid = block.id | replace: '-', '_' -%}

        <script>
          (function() {
          var blockId = '{{ block.id }}';
          function initFP_{{ _fp_uid }}() {
          var fpBlock = document.querySelector('.lst-fp-' + blockId);
          if (!fpBlock) return;
          var atcBtn = fpBlock.querySelector('.lst-fp-atc-btn-' + blockId);
          var priceEl = fpBlock.querySelector('.lst-fp-price-' + blockId);
          var badgeEl = fpBlock.querySelector('.lst-fp-compare-badge-' + blockId);
          var compareRow = fpBlock.querySelector('.lst-fp-compare-row-' + blockId);
          var compareNote = fpBlock.querySelector('.lst-fp-compare-note-' + blockId);
          if (!atcBtn) return;
          let cartApp = atcBtn.dataset.cartApp || 'auto-detect';
          var variantSelect = fpBlock.querySelector('.lst-fp-variant-select-' + blockId);
          if (variantSelect) {
          variantSelect.addEventListener('change', function() {
          atcBtn.setAttribute('data-variant-id', this.value);
          var selOpt = this.options[this.selectedIndex];
          atcBtn.disabled = selOpt ? selOpt.disabled : false;
          if (priceEl && selOpt && selOpt.dataset.variantPrice) {
            priceEl.innerHTML = selOpt.dataset.variantPrice;
          }
          if (badgeEl && selOpt && selOpt.dataset.variantDiscount) {
            var disc = parseInt(selOpt.dataset.variantDiscount, 10) || 0;
            if (disc > 0) {
              var format = badgeEl.getAttribute('data-discount-format') || 'SAVE [percent]%';
              badgeEl.innerHTML = format.replace('[percent]', disc);
              badgeEl.style.display = '';
              if (compareRow) compareRow.style.display = '';
            } else {
              badgeEl.style.display = 'none';
              if (compareRow && !compareNote) compareRow.style.display = 'none';
            }
          }
          });
          }
          var variantPills = fpBlock.querySelectorAll('.lst-fp-variant-pill-' + blockId);
          if (variantPills.length) {
          variantPills.forEach(function(pill) {
          pill.addEventListener('click', function() {
          if (this.disabled) return;
          var variantId = this.getAttribute('data-variant-id');
          atcBtn.setAttribute('data-variant-id', variantId);
          variantPills.forEach(function(p) { p.classList.remove('active'); });
          this.classList.add('active');
          if (priceEl && this.dataset.variantPrice) {
            priceEl.innerHTML = this.dataset.variantPrice;
          }
          if (badgeEl && this.dataset.variantDiscount) {
            var disc = parseInt(this.dataset.variantDiscount, 10) || 0;
            if (disc > 0) {
              var format = badgeEl.getAttribute('data-discount-format') || 'SAVE [percent]%';
              badgeEl.innerHTML = format.replace('[percent]', disc);
              badgeEl.style.display = '';
              if (compareRow) compareRow.style.display = '';
            } else {
              badgeEl.style.display = 'none';
              if (compareRow && !compareNote) compareRow.style.display = 'none';
            }
          }
          });
          });
          }
          if (!atcBtn.dataset.atcInit) {
          atcBtn.dataset.atcInit = 'true';
          atcBtn.addEventListener('click', function() {
          var btn = this;
          var variantId = btn.getAttribute('data-variant-id');
          if (!variantId || btn.disabled) return;
          var inner = btn.querySelector('.lst-global-btn-inner');
          var originalHTML = inner ? inner.innerHTML : btn.innerHTML;
          var addedLabel = btn.getAttribute('data-added-label') || '✓';
          btn.disabled = true;
          if (inner) inner.textContent = '...';
          else btn.textContent = '...';
          var _cartEl = document.querySelector('cart-drawer, cart-notification');
          var _sections;
          if (_cartEl && typeof _cartEl.getSectionsToRender === 'function') {
          _sections = _cartEl.getSectionsToRender().map(function(s) { return s.id; });
          } else {
          _sections = ['cart-notification', 'cart-drawer', 'cart-icon-bubble'];
          }
          const cartItemsComponents = document.querySelectorAll('cart-items-component');
          cartItemsComponents.forEach((item) => {
          if (item instanceof HTMLElement && item.dataset.sectionId) {
          _sections.push(item.dataset.sectionId);
          }
          });
          fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
          body: JSON.stringify({ items: [{ id: parseInt(variantId, 10), quantity: 1 }], sections: _sections })
          })
          .then(function(res) { return res.json(); })
          .then(function(data) {
          if (data.status) {
          if (inner) inner.innerHTML = originalHTML;
          else btn.innerHTML = originalHTML;
          btn.disabled = false;
          if (data.description) {
            var errorEl = fpBlock.querySelector('.lst-atc-error');
            if (errorEl) {
              var errorMsgEl = errorEl.querySelector('.lst-atc-error__message');
              if (errorMsgEl) errorMsgEl.innerHTML = data.description;
              errorEl.classList.remove('hidden');
              setTimeout(function() {
                errorEl.classList.add('hidden');
              }, 4000);
            }
          }
          return;
          }
          if (inner) inner.textContent = addedLabel;
          else btn.textContent = addedLabel;
          const themeSchemaName = (window.Shopify?.theme?.schema_name ?? '').toLowerCase();
          const isCartApp = (name) => (cartApp === name || cartApp === 'auto-detect');
          if (isCartApp('upcart') && window.upcartOpenCart) {
          window.upcartOpenCart();
          window.upcartRefreshCart();
          return;
          }
          if (isCartApp('amp-cart') && window.SLIDECART_OPEN) {
          window.SLIDECART_UPDATE?.();
          window.SLIDECART_OPEN();
          return;
          }
          if (isCartApp('kaching-cart') && window.kachingCartApi) {
          window.kachingCartApi.openCart({ refetchCart: true });
          return;
          }
          var cartEl = document.querySelector('cart-drawer, cart-notification');
          if (cartEl && !['prestige', 'symmetry'].includes(themeSchemaName)) {
          if (typeof cartEl.renderContents === 'function') {
          const items = data.items || [];
          items.forEach(item => {
          item.sections = data.sections;
          cartEl.renderContents(item);
          });
          cartEl.classList.remove('is-empty');
          } else {
          if (data.sections) {
          var _parser = new DOMParser();
          Object.keys(data.sections).forEach(function(id) {
          var _src = _parser.parseFromString(data.sections[id], 'text/html').getElementById(id);
          var _dest = document.getElementById(id);
          if (_src && _dest) _dest.innerHTML = _src.innerHTML;
          });
          }
          }
          if (typeof cartEl.open === 'function') cartEl.open();
          else if (typeof cartEl.show === 'function') cartEl.show();
          return;
          }
          if (document.querySelector('cart-drawer-component')) {
          const cartUpdateEvent = new Event('cart:update', { bubbles: true });
          cartUpdateEvent.detail = {
          data: {
          itemCount: 1,
          productId: {{ block.settings.product.id }},
          source: "product-form-component"
          }
          };
          document.dispatchEvent(cartUpdateEvent);
          setTimeout(function() {
          const cartDrawerComponent = document.querySelector('cart-drawer-component');
          if (cartDrawerComponent) cartDrawerComponent.open();
          }, 100);
          return;
          }
          if (themeSchemaName === 'impulse') {
          if (window.theme?.settings?.cartType !== 'page') {
          document.dispatchEvent(new CustomEvent('ajaxProduct:added'));
          return;
          }
          }
          if (themeSchemaName === 'prestige') {
          if (window.themeVariables?.settings?.cartType !== 'page') {
          document.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true }));
          const cartDrawer = document.querySelector('cart-drawer');
          if (cartDrawer) {
          cartDrawer.show();
          } else {
          document.dispatchEvent(new CustomEvent('product:added', { detail: {} }));
          }
          return;
          }
          }
          if (themeSchemaName === 'symmetry') {
          const afterAddToCart = window.theme?.settings?.afterAddToCart ?? window.theme?.settings?.after_add_to_cart;
          if (afterAddToCart === 'drawer') {
          document.dispatchEvent(new CustomEvent('theme:cartchanged', { bubbles: true, cancelable: false, detail: { openDrawer: true } }));
          document.dispatchEvent(new CustomEvent('on:cart:change'));
          document.dispatchEvent(new CustomEvent('dispatch:cart-drawer:refresh'));
          document.dispatchEvent(new CustomEvent('dispatch:cart-drawer:open'));
          return;
          } else if (afterAddToCart === 'notification') {
          document.documentElement.dispatchEvent(new CustomEvent('theme:cartchanged', { bubbles: true, cancelable: false }));
          const items = data.items || [];
          items.forEach(item => {
          const template = document.getElementById('AddedNotification');
          if (template) {
            const notification = template.content.firstElementChild.cloneNode(true);
            notification.dataset.productTitle = item.product_title;
            let notificationContainer = document.querySelector('.pageheader--sticky');
            if (!notificationContainer) notificationContainer = document.querySelector('body');
            notificationContainer.appendChild(notification);
          }
          });
          return;
          }
          }
          const cartUrl = window.theme?.routes?.cartPage ?? '/cart';
          window.location.href = cartUrl;
          })
          .catch(function() {
          if (inner) inner.innerHTML = originalHTML;
          else btn.innerHTML = originalHTML;
          btn.disabled = false;
          })
          .finally(function() {
          setTimeout(function() {
          if (inner) inner.innerHTML = originalHTML;
          else btn.innerHTML = originalHTML;
          btn.disabled = false;
          }, 2500);
          });
          });
          }
          }
          if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', initFP_{{ _fp_uid }});
          } else {
          initFP_{{ _fp_uid }}();
          }
          if (typeof Shopify !== 'undefined' && Shopify.designMode) {
          document.addEventListener('shopify:section:load', initFP_{{ _fp_uid }});
          document.addEventListener('shopify:block:select', function(e) {
          if (e.detail && e.detail.blockId === blockId) initFP_{{ _fp_uid }}();
          });
          }
          })();
        </script>

      {% when 'testimonial_card' %}

    {% endcase %}
  {% endfor %}
