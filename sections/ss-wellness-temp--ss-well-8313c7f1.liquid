            {% endif %}

            <div class="lst-stats-cards-{{ block.id }}">
              {% for i in (1..4) %}
                {%- assign _st_title_key = 'card' | append: i | append: '_title' -%}
                {%- assign _st_stat_key = 'card' | append: i | append: '_stat' -%}
                {%- assign _st_text_key = 'card' | append: i | append: '_text' -%}
                {% if block.settings[_st_title_key] != blank or block.settings[_st_stat_key] != blank %}
