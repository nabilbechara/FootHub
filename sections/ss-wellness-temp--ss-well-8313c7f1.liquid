          align-items: center;
          gap: 2px;
          margin-bottom: 8px;
        }
        .lst-rev-card-stars-{{ block.id }} svg,
        .lst-rev-card-stars-{{ block.id }} img {
          display: block;
          width: {{ block.settings.star_size }}px;
          height: {{ block.settings.star_size }}px;
          object-fit: contain;
          flex-shrink: 0;
        }
        .lst-rev-card-meta-{{ block.id }} {
          display: flex;
          align-items: baseline;
          flex-wrap: wrap;
          gap: 4px 8px;
