{% if section.settings.enable_animation %}
  <script>
    (function () {
      function initLst4Animation() {
        var wrapper = document.querySelector('.lst-section-{{ section.id }}');
        if (!wrapper || wrapper.dataset.lst4Anim) return;
        wrapper.dataset.lst4Anim = '1';
        var blocks = Array.prototype.slice.call(wrapper.children);
        if (!('IntersectionObserver' in window)) {
          blocks.forEach(function (b) {
            b.style.opacity = '1';
          });
          return;
        }
        var delay = 0;
        var observer = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting && !entry.target.classList.contains('l4animated')) {
                var el = entry.target;
                el.style.animationDelay = delay + 'ms';
                delay += 80;
                el.classList.add('l4animated');
                observer.unobserve(el);
              }
            });
          },
          { threshold: 0.08, rootMargin: '0px 0px -40px 0px' }
        );
        blocks.forEach(function (b) {
          observer.observe(b);
        });
      }
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initLst4Animation);
      } else {
        initLst4Animation();
      }
      if (typeof Shopify !== 'undefined' && Shopify.designMode) {
        document.addEventListener('shopify:section:load', initLst4Animation);
      }
    })();
  </script>
{% endif %}

