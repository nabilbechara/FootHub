<section class="newsletter-section" id="section-{{ section.id }}">
  <div class="container" style="text-align:center">
    {%- if section.settings.eyebrow != blank -%}
      <p class="section-header__eyebrow fade-up" style="color:rgba(255,255,255,0.6)">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    <h2 class="section-header__title fade-up" style="color:#fff;margin-bottom:1rem">
      {{ section.settings.heading | default: 'Stay Ahead of the Game' }}
    </h2>
    {%- if section.settings.subheading != blank -%}
      <p class="section-header__subtitle fade-up" style="color:rgba(255,255,255,0.6);margin-inline:auto">
        {{ section.settings.subheading }}
      </p>
    {%- endif -%}

    {%- form 'customer', id: 'newsletter-form-{{ section.id }}' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <div class="newsletter-form fade-up">
        <input
          class="newsletter-form__input"
          type="email"
          name="contact[email]"
          id="newsletter-email-{{ section.id }}"
          placeholder="{{ section.settings.placeholder | default: 'Enter your email' }}"
          required
          autocomplete="email"
          aria-label="Email address for newsletter"
        >
        <button class="newsletter-form__btn" type="submit">
          {{ section.settings.button_label | default: 'Subscribe' }}
        </button>
      </div>
      <p class="newsletter-privacy fade-up">
        {{ section.settings.privacy_text | default: 'No spam. Unsubscribe any time.' }}
      </p>
      {%- if form.posted_successfully? -%}
        <p style="color:#4ade80;font-size:0.875rem;font-weight:600;margin-top:1rem">✓ You're subscribed! Welcome to the FootHub family.</p>
      {%- endif -%}
    {%- endform -%}

    {%- if section.settings.show_cta_buttons -%}
      <div style="display:flex;justify-content:center;gap:1rem;margin-top:3rem;flex-wrap:wrap">
        {%- if section.settings.btn1_label != blank -%}
          <a class="btn btn--white btn--lg" href="{{ section.settings.btn1_link | default: '/collections/all' }}">
            {{ section.settings.btn1_label }}
          </a>
        {%- endif -%}
        {%- if section.settings.btn2_label != blank -%}
          <a class="btn btn--outline-white btn--lg" href="{{ section.settings.btn2_link | default: '/collections/new' }}">
            {{ section.settings.btn2_label }}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Newsletter / CTA",
  "tag": "section",
  "class": "newsletter-wrapper",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Join the community" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Stay Ahead of the Game" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Exclusive drops, early access, and match-day deals straight to your inbox." },
    { "type": "text", "id": "placeholder", "label": "Input placeholder", "default": "Enter your email" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Subscribe" },
    { "type": "text", "id": "privacy_text", "label": "Privacy text" },
    { "type": "header", "content": "CTA Buttons" },
    { "type": "checkbox", "id": "show_cta_buttons", "label": "Show CTA buttons", "default": false },
    { "type": "text", "id": "btn1_label", "label": "Button 1 label" },
    { "type": "url", "id": "btn1_link", "label": "Button 1 link" },
    { "type": "text", "id": "btn2_label", "label": "Button 2 label" },
    { "type": "url", "id": "btn2_link", "label": "Button 2 link" }
  ],
  "presets": [{ "name": "Newsletter / CTA" }]
}
{% endschema %}
