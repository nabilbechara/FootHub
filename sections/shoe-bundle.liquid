{%- liquid
  assign bundle_enabled = section.settings.enabled
  assign show_bundle = false

  if section.settings.show_on_all
    assign show_bundle = true
  else
    assign col1 = section.settings.collection_1
    assign col2 = section.settings.collection_2
    assign col3 = section.settings.collection_3
    for col in product.collections
      if col1 != blank and col.handle == col1.handle
        assign show_bundle = true
      endif
      if col2 != blank and col.handle == col2.handle
        assign show_bundle = true
      endif
      if col3 != blank and col.handle == col3.handle
        assign show_bundle = true
      endif
    endfor
  endif
-%}

{%- if bundle_enabled and show_bundle and section.blocks.size > 0 -%}
<div class="bundle-tier-section" id="section-{{ section.id }}">
  <div class="container">
    <div
      class="bundle-tier-picker"
      data-main-variant="{{ product.selected_or_first_available_variant.id }}"
      data-main-price="{{ product.price }}"
    >

      <p class="bundle-tier-picker__heading">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/>
          <line x1="3" y1="6" x2="21" y2="6"/>
          <path d="M16 10a4 4 0 0 1-8 0"/>
        </svg>
        Choose Your Package
      </p>

      <div class="bundle-tier-picker__options" role="radiogroup" aria-label="Choose your package">

        <!-- Shoes Only -->
        <label class="bundle-tier-option" for="tier-solo-{{ section.id }}">
          <input
            type="radio"
            id="tier-solo-{{ section.id }}"
            name="bundle-tier-{{ section.id }}"
            value="solo"
            class="bundle-tier-radio"
          >
          <div class="bundle-tier-option__body">
            <div class="bundle-tier-option__row">
              <span class="bundle-tier-option__check" aria-hidden="true">
                <svg width="10" height="10" viewBox="0 0 10 10" fill="none"><polyline points="1.5,5 4,7.5 8.5,2.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </span>
              <div class="bundle-tier-option__info">
                <span class="bundle-tier-option__name">Shoes Only</span>
              </div>
              <span class="bundle-tier-option__price">{{ product.price | money }}</span>
            </div>
          </div>
        </label>

        {%- for block in section.blocks -%}

          {%- comment -%}── SHOES BUNDLE: boot + one bundle product, visual thumbnails only ──{%- endcomment -%}
          {%- if block.type == 'shoes_bundle' -%}
            {%- liquid
              assign bp = all_products[block.settings.bundle_product]
            -%}
            {%- if bp != blank -%}
              {%- assign shoes_bundle_total = product.price | plus: bp.price -%}
              <label
                class="bundle-tier-option{% if forloop.first %} is-selected{% endif %}"
                for="tier-bundle-{{ block.id }}"
              >
                <input
                  type="radio"
                  id="tier-bundle-{{ block.id }}"
                  name="bundle-tier-{{ section.id }}"
                  value="{{ block.id }}"
                  class="bundle-tier-radio"
                  {% if forloop.first %}checked{% endif %}
                >
                <div
                  class="bundle-tier-option__body"
                  data-bundle-block="{{ block.id }}"
                  data-bundle-type="shoes_bundle"
                  data-bundle-product-variant="{{ bp.selected_or_first_available_variant.id }}"
                  data-base-price="{{ product.price }}"
                >
                  <div class="bundle-tier-option__row">
                    <span class="bundle-tier-option__check" aria-hidden="true">
                      <svg width="10" height="10" viewBox="0 0 10 10" fill="none"><polyline points="1.5,5 4,7.5 8.5,2.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </span>
                    <div class="bundle-tier-option__info">
                      <span class="bundle-tier-option__name">{{ block.settings.label | default: 'The Shoes Bundle' }}</span>
                    </div>
                    <span class="bundle-tier-option__now">{{ shoes_bundle_total | money }}</span>
                  </div>

                  <!-- Visual thumbnails — shoe + up to 4 display images (cosmetic only, not added to cart) -->
                  <div class="bundle-tier-option__items">
                    {%- if product.featured_image -%}
                      <div class="bundle-tier-item" title="{{ product.title | escape }}">
                        <img src="{{ product.featured_image | image_url: width: 120 }}" alt="{{ product.title | escape }}" width="48" height="48" loading="lazy">
                      </div>
                    {%- endif -%}

                    {%- for i in (1..4) -%}
                      {%- liquid
                        assign img_key = 'display_image_' | append: i
                        assign title_key = 'display_title_' | append: i
                        assign disp_img = block.settings[img_key]
                        assign disp_title = block.settings[title_key]
                      -%}
                      {%- if disp_img != blank -%}
                        <span class="bundle-tier-item__plus" aria-hidden="true">+</span>
                        <div class="bundle-tier-item" title="{{ disp_title | escape }}">
                          <img src="{{ disp_img | image_url: width: 120 }}" alt="{{ disp_title | escape }}" width="48" height="48" loading="lazy">
                        </div>
                      {%- endif -%}
                    {%- endfor -%}
                  </div>
                </div>
              </label>
            {%- endif -%}

          {%- comment -%}── JERSEY BUNDLE: boot + jersey picker, £5 off, once per purchase ──{%- endcomment -%}
          {%- elsif block.type == 'jersey_bundle' -%}
            {%- liquid
              assign choice_col = collections[block.settings.choice_collection.handle]
              assign first_jersey_price = 0
              if choice_col != blank and choice_col.products.size > 0
                assign first_jersey_price = choice_col.products.first.price
              endif
              assign jersey_discount_cents = 500
              assign jersey_original_total = product.price | plus: first_jersey_price
              assign jersey_bundle_total = jersey_original_total | minus: jersey_discount_cents
            -%}

            {%- if choice_col != blank -%}
              <label
                class="bundle-tier-option{% if forloop.first %} is-selected{% endif %}"
                for="tier-bundle-{{ block.id }}"
              >
                <input
                  type="radio"
                  id="tier-bundle-{{ block.id }}"
                  name="bundle-tier-{{ section.id }}"
                  value="{{ block.id }}"
                  class="bundle-tier-radio"
                  {% if forloop.first %}checked{% endif %}
                >
                <div
                  class="bundle-tier-option__body"
                  data-bundle-block="{{ block.id }}"
                  data-bundle-type="jersey_bundle"
                  data-discount-code="{{ block.settings.discount_code | escape }}"
                  data-base-price="{{ product.price }}"
                  data-fixed-total="0"
                  data-first-choice-price="{{ first_jersey_price }}"
                  data-discount-fixed-amount="{{ jersey_discount_cents }}"
                >
                  <div class="bundle-tier-option__row">
                    <span class="bundle-tier-option__check" aria-hidden="true">
                      <svg width="10" height="10" viewBox="0 0 10 10" fill="none"><polyline points="1.5,5 4,7.5 8.5,2.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </span>
                    <div class="bundle-tier-option__info">
                      <span class="bundle-tier-option__name">{{ block.settings.label | default: 'Boot + Jersey Bundle' }}</span>
                      <span class="bundle-tier-option__badge">Save £5</span>
                    </div>
                    <div class="bundle-tier-option__prices">
                      <span class="bundle-tier-option__was" data-bundle-original>{{ jersey_original_total | money }}</span>
                      <span class="bundle-tier-option__now" data-bundle-price>{{ jersey_bundle_total | money }}</span>
                    </div>
                  </div>

                  <!-- Thumbnails: shoe + jersey pick placeholder -->
                  <div class="bundle-tier-option__items">
                    {%- if product.featured_image -%}
                      <div class="bundle-tier-item" title="{{ product.title | escape }}">
                        <img src="{{ product.featured_image | image_url: width: 120 }}" alt="{{ product.title | escape }}" width="48" height="48" loading="lazy">
                      </div>
                    {%- endif -%}
                    <span class="bundle-tier-item__plus" aria-hidden="true">+</span>
                    <div class="bundle-tier-item bundle-tier-item--choice" title="{{ block.settings.choice_label | default: 'Your jersey' }}">
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 8v4l3 3"/></svg>
                      <span>Pick one</span>
                    </div>
                  </div>

                  <!-- Jersey picker -->
                  {%- if choice_col.products.size > 0 -%}
                    <div class="bundle-tier-option__picker">
                      <div class="bundle-jersey-picker" data-block="{{ block.id }}">

                        <p class="bundle-jersey-picker__step-label">
                          <span class="bundle-jersey-step-num">1</span>
                          {{ block.settings.choice_label | default: 'Choose your jersey' }}
                        </p>
                        <div class="bundle-jersey-picker__grid" role="listbox" aria-label="{{ block.settings.choice_label | default: 'Choose your jersey' }}">
                          {%- for choice_product in choice_col.products limit: 8 -%}
                            <button
                              class="bundle-jersey-card"
                              type="button"
                              data-product-idx="{{ forloop.index0 }}"
                              data-product-title="{{ choice_product.title | escape }}"
                              aria-pressed="false"
                              aria-label="{{ choice_product.title | escape }}"
                            >
                              {%- if choice_product.featured_image -%}
                                <img src="{{ choice_product.featured_image | image_url: width: 200 }}" alt="{{ choice_product.title | escape }}" width="72" height="72" loading="lazy">
                              {%- else -%}
                                <div class="bundle-jersey-card__placeholder">?</div>
                              {%- endif -%}
                              <span class="bundle-jersey-card__name">{{ choice_product.title | truncate: 22 }}</span>
                              <span class="bundle-jersey-card__price">{{ choice_product.price_min | money }}</span>
                            </button>
                          {%- endfor -%}
                        </div>

                        {%- for choice_product in choice_col.products limit: 8 -%}
                          <div class="bundle-size-panel" data-for-idx="{{ forloop.index0 }}" hidden>
                            <p class="bundle-size-panel__label">
                              <span class="bundle-jersey-step-num">2</span>
                              Select size — <strong>{{ choice_product.title | truncate: 28 }}</strong>
                            </p>
                            <div class="bundle-size-panel__grid">
                              {%- for variant in choice_product.variants -%}
                                <button
                                  class="bundle-size-btn"
                                  type="button"
                                  data-variant-id="{{ variant.id }}"
                                  data-price="{{ variant.price }}"
                                  {% unless variant.available %}disabled aria-label="{{ variant.title }} — sold out"{% endunless %}
                                >{{ variant.title }}</button>
                              {%- endfor -%}
                            </div>
                          </div>
                        {%- endfor -%}

                        <input type="hidden" class="bundle-choice-variant" value="">
                        <p class="bundle-jersey-picker__hint" aria-live="polite" aria-atomic="true"></p>
                      </div>
                    </div>
                  {%- endif -%}

                  {%- if block.settings.discount_code != blank -%}
                    <p class="bundle-pricing__code-note">
                      Code <strong>{{ block.settings.discount_code }}</strong> auto-applied · valid once per purchase
                    </p>
                  {%- endif -%}

                </div>
              </label>
            {%- endif -%}

          {%- endif -%}
        {%- endfor -%}

      </div>

      <button
        class="btn btn--accent btn--full bundle-tier-add-btn"
        type="button"
        aria-label="Add to bag"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/>
          <line x1="3" y1="6" x2="21" y2="6"/>
          <path d="M16 10a4 4 0 0 1-8 0"/>
        </svg>
        Add to Bag
      </button>

    </div>
  </div>
</div>

<script>
  (function() {
    var picker = document.querySelector('.bundle-tier-picker');
    var trustBadges = document.querySelector('.trust-badges');
    var bundleSection = document.getElementById('section-{{ section.id }}');
    if (picker && trustBadges) trustBadges.parentNode.insertBefore(picker, trustBadges);
    if (bundleSection) bundleSection.style.display = 'none';
    var atcRow = document.querySelector('.product-atc');
    if (atcRow) atcRow.style.display = 'none';
    var buyNow = document.getElementById('buy-now-btn');
    if (buyNow) buyNow.style.display = 'none';
  })();
</script>
{%- endif -%}

{% schema %}
{
  "name": "Bundle & Save",
  "settings": [
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "Enable bundle section",
      "default": true
    },
    {
      "type": "header",
      "content": "Show bundle for products in these collections"
    },
    {
      "type": "collection",
      "id": "collection_1",
      "label": "Collection 1 (e.g. Football Boots)"
    },
    {
      "type": "collection",
      "id": "collection_2",
      "label": "Collection 2 (optional)"
    },
    {
      "type": "collection",
      "id": "collection_3",
      "label": "Collection 3 (optional)"
    },
    {
      "type": "checkbox",
      "id": "show_on_all",
      "label": "Show on ALL products regardless of collection",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "shoes_bundle",
      "name": "Shoes Bundle",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Bundle option name",
          "default": "The Shoes Bundle"
        },
        {
          "type": "paragraph",
          "content": "Select the single Shopify product that represents the full bundle. Set its price in the product admin — that price is added to the shoe price. Only the boot + this one product are added to cart."
        },
        {
          "type": "product",
          "id": "bundle_product",
          "label": "Bundle product (e.g. 'The Shoes Bundle')"
        },
        {
          "type": "header",
          "content": "Visual thumbnails (display only)"
        },
        {
          "type": "image_picker",
          "id": "display_image_1",
          "label": "Item 1 image"
        },
        {
          "type": "text",
          "id": "display_title_1",
          "label": "Item 1 title",
          "default": "Shin Pads"
        },
        {
          "type": "image_picker",
          "id": "display_image_2",
          "label": "Item 2 image"
        },
        {
          "type": "text",
          "id": "display_title_2",
          "label": "Item 2 title",
          "default": "Training Ball"
        },
        {
          "type": "image_picker",
          "id": "display_image_3",
          "label": "Item 3 image"
        },
        {
          "type": "text",
          "id": "display_title_3",
          "label": "Item 3 title",
          "default": "Boot Bag"
        },
        {
          "type": "image_picker",
          "id": "display_image_4",
          "label": "Item 4 image"
        },
        {
          "type": "text",
          "id": "display_title_4",
          "label": "Item 4 title",
          "default": "Grip Socks"
        }
      ]
    },
    {
      "type": "jersey_bundle",
      "name": "Boot + Jersey Bundle",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Bundle option name",
          "default": "Boot + Jersey Bundle"
        },
        {
          "type": "header",
          "content": "Jersey selection"
        },
        {
          "type": "collection",
          "id": "choice_collection",
          "label": "Jersey collection (customers pick from here)"
        },
        {
          "type": "text",
          "id": "choice_label",
          "label": "Picker heading",
          "default": "Choose your jersey"
        },
        {
          "type": "header",
          "content": "£5 discount — once per purchase"
        },
        {
          "type": "paragraph",
          "content": "Price shown = boot price + jersey price − £5. Create a discount code in Shopify Admin → Discounts, set it to £5 off, and enable 'Limit to one use per customer' to enforce once-per-purchase. Enter the code below so it auto-applies at checkout."
        },
        {
          "type": "text",
          "id": "discount_code",
          "label": "Discount code (e.g. JERSEY5OFF)",
          "info": "Must exist in Shopify Admin → Discounts. Set to £5 off with one-use-per-customer."
        }
      ]
    }
  ],
  "max_blocks": 2,
  "presets": [
    { "name": "Bundle & Save" }
  ]
}
{% endschema %}
