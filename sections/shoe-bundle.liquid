{%- liquid
  assign bundle_enabled = section.settings.enabled
  assign show_bundle = false

  if section.settings.show_on_all
    assign show_bundle = true
  else
    assign col1 = section.settings.collection_1
    assign col2 = section.settings.collection_2
    assign col3 = section.settings.collection_3
    for col in product.collections
      if col1 != blank and col.handle == col1.handle
        assign show_bundle = true
      endif
      if col2 != blank and col.handle == col2.handle
        assign show_bundle = true
      endif
      if col3 != blank and col.handle == col3.handle
        assign show_bundle = true
      endif
    endfor
  endif
-%}

{%- if bundle_enabled and show_bundle and section.blocks.size > 0 -%}
<div class="section bundle-section" id="section-{{ section.id }}">
  <div class="container">
    <div class="bundle-header fade-up">
      <p class="section-header__eyebrow">{{ section.settings.eyebrow | default: 'Bundle & Save' }}</p>
      <h2 class="bundle-header__title">{{ section.settings.heading | default: 'Complete Your Kit' }}</h2>
      <p class="bundle-header__sub">{{ section.settings.subheading | default: 'Add matching gear and save more.' }}</p>
    </div>

    <div class="bundle-options">
      {%- for block in section.blocks -%}
        {%- assign bundle_product = all_products[block.settings.bundle_product] -%}
        {%- if bundle_product != blank -%}
          {%- assign discount = block.settings.discount | default: 10 -%}
          {%- assign bundle_variant = bundle_product.first_available_variant | default: bundle_product.variants[0] -%}
          {%- assign original_total_cents = product.price | plus: bundle_variant.price -%}
          {%- assign discount_amount = original_total_cents | times: discount | divided_by: 100 -%}
          {%- assign bundle_total_cents = original_total_cents | minus: discount_amount -%}

          <div class="bundle-card fade-up" {{ block.shopify_attributes }}>
            <div class="bundle-card__products">
              <div class="bundle-card__product">
                {%- if product.featured_image -%}
                  <img
                    src="{{ product.featured_image | image_url: width: 200 }}"
                    alt="{{ product.title | escape }}"
                    width="90" height="90"
                    loading="lazy"
                  >
                {%- endif -%}
                <span class="bundle-card__product-name">{{ product.title | truncate: 28 }}</span>
              </div>

              <div class="bundle-card__plus">
                <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                  <path d="M10 4v12M4 10h12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                </svg>
              </div>

              <div class="bundle-card__product">
                {%- if bundle_product.featured_image -%}
                  <img
                    src="{{ bundle_product.featured_image | image_url: width: 200 }}"
                    alt="{{ bundle_product.title | escape }}"
                    width="90" height="90"
                    loading="lazy"
                  >
                {%- else -%}
                  <div class="bundle-card__no-img">
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                  </div>
                {%- endif -%}
                <span class="bundle-card__product-name">{{ bundle_product.title | truncate: 28 }}</span>
              </div>
            </div>

            <div class="bundle-card__pricing">
              <div class="bundle-card__save-badge">Save {{ discount }}%</div>
              <div class="bundle-card__prices">
                <span class="bundle-card__was">{{ original_total_cents | money }}</span>
                <span class="bundle-card__now">{{ bundle_total_cents | money }}</span>
              </div>
              <p class="bundle-card__desc">{{ block.settings.label | default: 'Bundle Deal' }}</p>
            </div>

            <button
              class="btn btn--accent btn--full bundle-add-btn"
              data-bundle-main="{{ product.selected_or_first_available_variant.id }}"
              data-bundle-addon="{{ bundle_variant.id }}"
              data-bundle-label="{{ block.settings.label | escape }}"
              type="button"
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/>
                <path d="M16 10a4 4 0 0 1-8 0"/>
              </svg>
              Add Bundle to Bag
            </button>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Bundle & Save",
  "settings": [
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "Enable bundle section",
      "default": true
    },
    {
      "type": "header",
      "content": "Show bundle for products in these collections"
    },
    {
      "type": "collection",
      "id": "collection_1",
      "label": "Collection 1 (e.g. Football Boots)"
    },
    {
      "type": "collection",
      "id": "collection_2",
      "label": "Collection 2 (optional)"
    },
    {
      "type": "collection",
      "id": "collection_3",
      "label": "Collection 3 (optional)"
    },
    {
      "type": "checkbox",
      "id": "show_on_all",
      "label": "Show on ALL products regardless of collection",
      "default": false
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Bundle & Save"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Complete Your Kit"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Add matching gear and save more."
    }
  ],
  "blocks": [
    {
      "type": "bundle",
      "name": "Bundle Option",
      "settings": [
        {
          "type": "product",
          "id": "bundle_product",
          "label": "Add-on product (jersey, care kit, etc.)"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Bundle label",
          "default": "Boots + Jersey Bundle"
        },
        {
          "type": "range",
          "id": "discount",
          "label": "Discount %",
          "min": 5,
          "max": 30,
          "step": 5,
          "default": 10
        }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "Bundle & Save"
    }
  ]
}
{% endschema %}
