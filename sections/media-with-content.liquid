{%- liquid
  assign is_reverse = false
  if section.settings.layout == 'image_right'
    assign is_reverse = true
  endif
  assign bg_class = ''
  if section.settings.bg == 'dark'
    assign bg_class = 'split-section__content--dark'
  endif
-%}

<section class="split-section{% if is_reverse %} split-section--reverse{% endif %}" id="section-{{ section.id }}">
  <div class="split-section__media">
    {%- if section.settings.video_url != blank -%}
      <video
        style="width:100%;height:100%;object-fit:cover"
        autoplay muted loop playsinline preload="metadata"
        aria-hidden="true"
      >
        <source src="{{ section.settings.video_url }}" type="video/mp4">
      </video>
    {%- elsif section.settings.image != blank -%}
      <img
        class="split-section__img"
        src="{{ section.settings.image | image_url: width: 1000 }}"
        srcset="{{ section.settings.image | image_url: width: 600 }} 600w, {{ section.settings.image | image_url: width: 900 }} 900w, {{ section.settings.image | image_url: width: 1200 }} 1200w"
        sizes="(max-width:768px) 100vw, 50vw"
        alt="{{ section.settings.image.alt | escape | default: section.settings.heading }}"
        loading="lazy"
        width="{{ section.settings.image.width }}"
        height="{{ section.settings.image.height }}"
      >
    {%- else -%}
      <div style="width:100%;height:100%;min-height:500px;background:var(--color-gray-200);display:flex;align-items:center;justify-content:center;color:var(--color-gray-400)">
        {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
      </div>
    {%- endif -%}
  </div>

  <div class="split-section__content {{ bg_class }}">
    {%- if section.settings.eyebrow != blank -%}
      <p class="section-header__eyebrow fade-up">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="section-header__title fade-up" style="margin-bottom:1.25rem">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <div class="rte fade-up" style="{% if section.settings.bg == 'dark' %}color:rgba(255,255,255,0.7){% endif %}">
        {{ section.settings.text }}
      </div>
    {%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a
        class="btn btn--{{ section.settings.button_style }} fade-up"
        href="{{ section.settings.button_link | default: '#' }}"
        style="margin-top:2rem;display:inline-flex"
      >
        {{ section.settings.button_label }}
      </a>
    {%- endif -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'stat' -%}
        <div class="fade-up" style="display:flex;gap:2.5rem;margin-top:2.5rem;flex-wrap:wrap" {{ block.shopify_attributes }}>
          {%- if block.settings.stat_1_value != blank -%}
            <div>
              <p style="font-family:var(--font-display);font-size:2.5rem;font-weight:900;letter-spacing:-0.05em;color:{% if section.settings.bg == 'dark' %}#fff{% else %}var(--color-text){% endif %}">{{ block.settings.stat_1_value }}</p>
              <p style="font-size:0.75rem;font-weight:600;letter-spacing:0.1em;text-transform:uppercase;color:var(--color-text-muted)">{{ block.settings.stat_1_label }}</p>
            </div>
          {%- endif -%}
          {%- if block.settings.stat_2_value != blank -%}
            <div>
              <p style="font-family:var(--font-display);font-size:2.5rem;font-weight:900;letter-spacing:-0.05em;color:{% if section.settings.bg == 'dark' %}#fff{% else %}var(--color-text){% endif %}">{{ block.settings.stat_2_value }}</p>
              <p style="font-size:0.75rem;font-weight:600;letter-spacing:0.1em;text-transform:uppercase;color:var(--color-text-muted)">{{ block.settings.stat_2_label }}</p>
            </div>
          {%- endif -%}
          {%- if block.settings.stat_3_value != blank -%}
            <div>
              <p style="font-family:var(--font-display);font-size:2.5rem;font-weight:900;letter-spacing:-0.05em;color:{% if section.settings.bg == 'dark' %}#fff{% else %}var(--color-text){% endif %}">{{ block.settings.stat_3_value }}</p>
              <p style="font-size:0.75rem;font-weight:600;letter-spacing:0.1em;text-transform:uppercase;color:var(--color-text-muted)">{{ block.settings.stat_3_label }}</p>
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Image with Text",
  "tag": "section",
  "class": "split-section-wrapper",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "video_url", "label": "Video URL (.mp4)", "info": "Overrides image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our Story" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Built For The Beautiful Game" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>We exist for one reason: to give every footballer access to the gear worn by the best in the world. Authentic. Premium. Delivered fast.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "select", "id": "button_style", "label": "Button style", "options": [{ "value": "primary", "label": "Black" },{ "value": "accent", "label": "Red" },{ "value": "outline", "label": "Outline" }], "default": "primary" },
    { "type": "select", "id": "layout", "label": "Image position", "options": [{ "value": "image_left", "label": "Image left" },{ "value": "image_right", "label": "Image right" }], "default": "image_left" },
    { "type": "select", "id": "bg", "label": "Content background", "options": [{ "value": "light", "label": "Light" },{ "value": "dark", "label": "Dark" }], "default": "light" }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stats row",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "stat_1_value", "label": "Stat 1 value", "default": "10K+" },
        { "type": "text", "id": "stat_1_label", "label": "Stat 1 label", "default": "Kits Sold" },
        { "type": "text", "id": "stat_2_value", "label": "Stat 2 value", "default": "50+" },
        { "type": "text", "id": "stat_2_label", "label": "Stat 2 label", "default": "Brands" },
        { "type": "text", "id": "stat_3_value", "label": "Stat 3 value", "default": "4.9★" },
        { "type": "text", "id": "stat_3_label", "label": "Stat 3 label", "default": "Avg Rating" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Image with Text",
      "settings": {
        "eyebrow": "Our Story",
        "heading": "Built For The Beautiful Game",
        "layout": "image_left"
      }
    }
  ]
}
{% endschema %}
