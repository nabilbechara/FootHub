<section class="section" id="section-{{ section.id }}" style="{% if section.settings.bg == 'dark' %}background:var(--color-gray-900);{% else %}background:var(--color-gray-50);{% endif %}">
  <div class="container">
    <div class="section-header section-header--centered">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <p class="section-header__eyebrow fade-up">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        <h2 class="section-header__title fade-up" style="{% if section.settings.bg == 'dark' %}color:#fff{% endif %}">
          {{ section.settings.heading | default: 'Real Reviews. Real Fans.' }}
        </h2>
        {%- if section.settings.show_aggregate -%}
          <div class="fade-up" style="display:flex;align-items:center;justify-content:center;gap:0.75rem;margin-top:1.25rem">
            <div class="stars" aria-label="4.9 out of 5">
              {%- for i in (1..5) -%}
                <svg width="16" height="16" viewBox="0 0 20 20" fill="#f59e0b" aria-hidden="true"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 0 0 .95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 0 0-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 0 0-1.176 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 0 0-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 0 0 .951-.69l1.07-3.292Z"/></svg>
              {%- endfor -%}
            </div>
            <span style="font-size:1.125rem;font-weight:700;{% if section.settings.bg == 'dark' %}color:#fff{% endif %}">{{ section.settings.aggregate_rating | default: '4.9' }}</span>
            <span style="font-size:0.875rem;color:var(--color-text-muted)">from {{ section.settings.review_count | default: '2,400+' }} reviews</span>
          </div>
        {%- endif -%}
      </div>
    </div>

    <div class="testimonials-grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'review' -%}
          <div class="testimonial-card fade-up" {{ block.shopify_attributes }}>
            <div class="testimonial-card__stars">
              {%- assign rating = block.settings.rating | default: 5 -%}
              {%- for i in (1..5) -%}
                {%- if i <= rating -%}
                  <svg width="13" height="13" viewBox="0 0 20 20" fill="#f59e0b" aria-hidden="true"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 0 0 .95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 0 0-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 0 0-1.176 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 0 0-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 0 0 .951-.69l1.07-3.292Z"/></svg>
                {%- else -%}
                  <svg width="13" height="13" viewBox="0 0 20 20" fill="var(--color-gray-200)" aria-hidden="true"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 0 0 .95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 0 0-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 0 0-1.176 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 0 0-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 0 0 .951-.69l1.07-3.292Z"/></svg>
                {%- endif -%}
              {%- endfor -%}
            </div>
            {%- if block.settings.product_name != blank -%}
              <p style="font-size:0.7rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;color:var(--color-accent)">{{ block.settings.product_name }}</p>
            {%- endif -%}
            <p class="testimonial-card__text">"{{ block.settings.review_text }}"</p>
            <div class="testimonial-card__author">
              {%- if block.settings.avatar != blank -%}
                <img class="testimonial-card__avatar" src="{{ block.settings.avatar | image_url: width: 88 }}" alt="{{ block.settings.name }}" loading="lazy" width="44" height="44">
              {%- else -%}
                <div class="testimonial-card__avatar" style="background:var(--color-gray-200);display:flex;align-items:center;justify-content:center;font-size:1.1rem;font-weight:700;color:var(--color-gray-600)">
                  {{ block.settings.name | slice: 0 }}
                </div>
              {%- endif -%}
              <div>
                <div class="testimonial-card__name">{{ block.settings.name }}</div>
                {%- if block.settings.location != blank -%}<div class="testimonial-card__location">{{ block.settings.location }}</div>{%- endif -%}
                {%- if block.settings.verified -%}
                  <div style="font-size:0.65rem;color:#16a34a;font-weight:600;letter-spacing:0.05em;text-transform:uppercase;margin-top:2px">✓ Verified Purchase</div>
                {%- endif -%}
              </div>
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Reviews",
  "tag": "section",
  "class": "reviews-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Trusted by thousands" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Real Reviews. Real Fans." },
    { "type": "checkbox", "id": "show_aggregate", "label": "Show aggregate rating", "default": true },
    { "type": "text", "id": "aggregate_rating", "label": "Aggregate rating", "default": "4.9" },
    { "type": "text", "id": "review_count", "label": "Review count", "default": "2,400+" },
    { "type": "select", "id": "bg", "label": "Background", "options": [{ "value": "light", "label": "Light" },{ "value": "dark", "label": "Dark" }], "default": "light" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "range", "id": "rating", "label": "Rating", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "text", "id": "product_name", "label": "Product name (optional)" },
        { "type": "textarea", "id": "review_text", "label": "Review", "default": "Absolutely class gear. Arrived fast and quality is unreal." },
        { "type": "image_picker", "id": "avatar", "label": "Avatar" },
        { "type": "text", "id": "name", "label": "Name", "default": "Marcus T." },
        { "type": "text", "id": "location", "label": "Location", "default": "London, UK" },
        { "type": "checkbox", "id": "verified", "label": "Verified purchase badge", "default": true }
      ]
    }
  ],
  "presets": [
    {
      "name": "Reviews",
      "blocks": [
        { "type": "review", "settings": { "name": "Marcus T.", "location": "London, UK", "review_text": "Absolutely class gear. Arrived fast and the quality is unreal. My son loves his new kit.", "product_name": "Home Jersey 24/25", "rating": 5, "verified": true } },
        { "type": "review", "settings": { "name": "Sofia R.", "location": "Manchester", "review_text": "Third time ordering and the boots are quality as always. Delivery was next day. Will keep coming back.", "product_name": "Football Boots", "rating": 5, "verified": true } },
        { "type": "review", "settings": { "name": "James K.", "location": "Birmingham", "review_text": "Best online football store I've found. Huge selection, competitive prices, and fast shipping. Highly recommend.", "rating": 5, "verified": true } }
      ]
    }
  ]
}
{% endschema %}
