{% comment %}
  WC 2026 Homepage — banner, countdown, product grid, CTA.
  Markup and card styles mirror pro-best-sellers.liquid exactly.
{% endcomment %}

{%- assign wc_bg = section.settings.bg_color | default: '#0a0a0a' -%}

<section class="wc-home" style="background: {{ wc_bg }};">
  <div class="wc-home__inner">

    <header class="wc-home__header">
      <div class="wc-home__header-lockup">
        <img
          src="{{ 'world-cup-trophy.png' | asset_url }}"
          alt=""
          class="wc-home__trophy"
          loading="lazy"
          width="48"
          height="48"
        >
        {% if section.settings.heading != blank %}
          <h2 class="wc-home__heading">{{ section.settings.heading }}</h2>
        {% endif %}
      </div>
      {% if section.settings.subheading != blank %}
        <p class="wc-home__subheading">{{ section.settings.subheading }}</p>
      {% endif %}
    </header>

    {% if section.settings.show_countdown %}
      <div class="wc-home__countdown-wrap" id="wc-home-countdown-wrap-{{ section.id }}">
        <div class="wc-home__countdown" id="wc-home-countdown-{{ section.id }}">
          <div class="wc-home__unit">
            <span class="wc-home__num" id="wc-home-days-{{ section.id }}">--</span>
            <span class="wc-home__unit-label">days</span>
          </div>
          <span class="wc-home__sep">:</span>
          <div class="wc-home__unit">
            <span class="wc-home__num" id="wc-home-hours-{{ section.id }}">--</span>
            <span class="wc-home__unit-label">hrs</span>
          </div>
          <span class="wc-home__sep">:</span>
          <div class="wc-home__unit">
            <span class="wc-home__num" id="wc-home-mins-{{ section.id }}">--</span>
            <span class="wc-home__unit-label">min</span>
          </div>
          <span class="wc-home__sep">:</span>
          <div class="wc-home__unit">
            <span class="wc-home__num" id="wc-home-secs-{{ section.id }}">--</span>
            <span class="wc-home__unit-label">sec</span>
          </div>
        </div>
      </div>

      <script>
        (function () {
          var target   = new Date({{ section.settings.countdown_target | json }});
          var wrapEl   = document.getElementById('wc-home-countdown-wrap-{{ section.id }}');
          var cntEl    = document.getElementById('wc-home-countdown-{{ section.id }}');
          var daysEl   = document.getElementById('wc-home-days-{{ section.id }}');
          var hoursEl  = document.getElementById('wc-home-hours-{{ section.id }}');
          var minsEl   = document.getElementById('wc-home-mins-{{ section.id }}');
          var secsEl   = document.getElementById('wc-home-secs-{{ section.id }}');
          function pad(n) { return String(n).padStart(2, '0'); }
          function tick() {
            var diff = target - new Date();
            if (diff <= 0) {
              cntEl.innerHTML = '<span class="wc-home__kickoff-msg">&#x26BD; The World Cup is here</span>';
              clearInterval(timer);
              return;
            }
            daysEl.textContent  = Math.floor(diff / 86400000);
            hoursEl.textContent = pad(Math.floor((diff % 86400000) / 3600000));
            minsEl.textContent  = pad(Math.floor((diff % 3600000)  / 60000));
            secsEl.textContent  = pad(Math.floor((diff % 60000)    / 1000));
          }
          tick();
          var timer = setInterval(tick, 1000);
        })();
      </script>
    {% endif %}

    {% if section.settings.collection != blank %}
      <div class="wc-home__grid">
        {% for product in section.settings.collection.products limit: section.settings.products_limit %}
          <div class="wc-home__card">

            <div class="wc-home__image">
              <div class="wc-home__wc-badge" aria-label="World Cup 2026 Collection">
                <img src="{{ 'world-cup-trophy.png' | asset_url }}" alt="" class="wc-home__wc-badge-icon" loading="lazy">
                <span>WC 2026</span>
              </div>
              {% if product.compare_at_price > product.price %}
                <span class="wc-home__sale-badge">Sale</span>
              {% endif %}
              {% if product.featured_image %}
                <a href="{{ product.url }}" class="wc-home__image-link" aria-label="{{ product.title | escape }}">
                  <img
                    src="{{ product.featured_image | image_url: width: 900 }}"
                    alt="{{ product.title | escape }}"
                    loading="lazy"
                  >
                </a>
              {% endif %}

              {% if product.available %}
                <form method="post" action="/cart/add" class="wc-home__quick-add">
                  <p class="wc-home__quick-title">{{ product.title }}</p>
                  <div class="wc-home__variant-row">
                    <span class="wc-home__variant-label">Size:</span>
                    {% assign rendered_variants = 0 %}
                    {% for variant in product.variants %}
                      {% if variant.available and rendered_variants < 7 %}
                        <label class="wc-home__variant">
                          <input
                            type="radio"
                            name="id"
                            value="{{ variant.id }}"
                            {% if rendered_variants == 0 %}checked{% endif %}
                          >
                          <span>{{ variant.title | replace: 'Default Title', 'One Size' }}</span>
                        </label>
                        {% assign rendered_variants = rendered_variants | plus: 1 %}
                      {% endif %}
                    {% endfor %}
                  </div>
                  <input type="hidden" name="quantity" value="1">
                  <button type="submit" class="wc-home__quick-button">Add to cart</button>
                </form>
              {% endif %}
            </div>

            <div class="wc-home__info">
              <h3><a href="{{ product.url }}">{{ product.title }}</a></h3>
              <p class="wc-home__price">
                <span>{{ product.price | money }}</span>
                {% if product.compare_at_price > product.price %}
                  <s>{{ product.compare_at_price | money }}</s>
                {% endif %}
              </p>
            </div>

          </div>
        {% endfor %}
      </div>

      {% if section.settings.cta_label != blank %}
        {%- assign cta_href = section.settings.cta_link | default: section.settings.collection.url -%}
        <div class="wc-home__cta">
          <a href="{{ cta_href }}" class="wc-home__cta-btn">
            {{ section.settings.cta_label }}
          </a>
        </div>
      {% endif %}
    {% endif %}

  </div>
</section>

<style>
  .wc-home {
    padding: {{ section.settings.padding_y }}px {{ section.settings.padding_x }}px;
  }

  .wc-home__inner {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
  }

  /* ── Header ── */
  .wc-home__header {
    text-align: center;
    margin-bottom: 44px;
  }

  .wc-home__header-lockup {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    margin-bottom: 14px;
  }

  .wc-home__trophy {
    width: 48px;
    height: 48px;
    object-fit: contain;
    flex-shrink: 0;
    filter: drop-shadow(0 0 8px rgba(212, 175, 55, 0.6));
  }

  .wc-home__heading {
    margin: 0;
    font-size: clamp(2.4rem, 5vw, 3.8rem);
    line-height: 1.0;
    font-weight: 500;
    letter-spacing: -0.03em;
    color: #D4AF37;
  }

  .wc-home__subheading {
    margin: 0;
    font-size: 1rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.65);
    max-width: 560px;
    margin-left: auto;
    margin-right: auto;
  }

  /* ── Countdown ── */
  .wc-home__countdown-wrap {
    display: flex;
    justify-content: center;
    margin-bottom: 52px;
  }

  .wc-home__countdown {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 18px 28px;
    border: 1px solid rgba(212, 175, 55, 0.35);
    background: rgba(212, 175, 55, 0.06);
  }

  .wc-home__unit {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 52px;
  }

  .wc-home__num {
    font-size: clamp(1.8rem, 4vw, 2.6rem);
    font-weight: 700;
    color: #D4AF37;
    line-height: 1;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }

  .wc-home__unit-label {
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: rgba(255, 255, 255, 0.45);
    margin-top: 4px;
  }

  .wc-home__sep {
    font-size: clamp(1.4rem, 3vw, 2rem);
    font-weight: 700;
    color: rgba(212, 175, 55, 0.5);
    align-self: flex-start;
    padding-top: 2px;
    line-height: 1.1;
  }

  .wc-home__kickoff-msg {
    font-size: 1.1rem;
    font-weight: 700;
    color: #D4AF37;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  /* ── Product grid ── */
  .wc-home__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    column-gap: 54px;
    row-gap: 64px;
    align-items: start;
  }

  .wc-home__card {
    color: #ffffff;
    transition: transform 0.25s ease;
  }

  .wc-home__card:hover {
    transform: translateY(-4px);
  }

  .wc-home__image {
    position: relative;
    background: #1a1a1a;
    border-radius: {{ section.settings.radius }}px;
    overflow: hidden;
    aspect-ratio: 1 / 1;
  }

  .wc-home__image-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    padding: 8%;
  }

  .wc-home__image img:not(.wc-home__wc-badge-icon) {
    width: 100%;
    height: 100%;
    max-width: 100%;
    max-height: 100%;
    display: block;
    object-fit: contain;
    object-position: center;
    transform: scale(1.08);
    transform-origin: center;
  }

  /* WC gold badge on each card */
  .wc-home__wc-badge {
    position: absolute;
    top: 8px;
    left: 8px;
    z-index: 3;
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 4px 8px 4px 5px;
    background: linear-gradient(135deg, rgba(22, 16, 0, 0.93) 0%, rgba(10, 8, 0, 0.93) 100%);
    border: 1px solid #D4AF37;
    border-radius: 4px;
    box-shadow: 0 2px 8px rgba(212, 175, 55, 0.35);
    color: #D4AF37;
    font-family: "Montserrat", "Helvetica Neue", Arial, sans-serif;
    font-size: 0.6rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    line-height: 1;
    white-space: nowrap;
    pointer-events: none;
  }

  .wc-home__wc-badge-icon {
    height: 14px;
    width: auto;
    flex-shrink: 0;
    object-fit: contain;
  }

  /* Sale badge */
  .wc-home__sale-badge {
    position: absolute;
    top: 8px;
    right: 0;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 26px;
    padding: 0 10px;
    background: #d40000;
    color: #ffffff;
    font-size: 0.7rem;
    line-height: 1;
    font-weight: 800;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  /* Quick-add overlay */
  .wc-home__quick-add {
    position: absolute;
    left: 50%;
    bottom: 12px;
    z-index: 4;
    width: min(92%, 330px);
    padding: 12px;
    background: rgba(255, 255, 255, 0.96);
    border: 1px solid rgba(0, 0, 0, 0.08);
    box-shadow: 0 14px 34px rgba(0, 0, 0, 0.3);
    opacity: 0;
    visibility: hidden;
    transform: translate(-50%, 10px);
    transition: opacity 0.2s ease, transform 0.2s ease, visibility 0s linear 0.2s;
  }

  .wc-home__card:hover .wc-home__quick-add,
  .wc-home__quick-add:focus-within {
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, 0);
    transition: opacity 0.2s ease, transform 0.2s ease, visibility 0s linear 0s;
  }

  .wc-home__quick-title {
    display: inline-block;
    margin: 0 0 10px;
    padding: 5px 8px;
    background: #1f1f1f;
    color: #ffffff;
    font-size: 0.72rem;
    line-height: 1.1;
  }

  .wc-home__variant-row {
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
    margin-bottom: 10px;
  }

  .wc-home__variant-label {
    margin-right: 4px;
    font-size: 0.78rem;
    color: #111;
  }

  .wc-home__variant input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .wc-home__variant span {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 34px;
    height: 34px;
    border: 1px solid #d8d8d8;
    background: #ffffff;
    color: #111111;
    font-size: 0.78rem;
    cursor: pointer;
  }

  .wc-home__variant input:checked + span {
    background: #000000;
    border-color: #000000;
    color: #ffffff;
  }

  .wc-home__quick-button {
    width: 100%;
    height: 42px;
    border: 0;
    background: #000000;
    color: #ffffff;
    font-size: 0.92rem;
    cursor: pointer;
  }

  /* Card info */
  .wc-home__info {
    padding-top: 14px;
    text-align: center;
  }

  .wc-home__info h3 {
    margin: 0 0 8px;
    font-size: 1.05rem;
    line-height: 1.3;
    font-weight: 500;
    color: #f0f0f0;
    min-height: 2.8em;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .wc-home__info h3 a {
    color: inherit;
    text-decoration: none;
  }

  .wc-home__info h3 a:hover {
    color: #D4AF37;
  }

  .wc-home__price {
    margin: 0;
    font-size: 1rem;
    font-weight: 700;
    color: #ffffff;
  }

  .wc-home__price s {
    margin-left: 6px;
    color: rgba(255, 255, 255, 0.45);
    font-weight: 400;
  }

  /* ── CTA ── */
  .wc-home__cta {
    text-align: center;
    margin-top: 52px;
  }

  .wc-home__cta-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 14px 32px;
    min-height: 50px;
    border: 1px solid #D4AF37;
    border-radius: 999px;
    background: transparent;
    color: #D4AF37;
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    transition: all 0.25s ease;
  }

  .wc-home__cta-btn:hover {
    background: #D4AF37;
    color: #0a0a0a;
    transform: translateY(-2px);
  }

  /* ── Responsive ── */
  @media (max-width: 990px) {
    .wc-home__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: 18px;
      row-gap: 36px;
    }
  }

  @media (max-width: 768px) {
    .wc-home {
      padding: calc({{ section.settings.padding_y }}px * 0.8) 16px;
    }

    .wc-home__header {
      margin-bottom: 28px;
    }

    .wc-home__header-lockup {
      gap: 10px;
    }

    .wc-home__trophy {
      width: 36px;
      height: 36px;
    }

    .wc-home__countdown {
      gap: 4px;
      padding: 14px 16px;
    }

    .wc-home__unit {
      min-width: 38px;
    }

    .wc-home__countdown-wrap {
      margin-bottom: 36px;
    }

    .wc-home__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 14px;
      row-gap: 28px;
    }

    .wc-home__card {
      min-width: 0;
    }

    .wc-home__image-link {
      padding: 9%;
    }

    .wc-home__quick-add {
      display: none;
    }

    .wc-home__cta {
      margin-top: 36px;
    }

    .wc-home__cta-btn {
      border-radius: 0;
      background: #D4AF37;
      color: #0a0a0a;
      border-color: #D4AF37;
    }
  }
</style>

{% schema %}
{
  "name": "WC 2026 Homepage",
  "settings": [
    { "type": "text",     "id": "heading",    "label": "Heading",    "default": "World Cup 2026" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Wear what the stars wear — shop the boots of the tournament’s biggest names" },
    { "type": "header", "content": "Countdown" },
    { "type": "checkbox", "id": "show_countdown", "label": "Show countdown timer", "default": true, "info": "Disable if you have a separate countdown section on the page." },
    { "type": "text",     "id": "countdown_target", "label": "Target date & time", "default": "2026-06-11T22:00:00+03:00", "info": "ISO 8601 format with timezone. Example: 2026-06-11T22:00:00+03:00 = 22:00 Beirut summer time." },
    { "type": "header", "content": "Products" },
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Select your world-cup-2026 collection." },
    { "type": "range",    "id": "products_limit", "label": "Number of products", "min": 4, "max": 12, "step": 1, "default": 8 },
    { "type": "header", "content": "Call to action" },
    { "type": "text",     "id": "cta_label", "label": "Button label", "default": "Shop the World Cup collection" },
    { "type": "url",      "id": "cta_link",  "label": "Button link", "info": "Defaults to the selected collection URL if left blank." },
    { "type": "header", "content": "Layout" },
    { "type": "color",    "id": "bg_color",   "label": "Background color", "default": "#0a0a0a" },
    { "type": "range",    "id": "max_width",  "label": "Max width",           "min": 800, "max": 1600, "step": 40, "unit": "px", "default": 1480 },
    { "type": "range",    "id": "padding_y",  "label": "Vertical padding",    "min": 24,  "max": 120,  "step": 4,  "unit": "px", "default": 80 },
    { "type": "range",    "id": "padding_x",  "label": "Horizontal padding",  "min": 12,  "max": 64,   "step": 4,  "unit": "px", "default": 24 },
    { "type": "range",    "id": "radius",     "label": "Image corner radius", "min": 0,   "max": 24,   "step": 2,  "unit": "px", "default": 12 }
  ],
  "presets": [{ "name": "WC 2026 Homepage" }]
}
{% endschema %}
