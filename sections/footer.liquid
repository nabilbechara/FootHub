<footer class="site-footer" id="site-footer" role="contentinfo">
  <div class="container">
    <div class="footer-top">

      <!-- Brand Column -->
      <div class="footer-brand">
        {%- if settings.logo != blank -%}
          <img
            class="footer-brand__logo"
            src="{{ settings.logo | image_url: height: 60 }}"
            alt="{{ shop.name }}"
            width="{{ settings.logo.width }}"
            height="{{ settings.logo.height }}"
            loading="lazy"
          >
        {%- else -%}
          <p style="font-family:var(--font-display);font-size:1.5rem;font-weight:900;letter-spacing:-0.04em;text-transform:uppercase;color:#fff;margin-bottom:1.25rem">
            {{ shop.name }}
          </p>
        {%- endif -%}

        {%- if section.settings.brand_description != blank -%}
          <p class="footer-brand__desc">{{ section.settings.brand_description }}</p>
        {%- else -%}
          <p class="footer-brand__desc">Premium football gear for elite players. Authentic. Official. Unrivalled.</p>
        {%- endif -%}

        <div class="footer-social">
          {%- if section.settings.social_instagram != blank -%}
            <a class="footer-social__link" href="{{ section.settings.social_instagram }}" target="_blank" rel="noopener" aria-label="Instagram">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/>
                <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/>
              </svg>
            </a>
          {%- endif -%}
          {%- if section.settings.social_tiktok != blank -%}
            <a class="footer-social__link" href="{{ section.settings.social_tiktok }}" target="_blank" rel="noopener" aria-label="TikTok">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-2.88 2.5 2.89 2.89 0 01-2.89-2.89 2.89 2.89 0 012.89-2.89c.28 0 .54.04.79.1V9.01a6.33 6.33 0 00-.79-.05 6.34 6.34 0 00-6.34 6.34 6.34 6.34 0 006.34 6.34 6.34 6.34 0 006.33-6.34V8.69a8.3 8.3 0 004.86 1.55V6.77a4.85 4.85 0 01-1.09-.08z"/>
              </svg>
            </a>
          {%- endif -%}
          {%- if section.settings.social_twitter != blank -%}
            <a class="footer-social__link" href="{{ section.settings.social_twitter }}" target="_blank" rel="noopener" aria-label="X / Twitter">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.744l7.73-8.835L1.254 2.25H8.08l4.26 5.632zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
              </svg>
            </a>
          {%- endif -%}
          {%- if section.settings.social_youtube != blank -%}
            <a class="footer-social__link" href="{{ section.settings.social_youtube }}" target="_blank" rel="noopener" aria-label="YouTube">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                <path d="M22.54 6.42a2.78 2.78 0 0 0-1.95-1.97C18.88 4 12 4 12 4s-6.88 0-8.59.46A2.78 2.78 0 0 0 1.46 6.42 29 29 0 0 0 1 12a29 29 0 0 0 .46 5.58A2.78 2.78 0 0 0 3.41 19.6C5.12 20 12 20 12 20s6.88 0 8.59-.4a2.78 2.78 0 0 0 1.95-1.97A29 29 0 0 0 23 12a29 29 0 0 0-.46-5.58z"/>
                <polygon points="9.75 15.02 15.5 12 9.75 8.98 9.75 15.02"/>
              </svg>
            </a>
          {%- endif -%}
        </div>
      </div>

      <!-- Link Columns -->
      {%- for block in section.blocks -%}
        {%- if block.type == 'link_list' -%}
          <div class="footer-col" {{ block.shopify_attributes }}>
            <h3 class="footer-col__heading">{{ block.settings.heading }}</h3>
            <ul class="footer-col__list" role="list">
              {%- for link in linklists[block.settings.menu].links -%}
                <li>
                  <a class="footer-col__link" href="{{ link.url }}">{{ link.title }}</a>
                </li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
      {%- endfor -%}

      <!-- Newsletter -->
      {%- if section.settings.show_newsletter -%}
        <div class="footer-col">
          <h3 class="footer-col__heading">{{ section.settings.newsletter_heading | default: 'Stay Updated' }}</h3>
          <p style="font-size:0.8rem;color:rgba(255,255,255,0.5);margin-bottom:1rem;line-height:1.6">
            {{ section.settings.newsletter_text | default: 'Get exclusive drops, match-day offers and new arrivals.' }}
          </p>
          {%- form 'customer', id: 'footer-newsletter-form' -%}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <div style="display:flex;flex-direction:column;gap:0.5rem">
              <input
                type="email"
                name="contact[email]"
                placeholder="Your email"
                required
                style="
                  background:rgba(255,255,255,0.07);
                  border:1px solid rgba(255,255,255,0.15);
                  color:#fff;
                  padding:0.75rem 1rem;
                  font-size:0.875rem;
                  outline:none;
                  width:100%;
                "
                aria-label="Email address"
              >
              <button
                type="submit"
                style="
                  background:var(--color-accent);
                  color:#fff;
                  border:none;
                  padding:0.75rem 1rem;
                  font-size:0.75rem;
                  font-weight:600;
                  letter-spacing:0.1em;
                  text-transform:uppercase;
                  cursor:pointer;
                  width:100%;
                  transition:background 0.2s;
                "
              >Subscribe</button>
            </div>
            {%- if form.posted_successfully? -%}
              <p style="color:#4ade80;font-size:0.8rem;margin-top:0.5rem">✓ You're subscribed!</p>
            {%- endif -%}
          {%- endform -%}
        </div>
      {%- endif -%}

    </div>

    <!-- Bottom Bar -->
    <div class="footer-bottom">
      <p class="footer-bottom__copy">
        © {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.
        {%- if section.settings.show_powered_by -%}
          Built on <a href="https://www.shopify.com" style="color:inherit;opacity:0.6" target="_blank" rel="noopener">Shopify</a>.
        {%- endif -%}
      </p>

      <div style="display:flex;align-items:center;gap:1rem;flex-wrap:wrap">
        {%- if section.settings.policy_menu != blank -%}
          {%- for link in linklists[section.settings.policy_menu].links -%}
            <a
              href="{{ link.url }}"
              style="font-size:0.7rem;color:rgba(255,255,255,0.35);transition:color 0.2s"
            >
              {{ link.title }}
            </a>
          {%- endfor -%}
        {%- else -%}
          <a href="/policies/privacy-policy" style="font-size:0.7rem;color:rgba(255,255,255,0.35)">Privacy</a>
          <a href="/policies/terms-of-service" style="font-size:0.7rem;color:rgba(255,255,255,0.35)">Terms</a>
          <a href="/policies/refund-policy" style="font-size:0.7rem;color:rgba(255,255,255,0.35)">Returns</a>
        {%- endif -%}
      </div>

      <div class="footer-payments">
        {%- for type in shop.enabled_payment_types -%}
          {{ type | payment_type_img_url: '120x75' | img_tag: type, 'payment-icon' }}
        {%- endfor -%}
      </div>
    </div>

  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "text",
      "id": "brand_description",
      "label": "Brand description"
    },
    {
      "type": "header",
      "content": "Social Links"
    },
    {
      "type": "url",
      "id": "social_instagram",
      "label": "Instagram URL"
    },
    {
      "type": "url",
      "id": "social_tiktok",
      "label": "TikTok URL"
    },
    {
      "type": "url",
      "id": "social_twitter",
      "label": "X / Twitter URL"
    },
    {
      "type": "url",
      "id": "social_youtube",
      "label": "YouTube URL"
    },
    {
      "type": "header",
      "content": "Newsletter"
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "Show newsletter signup",
      "default": true
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Newsletter heading",
      "default": "Stay Updated"
    },
    {
      "type": "text",
      "id": "newsletter_text",
      "label": "Newsletter description",
      "default": "Get exclusive drops, match-day offers and new arrivals."
    },
    {
      "type": "link_list",
      "id": "policy_menu",
      "label": "Policy links menu"
    },
    {
      "type": "checkbox",
      "id": "show_powered_by",
      "label": "Show 'Powered by Shopify'",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "link_list",
      "name": "Link column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Column heading",
          "default": "Shop"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Navigation menu"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Footer"
    }
  ]
}
{% endschema %}
