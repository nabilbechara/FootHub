<section class="shoe-reel" id="shoe-reel-{{ section.id }}">
  <div class="shoe-reel__header">
    {% if section.settings.heading != blank %}
      <h2 class="shoe-reel__heading">{{ section.settings.heading }}</h2>
    {% endif %}
    {% if section.settings.subheading != blank %}
      <p class="shoe-reel__subheading">{{ section.settings.subheading }}</p>
    {% endif %}
  </div>

  <div class="shoe-reel__track-wrap">
    <div class="shoe-reel__track" id="shoe-reel-track-{{ section.id }}">

      {% for block in section.blocks %}
        <div class="shoe-reel__card" {{ block.shopify_attributes }}>
          <div class="shoe-reel__player">

            {%- if block.settings.video != blank -%}
              <div class="shoe-reel__shimmer" aria-hidden="true"></div>
              <video
                class="shoe-reel__video"
                muted
                loop
                playsinline
                preload="none"
                data-autoload="true"
              >
                {%- for source in block.settings.video.sources -%}
                  <source data-src="{{ source.url }}" type="{{ source.mime_type }}">
                {%- endfor -%}
              </video>
            {%- else -%}
              <div class="shoe-reel__empty">
                <svg width="40" height="40" viewBox="0 0 40 40" fill="none">
                  <circle cx="20" cy="20" r="18" stroke="rgba(255,255,255,0.15)" stroke-width="1.5"/>
                  <path d="M16 13l11 7-11 7V13Z" fill="rgba(255,255,255,0.2)"/>
                </svg>
                <span>Upload video in theme editor</span>
              </div>
            {%- endif -%}

          </div>

          {% if block.settings.label != blank %}
            <p class="shoe-reel__label">{{ block.settings.label }}</p>
          {% endif %}

          {% if block.settings.product_link != blank %}
            <a href="{{ block.settings.product_link }}" class="shoe-reel__btn">Shop this →</a>
          {% endif %}
        </div>
      {% endfor %}

    </div>

    <button class="shoe-reel__arrow shoe-reel__arrow--prev" aria-label="Previous" data-reel="{{ section.id }}">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><path d="M15 18l-6-6 6-6"/></svg>
    </button>
    <button class="shoe-reel__arrow shoe-reel__arrow--next" aria-label="Next" data-reel="{{ section.id }}">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18"><path d="M9 18l6-6-6-6"/></svg>
    </button>
  </div>
</section>

<style>
  .shoe-reel {
    background: {{ section.settings.bg_color | default: '#0a0a0a' }};
    padding: {{ section.settings.padding_y | default: 80 }}px 0;
    overflow: hidden;
  }

  .shoe-reel__header {
    text-align: center;
    padding: 0 24px;
    margin-bottom: 40px;
  }

  .shoe-reel__heading {
    margin: 0 0 10px;
    font-size: clamp(1.8rem, 3.5vw, 2.8rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: #ffffff;
  }

  .shoe-reel__subheading {
    margin: 0;
    font-size: 0.97rem;
    color: rgba(255,255,255,0.5);
    max-width: 46ch;
    margin-inline: auto;
    line-height: 1.55;
  }

  .shoe-reel__track-wrap {
    position: relative;
    padding: 0 60px;
  }

  .shoe-reel__track {
    display: flex;
    gap: 16px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    cursor: grab;
  }

  .shoe-reel__track::-webkit-scrollbar { display: none; }
  .shoe-reel__track.is-grabbing { cursor: grabbing; user-select: none; }

  .shoe-reel__card {
    flex: 0 0 clamp(220px, 22vw, 300px);
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .shoe-reel__player {
    position: relative;
    width: 100%;
    aspect-ratio: 9 / 16;
    background: #111;
    border-radius: 14px;
    overflow: hidden;
  }

  /* shimmer while buffering */
  .shoe-reel__shimmer {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      110deg,
      #1a1a1a 30%,
      #2a2a2a 50%,
      #1a1a1a 70%
    );
    background-size: 200% 100%;
    animation: reel-shimmer 1.4s linear infinite;
    border-radius: 14px;
    z-index: 1;
    transition: opacity 0.3s ease;
  }

  .shoe-reel__shimmer.is-hidden {
    opacity: 0;
    pointer-events: none;
  }

  @keyframes reel-shimmer {
    0%   { background-position: 200% 0; }
    100% { background-position: -200% 0; }
  }

  .shoe-reel__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    opacity: 0;
    transition: opacity 0.35s ease;
    z-index: 2;
  }

  .shoe-reel__video.is-ready {
    opacity: 1;
  }

  .shoe-reel__empty {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 14px;
    color: rgba(255,255,255,0.25);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-align: center;
    padding: 20px;
    border: 1px dashed rgba(255,255,255,0.08);
    border-radius: 14px;
  }

  .shoe-reel__label {
    margin: 0;
    font-size: 0.85rem;
    font-weight: 600;
    color: rgba(255,255,255,0.75);
    line-height: 1.3;
  }

  .shoe-reel__btn {
    display: inline-flex;
    align-items: center;
    color: #D4AF37;
    font-size: 0.75rem;
    font-weight: 700;
    text-decoration: none;
    letter-spacing: 0.04em;
    transition: letter-spacing 0.2s ease;
  }

  .shoe-reel__btn:hover { letter-spacing: 0.08em; }

  .shoe-reel__arrow {
    position: absolute;
    top: 40%;
    transform: translateY(-50%);
    width: 42px;
    height: 42px;
    border-radius: 50%;
    border: 1px solid rgba(255,255,255,0.15);
    background: rgba(10,10,10,0.85);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 5;
    transition: background 0.2s, border-color 0.2s;
    backdrop-filter: blur(8px);
  }

  .shoe-reel__arrow:hover {
    background: rgba(255,255,255,0.1);
    border-color: rgba(255,255,255,0.35);
  }

  .shoe-reel__arrow--prev { left: 12px; }
  .shoe-reel__arrow--next { right: 12px; }

  @media (max-width: 640px) {
    .shoe-reel__track-wrap { padding: 0 16px; }
    .shoe-reel__arrow { display: none; }
    .shoe-reel__card { flex: 0 0 72vw; }
  }
</style>

<script>
(function () {
  var section = document.getElementById('shoe-reel-{{ section.id }}');
  var track   = document.getElementById('shoe-reel-track-{{ section.id }}');
  if (!track) return;

  /* ── lazy-load videos via IntersectionObserver ── */
  function activateVideo(video) {
    if (video.dataset.loaded) return;
    video.dataset.loaded = 'true';

    var shimmer = video.parentElement.querySelector('.shoe-reel__shimmer');

    /* move data-src → src so the browser starts fetching */
    video.querySelectorAll('source[data-src]').forEach(function (s) {
      s.setAttribute('src', s.dataset.src);
      s.removeAttribute('data-src');
    });

    video.load();

    var onReady = function () {
      video.classList.add('is-ready');
      if (shimmer) shimmer.classList.add('is-hidden');
      video.play().catch(function(){});
    };

    if (video.readyState >= 3) {
      onReady();
    } else {
      video.addEventListener('canplay', onReady, { once: true });
    }
  }

  /* observe section with 400px margin so loading starts before scrolling into view */
  var sectionObserver = new IntersectionObserver(function (entries) {
    entries.forEach(function (entry) {
      if (!entry.isIntersecting) return;
      sectionObserver.disconnect();
      track.querySelectorAll('video[data-autoload]').forEach(activateVideo);
    });
  }, { rootMargin: '400px 0px' });

  sectionObserver.observe(section);

  /* ── drag to scroll ── */
  var dragging = false, startX = 0, scrollStart = 0;
  track.addEventListener('mousedown', function (e) {
    dragging = true; startX = e.pageX; scrollStart = track.scrollLeft;
    track.classList.add('is-grabbing');
  });
  window.addEventListener('mouseup', function () {
    dragging = false; track.classList.remove('is-grabbing');
  });
  track.addEventListener('mousemove', function (e) {
    if (!dragging) return;
    e.preventDefault();
    track.scrollLeft = scrollStart - (e.pageX - startX);
  });

  /* ── arrow buttons ── */
  var reelId = '{{ section.id }}';
  document.querySelectorAll('.shoe-reel__arrow[data-reel="' + reelId + '"]').forEach(function (btn) {
    btn.addEventListener('click', function () {
      var dir  = btn.classList.contains('shoe-reel__arrow--prev') ? -1 : 1;
      var card = track.querySelector('.shoe-reel__card');
      track.scrollBy({ left: dir * ((card ? card.offsetWidth : 280) + 16), behavior: 'smooth' });
    });
  });
})();
</script>

{% schema %}
{
  "name": "Shoe Video Reel",
  "max_blocks": 8,
  "settings": [
    { "type": "text",  "id": "heading",    "label": "Heading",    "default": "On the pitch. On camera." },
    { "type": "text",  "id": "subheading", "label": "Subheading", "default": "The boots that move the game — in motion." },
    { "type": "color", "id": "bg_color",   "label": "Background", "default": "#0a0a0a" },
    { "type": "range", "id": "padding_y",  "label": "Vertical padding", "min": 40, "max": 120, "step": 8, "unit": "px", "default": 80 }
  ],
  "blocks": [
    {
      "type": "video_card",
      "name": "Video Card",
      "settings": [
        { "type": "video", "id": "video",        "label": "Video (upload MP4 via Files)" },
        { "type": "text",  "id": "label",        "label": "Shoe name" },
        { "type": "url",   "id": "product_link", "label": "Product link (optional)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shoe Video Reel",
      "blocks": [
        { "type": "video_card" },
        { "type": "video_card" },
        { "type": "video_card" },
        { "type": "video_card" }
      ]
    }
  ]
}
{% endschema %}
