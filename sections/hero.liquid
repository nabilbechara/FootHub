{%- liquid
  assign height_class = 'hero--' | append: section.settings.height
  assign overlay_opacity = section.settings.overlay_opacity | divided_by: 100.0
-%}

<section class="hero {{ height_class }}" id="section-{{ section.id }}">
  {%- if section.settings.video_url != blank -%}
    <div class="hero__media" aria-hidden="true">
      <video
        class="hero__video"
        autoplay
        muted
        loop
        playsinline
        preload="{{ section.settings.preload_video | default: 'metadata' }}"
      >
        <source src="{{ section.settings.video_url }}" type="video/mp4">
      </video>
    </div>
  {%- elsif section.settings.image != blank -%}
    <div class="hero__media">
      <img
        class="hero__img"
        src="{{ section.settings.image | image_url: width: 2000 }}"
        srcset="
          {{ section.settings.image | image_url: width: 800 }} 800w,
          {{ section.settings.image | image_url: width: 1200 }} 1200w,
          {{ section.settings.image | image_url: width: 1600 }} 1600w,
          {{ section.settings.image | image_url: width: 2000 }} 2000w
        "
        sizes="100vw"
        alt="{{ section.settings.image.alt | escape | default: section.settings.heading }}"
        loading="eager"
        fetchpriority="high"
        width="{{ section.settings.image.width }}"
        height="{{ section.settings.image.height }}"
      >
    </div>
  {%- else -%}
    <div class="hero__media" style="background: linear-gradient(135deg, #0a0a0a 0%, #1a1a1a 50%, #CC0001 100%)" aria-hidden="true"></div>
  {%- endif -%}

  <div class="hero__overlay" style="opacity: {{ overlay_opacity }};" aria-hidden="true"></div>

  <div class="hero__content {{ section.settings.content_alignment }}">
    <div>
      {%- if section.settings.eyebrow != blank -%}
        <p class="hero__eyebrow fade-up">{{ section.settings.eyebrow }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h1 class="hero__title fade-up">{{ section.settings.heading }}</h1>
      {%- endif -%}

      {%- if section.settings.subheading != blank -%}
        <p class="hero__subtitle fade-up">{{ section.settings.subheading }}</p>
      {%- endif -%}

      {%- if section.settings.button_label != blank or section.settings.button_2_label != blank -%}
        <div class="hero__ctas fade-up">
          {%- if section.settings.button_label != blank -%}
            <a
              class="btn btn--{{ section.settings.button_style }} btn--lg"
              href="{{ section.settings.button_link | default: '#' }}"
            >
              {{ section.settings.button_label }}
            </a>
          {%- endif -%}
          {%- if section.settings.button_2_label != blank -%}
            <a
              class="btn btn--{{ section.settings.button_2_style }} btn--lg"
              href="{{ section.settings.button_2_link | default: '#' }}"
            >
              {{ section.settings.button_2_label }}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>

  {%- if section.settings.show_scroll_indicator -%}
    <div class="hero__scroll-indicator" aria-hidden="true" style="position:absolute;bottom:2rem;left:50%;transform:translateX(-50%);display:flex;flex-direction:column;align-items:center;gap:0.5rem;color:rgba(255,255,255,0.6);font-size:0.7rem;font-weight:600;letter-spacing:0.2em;text-transform:uppercase">
      <svg width="20" height="28" viewBox="0 0 20 28" fill="none">
        <rect x="1" y="1" width="18" height="26" rx="9" stroke="currentColor" stroke-width="1.5"/>
        <path d="M10 6v6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      </svg>
      Scroll
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Hero",
  "tag": "section",
  "class": "hero-section",
  "settings": [
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "text",
      "id": "video_url",
      "label": "Background video URL (.mp4)",
      "info": "Overrides image if set"
    },
    {
      "type": "select",
      "id": "preload_video",
      "label": "Video preload",
      "options": [
        { "value": "none", "label": "None" },
        { "value": "metadata", "label": "Metadata only" },
        { "value": "auto", "label": "Full preload" }
      ],
      "default": "metadata"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "New Season"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Play Without\nLimits"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Premium football gear engineered for the elite. Find your edge."
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button 1 label",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button 1 link"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button 1 style",
      "options": [
        { "value": "primary", "label": "Black" },
        { "value": "white", "label": "White" },
        { "value": "accent", "label": "Red" },
        { "value": "outline-white", "label": "White outline" }
      ],
      "default": "white"
    },
    {
      "type": "text",
      "id": "button_2_label",
      "label": "Button 2 label"
    },
    {
      "type": "url",
      "id": "button_2_link",
      "label": "Button 2 link"
    },
    {
      "type": "select",
      "id": "button_2_style",
      "label": "Button 2 style",
      "options": [
        { "value": "primary", "label": "Black" },
        { "value": "white", "label": "White" },
        { "value": "accent", "label": "Red" },
        { "value": "outline-white", "label": "White outline" }
      ],
      "default": "outline-white"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "height",
      "label": "Hero height",
      "options": [
        { "value": "full", "label": "Full screen" },
        { "value": "xl", "label": "Extra large (90vh)" },
        { "value": "lg", "label": "Large (80vh)" },
        { "value": "md", "label": "Medium (65vh)" }
      ],
      "default": "full"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Content alignment",
      "options": [
        { "value": "", "label": "Left (default)" },
        { "value": "hero__content--center", "label": "Center" },
        { "value": "hero__content--right", "label": "Right" }
      ],
      "default": ""
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "label": "Overlay opacity",
      "default": 40,
      "unit": "%"
    },
    {
      "type": "checkbox",
      "id": "show_scroll_indicator",
      "label": "Show scroll indicator",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Hero",
      "settings": {
        "heading": "Play Without\nLimits",
        "subheading": "Premium football gear engineered for the elite.",
        "button_label": "Shop Now",
        "button_2_label": "New Arrivals",
        "height": "full",
        "overlay_opacity": 40
      }
    }
  ]
}
{% endschema %}
