{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign first_3d_model = product.media | where: 'media_type', 'model' | first
  assign has_description = product.description | strip_html | strip | size
-%}

<script id="product-json" type="application/json">{{ product | json }}</script>

<section class="section section--flush" id="section-{{ section.id }}">
  <div class="container">

    {%- render 'breadcrumbs' -%}

    <div class="product-layout">

      <!-- Gallery -->
      <div class="product-gallery" id="product-gallery">
        <div class="product-gallery__main" id="gallery-main" role="img" aria-label="Product image">
          {%- if product.featured_image -%}
            <img
              class="product-gallery__main-img"
              id="gallery-main-img"
              src="{{ current_variant.featured_image.src | default: product.featured_image | image_url: width: 800 }}"
              srcset="
                {{ current_variant.featured_image.src | default: product.featured_image | image_url: width: 600 }} 600w,
                {{ current_variant.featured_image.src | default: product.featured_image | image_url: width: 900 }} 900w,
                {{ current_variant.featured_image.src | default: product.featured_image | image_url: width: 1200 }} 1200w
              "
              sizes="(max-width: 900px) 100vw, 50vw"
              alt="{{ current_variant.featured_image.alt | default: product.featured_image.alt | escape }}"
              loading="eager"
              fetchpriority="high"
              width="{{ product.featured_image.width }}"
              height="{{ product.featured_image.height }}"
            >
          {%- else -%}
            <div style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;background:var(--color-gray-100);color:var(--color-gray-300)">
              <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1">
                <rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/>
                <polyline points="21 15 16 10 5 21"/>
              </svg>
            </div>
          {%- endif -%}

          {%- if product.compare_at_price_max > product.price -%}
            <div class="product-gallery__badge">
              {%- assign savings = product.compare_at_price_max | minus: product.price | times: 100 | divided_by: product.compare_at_price_max -%}
              <span class="badge badge--sale">Save {{ savings }}%</span>
            </div>
          {%- endif -%}
        </div>

        {%- if product.media.size > 1 -%}
          <div class="product-gallery__thumbs" role="list" aria-label="Product images">
            {%- for media in product.media limit: 8 -%}
              <button
                class="product-gallery__thumb {% if forloop.first %}is-active{% endif %}"
                data-src="{{ media.preview_image | image_url: width: 900 }}"
                data-media-id="{{ media.id }}"
                aria-label="View image {{ forloop.index }}"
                role="listitem"
              >
                <img
                  class="product-gallery__thumb-img"
                  src="{{ media.preview_image | image_url: width: 150 }}"
                  alt="{{ media.alt | escape }}"
                  loading="lazy"
                  width="72"
                  height="72"
                >
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <!-- Mobile Gallery (swipeable, hidden on desktop) -->
      <div class="mobile-gallery" id="mobile-gallery" aria-label="Product images">
        <div class="mobile-gallery__track" id="mobile-gallery-track">
          {%- for media in product.media limit: 10 -%}
            <div class="mobile-gallery__slide">
              <img
                src="{{ media.preview_image | image_url: width: 800 }}"
                srcset="
                  {{ media.preview_image | image_url: width: 600 }} 600w,
                  {{ media.preview_image | image_url: width: 800 }} 800w
                "
                sizes="100vw"
                alt="{{ media.alt | escape | default: product.title }}"
                loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                draggable="false"
              >
            </div>
          {%- else -%}
            <div class="mobile-gallery__slide" style="background:var(--color-gray-100);display:flex;align-items:center;justify-content:center">
              <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="var(--color-gray-300)" stroke-width="1" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
            </div>
          {%- endfor -%}
        </div>
        <div class="mobile-gallery__dots" id="mobile-gallery-dots" aria-hidden="true"></div>
        {%- if product.media.size > 1 -%}
          <span class="mobile-gallery__counter" id="mobile-gallery-counter" aria-hidden="true">1 / {{ product.media.size }}</span>
        {%- endif -%}
        {%- if product.compare_at_price_max > product.price -%}
          {%- assign savings = product.compare_at_price_max | minus: product.price | times: 100 | divided_by: product.compare_at_price_max -%}
          <div style="position:absolute;top:14px;left:14px;z-index:2"><span class="badge badge--sale">Save {{ savings }}%</span></div>
        {%- endif -%}
      </div>

      <!-- Product Info -->
      <div class="product-info" id="product-info">

        <!-- Vendor & Category -->
        {%- if product.vendor != blank -%}
          <div class="product-info__brand">
            <a href="/collections/vendors?q={{ product.vendor | url_encode }}" style="color:inherit">{{ product.vendor }}</a>
            {%- if product.type != blank %} · {{ product.type }}{%- endif -%}
          </div>
        {%- endif -%}

        <!-- Title -->
        <h1 class="product-info__title">{{ product.title }}</h1>

        <!-- Rating (placeholder — replace with review app) -->
        {%- if section.settings.show_rating -%}
          <div class="product-rating" id="product-rating">
            <div class="stars" aria-label="4.8 out of 5 stars">
              {%- for i in (1..5) -%}
                <svg class="star" width="14" height="14" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 0 0 .95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 0 0-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 0 0-1.176 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 0 0-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 0 0 .951-.69l1.07-3.292Z"/>
                </svg>
              {%- endfor -%}
            </div>
            <span class="product-rating__count">4.8 ({{ product.metafields.reviews.rating_count | default: '124' }} reviews)</span>
          </div>
        {%- endif -%}

        <!-- Price -->
        <div class="product-price" id="product-price-wrap">
          <span class="product-price__current" id="product-price">
            {{ current_variant.price | money }}
          </span>
          {%- if current_variant.compare_at_price > current_variant.price -%}
            <span class="product-price__was" id="product-price-was">{{ current_variant.compare_at_price | money }}</span>
            {%- assign savings_pct = current_variant.compare_at_price | minus: current_variant.price | times: 100 | divided_by: current_variant.compare_at_price -%}
            <span class="product-price__save" id="product-price-save">{{ savings_pct }}% off</span>
          {%- else -%}
            <span id="product-price-was" style="display:none"></span>
            <span id="product-price-save" style="display:none"></span>
          {%- endif -%}
        </div>

        <!-- Form -->
        <form id="product-form" action="{{ routes.cart_add_url }}" method="post" enctype="multipart/form-data" novalidate>
          <input type="hidden" name="form_type" value="product">
          <input type="hidden" name="utf8" value="✓">
          <input type="hidden" id="variant-id" name="id" value="{{ current_variant.id }}">

          {%- unless product.has_only_default_variant -%}
            <div class="product-variants">
              {%- for option in product.options_with_values -%}
                {%- liquid
                  assign is_color = false
                  if option.name == 'Colour' or option.name == 'Color'
                    assign is_color = true
                  endif
                -%}
                <div class="product-variant-group" style="margin-bottom:1.5rem">
                  <div class="variant-label">
                    <span class="variant-label__name">{{ option.name }}</span>
                    <span class="variant-label__selected" id="variant-selected-{{ forloop.index0 }}">{{ option.selected_value }}</span>
                    {%- if option.name == 'Size' or option.name == 'UK Size' -%}
                      <button type="button" class="size-guide-link" onclick="document.getElementById('size-guide-modal')?.classList.toggle('is-open')">
                        Size Guide
                      </button>
                    {%- endif -%}
                  </div>

                  <div class="variant-options">
                    {%- for value in option.values -%}
                      {%- assign is_available = false -%}
                      {%- for variant in product.variants -%}
                        {%- if variant.options contains value and variant.available -%}
                          {%- assign is_available = true -%}
                        {%- endif -%}
                      {%- endfor -%}

                      {%- if is_color -%}
                        <button
                          type="button"
                          class="color-variant-btn{% if option.selected_value == value %} is-active{% endif %}"
                          data-option-index="{{ forloop.parentloop.index0 }}"
                          data-value="{{ value }}"
                          title="{{ value }}"
                          aria-label="{{ value }}{% unless is_available %} (out of stock){% endunless %}"
                          style="background-color: {{ value | downcase | replace: ' ', '' }}; {% unless is_available %}opacity: 0.3;{% endunless %}"
                        ></button>
                      {%- else -%}
                        <button
                          type="button"
                          class="variant-btn{% if option.selected_value == value %} is-active{% endif %}{% unless is_available %} is-unavailable{% endunless %}"
                          data-option-index="{{ forloop.parentloop.index0 }}"
                          data-value="{{ value }}"
                          aria-pressed="{% if option.selected_value == value %}true{% else %}false{% endif %}"
                          {% unless is_available %}aria-label="{{ value }} - out of stock"{% endunless %}
                        >
                          {{ value }}
                        </button>
                      {%- endif -%}
                    {%- endfor -%}
                  </div>
                </div>
              {%- endfor -%}
            </div>
          {%- endunless -%}

          <!-- Quantity -->
          {%- if section.settings.show_quantity -%}
            <div style="margin-bottom:1.5rem">
              <div class="variant-label" style="margin-bottom:0.75rem">
                <span class="variant-label__name">Quantity</span>
              </div>
              <div class="quantity-selector">
                <button type="button" class="quantity-selector__btn" data-action="decrease" aria-label="Decrease quantity">−</button>
                <input
                  class="quantity-selector__input"
                  type="number"
                  name="quantity"
                  id="quantity"
                  min="1"
                  max="{{ current_variant.inventory_quantity | default: 99 }}"
                  value="1"
                  aria-label="Quantity"
                >
                <button type="button" class="quantity-selector__btn" data-action="increase" aria-label="Increase quantity">+</button>
              </div>
            </div>
          {%- endif -%}

          <!-- ATC + Wishlist -->
          <div class="product-atc">
            <div class="product-atc__row">
              <button
                type="submit"
                id="atc-btn"
                class="btn btn--atc product-atc__main"
                {% unless current_variant.available %}disabled{% endunless %}
                aria-label="Add {{ product.title }} to bag"
              >
                {%- if current_variant.available -%}
                  Add to Bag
                {%- else -%}
                  Sold Out
                {%- endif -%}
              </button>

              <button
                type="button"
                class="product-wishlist-btn"
                aria-label="Save to wishlist"
                title="Save to wishlist"
              >
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
                </svg>
              </button>
            </div>

            <button
              type="button"
              class="btn btn--outline btn--full"
              id="buy-now-btn"
              {% unless current_variant.available %}disabled{% endunless %}
            >
              Buy It Now
            </button>
          </div>

          <!-- Availability -->
          <p id="product-availability" style="font-size:0.8rem;margin-top:-0.5rem;margin-bottom:1rem;{% if current_variant.available %}color:#16a34a{% else %}color:var(--color-text-muted){% endif %}">
            {%- if current_variant.available -%}
              ✓ In Stock
              {%- if current_variant.inventory_quantity > 0 and current_variant.inventory_quantity <= 5 -%}
                — Only {{ current_variant.inventory_quantity }} left
              {%- endif -%}
            {%- else -%}
              Out of Stock
            {%- endif -%}
          </p>

        </form>

        <!-- Trust Badges -->
        <div class="trust-badges">
          {%- for block in section.blocks -%}
            {%- if block.type == 'trust_badge' -%}
              <div class="trust-badge" {{ block.shopify_attributes }}>
                <svg class="trust-badge__icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                  {%- case block.settings.icon -%}
                    {%- when 'shipping' -%}
                      <path d="M1 3h15v13H1zM16 8h4l3 3v5h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/>
                    {%- when 'returns' -%}
                      <polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 .49-4.16"/>
                    {%- when 'secure' -%}
                      <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                    {%- when 'authentic' -%}
                      <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                    {%- when 'support' -%}
                      <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.6 14.09 19.79 19.79 0 0 1 1.52 5.5 2 2 0 0 1 3.49 3.28h3a2 2 0 0 1 2 1.72c.13.9.35 1.79.68 2.65a2 2 0 0 1-.45 2.11L7.91 10.9a16 16 0 0 0 6.09 6.09l1.42-1.42a2 2 0 0 1 2.11-.45c.86.33 1.75.55 2.65.68A2 2 0 0 1 22 16.92z"/>
                    {%- else -%}
                      <polyline points="20 6 9 17 4 12"/>
                  {%- endcase -%}
                </svg>
                <div class="trust-badge__text">
                  <strong>{{ block.settings.heading }}</strong>
                  {%- if block.settings.text != blank -%} — {{ block.settings.text }}{%- endif -%}
                </div>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>

        <!-- Accordion Tabs -->
        <div class="product-accordion">
          {%- if has_description > 0 -%}
            <div class="accordion-item">
              <button class="accordion-trigger" aria-expanded="false" type="button">
                Description
                <svg class="accordion-icon" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                  <path d="M7 1v12M1 7h12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                </svg>
              </button>
              <div class="accordion-content">
                <div class="accordion-content__inner rte">
                  {{ product.description }}
                </div>
              </div>
            </div>
          {%- endif -%}

          {%- for block in section.blocks -%}
            {%- if block.type == 'accordion' -%}
              <div class="accordion-item" {{ block.shopify_attributes }}>
                <button class="accordion-trigger" aria-expanded="false" type="button">
                  {{ block.settings.heading }}
                  <svg class="accordion-icon" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                    <path d="M7 1v12M1 7h12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                  </svg>
                </button>
                <div class="accordion-content">
                  <div class="accordion-content__inner rte">{{ block.settings.content }}</div>
                </div>
              </div>
            {%- endif -%}
          {%- endfor -%}

          <!-- Size Guide (always shown for applicable products) -->
          {%- if section.settings.show_size_guide -%}
            <div class="accordion-item">
              <button class="accordion-trigger" aria-expanded="false" type="button">
                Size Guide
                <svg class="accordion-icon" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                  <path d="M7 1v12M1 7h12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                </svg>
              </button>
              <div class="accordion-content">
                <div class="accordion-content__inner">
                  <table style="width:100%;border-collapse:collapse;font-size:0.8rem">
                    <thead>
                      <tr style="border-bottom:1px solid var(--color-border)">
                        <th style="text-align:left;padding:0.5rem;font-weight:600">UK</th>
                        <th style="text-align:left;padding:0.5rem;font-weight:600">EU</th>
                        <th style="text-align:left;padding:0.5rem;font-weight:600">US</th>
                        <th style="text-align:left;padding:0.5rem;font-weight:600">Chest (in)</th>
                      </tr>
                    </thead>
                    <tbody>
                      {%- assign sizes = 'XS,S,M,L,XL,XXL' | split: ',' -%}
                      {%- assign eu_sizes = '32-34,34-36,36-38,38-40,40-42,42-44' | split: ',' -%}
                      {%- for size in sizes -%}
                        <tr style="border-bottom:1px solid var(--color-border)">
                          <td style="padding:0.5rem">{{ size }}</td>
                          <td style="padding:0.5rem">{{ eu_sizes[forloop.index0] }}</td>
                          <td style="padding:0.5rem">{{ size }}</td>
                          <td style="padding:0.5rem">{{ 32 | plus: forloop.index0 | times: 2 }}-{{ 34 | plus: forloop.index0 | times: 2 }}</td>
                        </tr>
                      {%- endfor -%}
                    </tbody>
                  </table>
                </div>
              </div>
            </div>
          {%- endif -%}

          <div class="accordion-item">
            <button class="accordion-trigger" aria-expanded="false" type="button">
              Delivery & Returns
              <svg class="accordion-icon" width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                <path d="M7 1v12M1 7h12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
              </svg>
            </button>
            <div class="accordion-content">
              <div class="accordion-content__inner">
                <ul>
                  <li>Free delivery on orders over £{{ section.settings.free_shipping_threshold | default: 100 }}</li>
                  <li>Express delivery: 1-2 business days</li>
                  <li>Standard delivery: 3-5 business days</li>
                  <li>Free 30-day returns on all items</li>
                  <li>Items must be unworn with original tags attached</li>
                </ul>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>

  </div>
</section>

<!-- Sticky ATC (Mobile) -->
<div class="sticky-atc" id="sticky-atc" aria-hidden="true">
  <div class="sticky-atc__info">
    <div class="sticky-atc__title">{{ product.title | truncate: 35 }}</div>
    <div class="sticky-atc__price" id="sticky-atc-price">{{ current_variant.price | money }}</div>
  </div>
  <button class="btn btn--accent sticky-atc__btn" id="sticky-atc-btn" {% unless current_variant.available %}disabled{% endunless %}>
    {%- if current_variant.available -%}Add to Bag{%- else -%}Sold Out{%- endif -%}
  </button>
</div>

{% schema %}
{
  "name": "Product Information",
  "tag": "section",
  "class": "product-information-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show star rating",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_quantity",
      "label": "Show quantity selector",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_buy_now",
      "label": "Show Buy Now button",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_size_guide",
      "label": "Show size guide accordion",
      "default": true
    },
    {
      "type": "number",
      "id": "free_shipping_threshold",
      "label": "Free shipping threshold (£)",
      "default": 100
    }
  ],
  "blocks": [
    {
      "type": "trust_badge",
      "name": "Trust badge",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Free Shipping"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Description",
          "default": "On orders over £100"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "shipping", "label": "Shipping" },
            { "value": "returns", "label": "Returns" },
            { "value": "secure", "label": "Secure payment" },
            { "value": "authentic", "label": "Authentic" },
            { "value": "support", "label": "Support" },
            { "value": "check", "label": "Checkmark" }
          ],
          "default": "check"
        }
      ]
    },
    {
      "type": "accordion",
      "name": "Info tab",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Tab heading",
          "default": "Product Details"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Tab content"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Information",
      "blocks": [
        {
          "type": "trust_badge",
          "settings": { "heading": "Free Shipping", "text": "On orders over £100", "icon": "shipping" }
        },
        {
          "type": "trust_badge",
          "settings": { "heading": "Free Returns", "text": "30-day hassle-free returns", "icon": "returns" }
        },
        {
          "type": "trust_badge",
          "settings": { "heading": "Secure Payment", "text": "Encrypted checkout", "icon": "secure" }
        },
        {
          "type": "trust_badge",
          "settings": { "heading": "100% Authentic", "text": "Official licensed products", "icon": "authentic" }
        }
      ]
    }
  ]
}
{% endschema %}
