<div
  class="section"
  id="section-{{ section.id }}"
  data-product-recommendations
  data-product-id="{{ product.id }}"
  data-url="{{ routes.product_recommendations_url }}?product_id={{ product.id }}&limit={{ section.settings.limit | default: 4 }}&section_id={{ section.id }}"
  style="background:var(--color-gray-50)"
>
  <div class="container" id="recommendations-inner">
    <!-- Populated by JS -->
  </div>
</div>

<script>
  (function() {
    const el = document.querySelector('[data-product-recommendations]');
    if (!el) return;
    const url = el.dataset.url;
    fetch(url)
      .then(res => res.text())
      .then(html => {
        const parser = new DOMParser();
        const doc = parser.parseFromString(html, 'text/html');
        const inner = doc.querySelector('#recommendations-inner');
        if (inner && inner.innerHTML.trim()) {
          document.getElementById('recommendations-inner').innerHTML = inner.innerHTML;
          document.querySelectorAll('#recommendations-inner .fade-up, #recommendations-inner .scale-in').forEach(el => {
            new IntersectionObserver(([e]) => { if (e.isIntersecting) { el.classList.add('is-visible'); } }, { threshold: 0.1 }).observe(el);
          });
        } else {
          el.remove();
        }
      })
      .catch(() => el.remove());
  })();
</script>

{% schema %}
{
  "name": "Product Recommendations",
  "tag": "section",
  "class": "product-recommendations-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "You May Also Like" },
    { "type": "range", "id": "limit", "label": "Number of products", "min": 2, "max": 6, "step": 1, "default": 4 },
    { "type": "select", "id": "products_per_row", "label": "Products per row", "options": [{ "value": "2", "label": "2" },{ "value": "3", "label": "3" },{ "value": "4", "label": "4" }], "default": "4" }
  ],
  "presets": [{ "name": "Product Recommendations" }]
}
{% endschema %}

{%- comment -%}This template is fetched via AJAX and rendered into the page{%- endcomment -%}
{%- if recommendations.performed and recommendations.products_count > 0 -%}
  <div class="section-header" style="margin-bottom:2rem">
    <h2 class="section-header__title" style="font-size:clamp(1.5rem,3vw,2.5rem)">{{ section.settings.heading }}</h2>
  </div>
  <div class="grid grid--{{ section.settings.products_per_row }}">
    {%- for product in recommendations.products -%}
      {%- render 'product-card', product: product -%}
    {%- endfor -%}
  </div>
{%- endif -%}
