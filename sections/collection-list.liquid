{%- liquid
  assign collections = section.settings.collection_list
-%}

<section class="section" id="section-{{ section.id }}" style="{% if section.settings.bg_dark %}background:var(--color-gray-900);{% endif %}">
  <div class="container">
    <div class="section-header{% if section.settings.centered_header %} section-header--centered{% endif %}">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <p class="section-header__eyebrow fade-up">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        <h2 class="section-header__title fade-up" style="{% if section.settings.bg_dark %}color:#fff{% endif %}">
          {{ section.settings.heading | default: 'Shop by Category' }}
        </h2>
      </div>
    </div>

    <div class="grid grid--{{ section.settings.columns | default: 3 }}">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'collection' -%}
            {%- assign col = block.settings.collection -%}
            <a
              class="collection-card scale-in"
              href="{{ col.url | default: '#' }}"
              style="aspect-ratio:{{ section.settings.aspect_ratio | default: '3/4' }}"
              {{ block.shopify_attributes }}
              aria-label="{{ block.settings.label | default: col.title }}"
            >
              {%- if block.settings.image != blank -%}
                <img
                  class="collection-card__img"
                  src="{{ block.settings.image | image_url: width: 800 }}"
                  srcset="{{ block.settings.image | image_url: width: 600 }} 600w, {{ block.settings.image | image_url: width: 900 }} 900w"
                  sizes="(max-width:768px) 100vw, 33vw"
                  alt="{{ block.settings.label | default: col.title | escape }}"
                  loading="lazy"
                  width="{{ block.settings.image.width }}"
                  height="{{ block.settings.image.height }}"
                >
              {%- elsif col != blank and col.image != blank -%}
                <img
                  class="collection-card__img"
                  src="{{ col.image | image_url: width: 800 }}"
                  alt="{{ col.title | escape }}"
                  loading="lazy"
                  width="{{ col.image.width }}"
                  height="{{ col.image.height }}"
                >
              {%- else -%}
                <div style="width:100%;height:100%;background:linear-gradient(135deg,#1a1a1a,#2d2d2d)"></div>
              {%- endif -%}
              <div class="collection-card__overlay" aria-hidden="true"></div>
              <div class="collection-card__content">
                <h3 class="collection-card__title">{{ block.settings.label | default: col.title }}</h3>
                {%- if block.settings.cta_text != blank -%}
                  <span class="collection-card__cta">{{ block.settings.cta_text }}</span>
                {%- else -%}
                  <span class="collection-card__cta">Shop Now</span>
                {%- endif -%}
              </div>
            </a>
          {%- endif -%}
        {%- endfor -%}
      {%- elsif collections != blank -%}
        {%- for col in collections -%}
          <a class="collection-card scale-in" href="{{ col.url }}" style="aspect-ratio:3/4" aria-label="{{ col.title }}">
            {%- if col.image != blank -%}
              <img class="collection-card__img" src="{{ col.image | image_url: width: 800 }}" alt="{{ col.title | escape }}" loading="lazy" width="{{ col.image.width }}" height="{{ col.image.height }}">
            {%- else -%}
              <div style="width:100%;height:100%;background:linear-gradient(135deg,#1a1a1a,#2d2d2d)"></div>
            {%- endif -%}
            <div class="collection-card__overlay" aria-hidden="true"></div>
            <div class="collection-card__content">
              <h3 class="collection-card__title">{{ col.title }}</h3>
              <span class="collection-card__cta">Shop Now</span>
            </div>
          </a>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collection Grid",
  "tag": "section",
  "class": "collection-grid-section",
  "settings": [
    { "type": "collection_list", "id": "collection_list", "label": "Collections" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Browse" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by Category" },
    { "type": "checkbox", "id": "centered_header", "label": "Center header", "default": true },
    { "type": "select", "id": "columns", "label": "Columns", "options": [{ "value": "2", "label": "2" },{ "value": "3", "label": "3" },{ "value": "4", "label": "4" }], "default": "3" },
    { "type": "select", "id": "aspect_ratio", "label": "Card ratio", "options": [{ "value": "1/1", "label": "Square" },{ "value": "3/4", "label": "Portrait" },{ "value": "4/3", "label": "Landscape" }], "default": "3/4" },
    { "type": "checkbox", "id": "bg_dark", "label": "Dark background", "default": false }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection card",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "image_picker", "id": "image", "label": "Override image" },
        { "type": "text", "id": "label", "label": "Override label" },
        { "type": "text", "id": "cta_text", "label": "CTA text", "default": "Shop Now" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection Grid",
      "settings": {
        "eyebrow": "Browse",
        "heading": "Shop by Category",
        "columns": "3"
      },
      "blocks": [
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" }
      ]
    }
  ]
}
{% endschema %}
