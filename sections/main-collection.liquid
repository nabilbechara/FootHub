{%- paginate collection.products by section.settings.products_per_page -%}

<section id="section-{{ section.id }}">
  <div class="collection-hero">
    {%- if collection.image -%}
      <img class="collection-hero__img" src="{{ collection.image | image_url: width: 1600 }}"
        srcset="{{ collection.image | image_url: width: 800 }} 800w, {{ collection.image | image_url: width: 1200 }} 1200w, {{ collection.image | image_url: width: 1600 }} 1600w"
        sizes="100vw" alt="{{ collection.image.alt | escape | default: collection.title }}"
        loading="eager" fetchpriority="high" width="{{ collection.image.width }}" height="{{ collection.image.height }}">
    {%- else -%}
      <div style="width:100%;height:100%;background:linear-gradient(135deg,#0a0a0a,#1a1a1a)"></div>
    {%- endif -%}
    <div class="collection-hero__content">
      <h1 class="collection-hero__title">{{ collection.title }}</h1>
      {%- if collection.description != blank -%}
        <p class="collection-hero__desc">{{ collection.description | strip_html | truncatewords: 30 }}</p>
      {%- endif -%}
    </div>
  </div>

  <div class="container section--sm">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <span class="breadcrumb__item"><a class="breadcrumb__link" href="{{ routes.root_url }}">Home</a><span class="breadcrumb__sep" aria-hidden="true">/</span></span>
      <span class="breadcrumb__item"><span class="breadcrumb__current">{{ collection.title }}</span></span>
    </nav>

    <div class="collection-toolbar">
      <p class="collection-toolbar__count">{{ collection.products_count }} {{ collection.products_count | pluralize: 'product', 'products' }}</p>
      <div class="collection-toolbar__right">
        {%- if section.settings.show_filters -%}
          <button class="filter-btn" id="filter-toggle" aria-expanded="false" aria-controls="filters-sidebar">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M1 2h12M3 7h8M5 12h4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
            Filter
          </button>
        {%- endif -%}
        {%- if section.settings.show_sort -%}
          <label for="sort-select" class="visually-hidden">Sort by</label>
          <select class="sort-select" id="sort-select" aria-label="Sort products">
            {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
            {%- for option in collection.sort_options -%}
              <option value="{{ option.value }}"{% if option.value == sort_by %} selected{% endif %}>{{ option.name }}</option>
            {%- endfor -%}
          </select>
        {%- endif -%}
      </div>
    </div>

    <div class="collection-layout" id="collection-layout">
      {%- if section.settings.show_filters -%}
        <aside class="filters-sidebar" id="filters-sidebar" aria-label="Product filters">
          {%- for filter in collection.filters -%}
            <div class="filter-group">
              <div class="filter-group__header">
                <span class="filter-group__name">{{ filter.label }}</span>
                <svg width="10" height="6" viewBox="0 0 10 6" fill="none" aria-hidden="true"><path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
              </div>
              <div class="filter-options">
                {%- for fv in filter.values -%}
                  <label class="filter-option">
                    <a href="{{ fv.url_to_add }}" class="filter-checkbox{% if fv.active %} is-checked{% endif %}" role="checkbox" aria-checked="{{ fv.active }}" aria-label="{{ fv.label }} ({{ fv.count }})">
                      {%- if fv.active -%}<svg width="10" height="8" viewBox="0 0 10 8" fill="none" aria-hidden="true"><path d="M1 4L4 7L9 1" stroke="white" stroke-width="1.5" stroke-linecap="round"/></svg>{%- endif -%}
                    </a>
                    <span>{{ fv.label }} <span style="color:var(--color-text-muted)">({{ fv.count }})</span></span>
                  </label>
                {%- endfor -%}
              </div>
            </div>
          {%- endfor -%}
          {%- if collection.filters.size > 0 -%}
            <a href="{{ collection.url }}" class="btn btn--outline btn--sm" style="margin-top:1rem;width:100%">Clear All Filters</a>
          {%- endif -%}
        </aside>
      {%- endif -%}

      <div>
        {%- if collection.products.size == 0 -%}
          <div style="text-align:center;padding:4rem 1rem">
            <p style="font-size:1.125rem;font-weight:600;margin-bottom:0.75rem">No products found</p>
            <p style="color:var(--color-text-muted);margin-bottom:1.5rem">Try adjusting your filters.</p>
            <a class="btn btn--primary" href="{{ collection.url }}">Clear Filters</a>
          </div>
        {%- else -%}
          <div class="grid grid--{{ section.settings.products_per_row }}" id="products-grid">
            {%- for product in collection.products -%}
              {%- render 'product-card', product: product -%}
            {%- endfor -%}
          </div>
          {%- if paginate.pages > 1 -%}
            <nav class="pagination" aria-label="Pagination">
              {%- if paginate.previous -%}<a class="page-btn page-btn--prev" href="{{ paginate.previous.url }}">← Prev</a>{%- endif -%}
              {%- for part in paginate.parts -%}
                {%- if part.is_link -%}
                  <a class="page-btn" href="{{ part.url }}">{{ part.title }}</a>
                {%- elsif part.title == paginate.current_page -%}
                  <span class="page-btn is-active" aria-current="page">{{ part.title }}</span>
                {%- else -%}
                  <span class="page-btn" style="opacity:0.4;cursor:default">{{ part.title }}</span>
                {%- endif -%}
              {%- endfor -%}
              {%- if paginate.next -%}<a class="page-btn page-btn--next" href="{{ paginate.next.url }}">Next →</a>{%- endif -%}
            </nav>
          {%- endif -%}
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

<script>
  document.getElementById('sort-select')?.addEventListener('change', e => {
    const url = new URL(window.location.href);
    url.searchParams.set('sort_by', e.target.value);
    window.location.href = url.toString();
  });
  const filterToggle = document.getElementById('filter-toggle');
  const filtersSidebar = document.getElementById('filters-sidebar');
  filterToggle?.addEventListener('click', () => {
    const expanded = filterToggle.getAttribute('aria-expanded') === 'true';
    filterToggle.setAttribute('aria-expanded', String(!expanded));
    filtersSidebar?.classList.toggle('is-open', !expanded);
  });
</script>

{%- endpaginate -%}

{% schema %}
{
  "name": "Collection",
  "tag": "section",
  "class": "collection-section",
  "settings": [
    { "type": "range", "id": "products_per_page", "label": "Products per page", "min": 8, "max": 48, "step": 4, "default": 24 },
    { "type": "select", "id": "products_per_row", "label": "Products per row", "options": [{ "value": "2", "label": "2" },{ "value": "3", "label": "3" },{ "value": "4", "label": "4" }], "default": "4" },
    { "type": "checkbox", "id": "show_filters", "label": "Show filters", "default": true },
    { "type": "checkbox", "id": "show_sort", "label": "Show sort", "default": true }
  ],
  "presets": [{ "name": "Collection" }]
}
{% endschema %}
