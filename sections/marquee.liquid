<div class="marquee" aria-hidden="true" style="{% if section.settings.bg_color != blank %}background:{{ section.settings.bg_color }};{% endif %}{% if section.settings.text_color != blank %}color:{{ section.settings.text_color }};{% endif %}">
  <div class="marquee__track">
    {%- for i in (1..2) -%}
      {%- for block in section.blocks -%}
        <span class="marquee__item">
          {%- if block.settings.icon != blank -%}
            <span aria-hidden="true">{{ block.settings.icon }}</span>
          {%- else -%}
            <span class="marquee__sep">✦</span>
          {%- endif -%}
          {{ block.settings.text }}
        </span>
      {%- endfor -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Marquee / Ticker",
  "tag": "section",
  "class": "marquee-section",
  "blocks": [
    {
      "type": "item",
      "name": "Ticker item",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Free shipping on orders over £100"
        },
        {
          "type": "text",
          "id": "icon",
          "label": "Icon (emoji or symbol)",
          "default": "✦"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background colour"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text colour"
    }
  ],
  "presets": [
    {
      "name": "Marquee",
      "blocks": [
        { "type": "item", "settings": { "text": "Free shipping on orders over £100" } },
        { "type": "item", "settings": { "text": "Authentic licensed gear" } },
        { "type": "item", "settings": { "text": "30-day free returns" } },
        { "type": "item", "settings": { "text": "New arrivals every week" } },
        { "type": "item", "settings": { "text": "Official club jerseys" } }
      ]
    }
  ]
}
{% endschema %}
