<section class="about-hero">
  <div class="about-hero__inner">
    <p class="section-header__eyebrow fade-up">Est. 2024</p>
    <h1 class="about-hero__title fade-up">Built for the<br>Beautiful Game.</h1>
    <p class="about-hero__lead fade-up">
      FootHub exists for one reason — to give every footballer on the planet access to the same elite gear worn by professionals. Authentic kits, premium boots, match-day essentials. All in one place.
    </p>
  </div>
</section>

<section class="about-stats">
  <div class="container">
    <div class="about-stats__grid">
      <div class="about-stats__item fade-up">
        <span class="about-stats__number">10,000<span class="about-stats__plus">+</span></span>
        <span class="about-stats__label">Orders Shipped</span>
      </div>
      <div class="about-stats__item fade-up">
        <span class="about-stats__number">500<span class="about-stats__plus">+</span></span>
        <span class="about-stats__label">Products Available</span>
      </div>
      <div class="about-stats__item fade-up">
        <span class="about-stats__number">4.9<span class="about-stats__plus">★</span></span>
        <span class="about-stats__label">Average Rating</span>
      </div>
      <div class="about-stats__item fade-up">
        <span class="about-stats__number">48<span class="about-stats__plus">h</span></span>
        <span class="about-stats__label">Express Delivery</span>
      </div>
    </div>
  </div>
</section>

<section class="section" style="background: var(--color-gray-50);">
  <div class="container">
    <div class="about-story">
      <div class="about-story__content fade-up">
        <p class="section-header__eyebrow">Our Story</p>
        <h2 class="about-story__title">We started on a football pitch.</h2>
        <div class="about-story__body">
          <p>
            FootHub was born from a simple frustration — finding authentic, high-quality football gear without paying inflated high-street prices or waiting weeks for delivery was unnecessarily hard. We knew players deserved better.
          </p>
          <p>
            So we built it. A single destination for every footballer, from the Sunday league striker to the academy prospect chasing their dream. Every product on FootHub is genuine, every price is honest, and every order ships fast.
          </p>
          <p>
            We work directly with official licensees and distributors so you get the real thing, every time — no knockoffs, no compromises.
          </p>
        </div>
      </div>
      {%- if section.settings.story_image != blank -%}
        <div class="about-story__media scale-in">
          <img
            src="{{ section.settings.story_image | image_url: width: 800 }}"
            alt="{{ section.settings.story_image.alt | escape | default: 'FootHub story' }}"
            loading="lazy"
            width="{{ section.settings.story_image.width }}"
            height="{{ section.settings.story_image.height }}"
          >
        </div>
      {%- else -%}
        <div class="about-story__media scale-in" style="background:var(--color-gray-200);display:flex;align-items:center;justify-content:center;aspect-ratio:4/5">
          <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="var(--color-gray-400)" stroke-width="1" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="about-values__header fade-up">
      <p class="section-header__eyebrow">What we stand for</p>
      <h2 class="section-header__title">The FootHub Standard</h2>
    </div>
    <div class="about-values__grid">
      <div class="about-value fade-up">
        <div class="about-value__icon">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
          </svg>
        </div>
        <h3 class="about-value__title">100% Authentic</h3>
        <p class="about-value__text">Every product is officially licensed and sourced directly from authorised distributors. No fakes. No exceptions. Your trust matters more than a quick sale.</p>
      </div>
      <div class="about-value fade-up">
        <div class="about-value__icon">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
            <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
          </svg>
        </div>
        <h3 class="about-value__title">Fast Delivery</h3>
        <p class="about-value__text">Match day can't wait. We dispatch orders fast, with express options available nationwide. Most orders arrive within 48 hours so you're geared up when it counts.</p>
      </div>
      <div class="about-value fade-up">
        <div class="about-value__icon">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
            <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/>
          </svg>
        </div>
        <h3 class="about-value__title">Honest Pricing</h3>
        <p class="about-value__text">Elite gear at prices that respect your budget. We cut out the middlemen so you get more for your money — without ever compromising on quality or authenticity.</p>
      </div>
      <div class="about-value fade-up">
        <div class="about-value__icon">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
          </svg>
        </div>
        <h3 class="about-value__title">Real Support</h3>
        <p class="about-value__text">Questions about sizing? Need help with your order? Our team actually knows football — we're players and fans ourselves, not just a support ticket queue.</p>
      </div>
    </div>
  </div>
</section>

<section class="about-cta">
  <div class="about-cta__inner">
    <p class="section-header__eyebrow" style="color:rgba(255,255,255,0.6)">Ready?</p>
    <h2 class="about-cta__title fade-up">Find Your Edge.</h2>
    <p class="about-cta__sub fade-up">Explore our full range of boots, jerseys, and training gear.</p>
    <div class="about-cta__btns fade-up">
      <a class="btn btn--white btn--lg" href="/collections/all-shoes">Shop Boots</a>
      <a class="btn btn--outline-white btn--lg" href="/collections/football-jerseys">Shop Jerseys</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "About Us",
  "settings": [
    {
      "type": "image_picker",
      "id": "story_image",
      "label": "Story section image"
    }
  ],
  "presets": [
    { "name": "About Us" }
  ]
}
{% endschema %}
