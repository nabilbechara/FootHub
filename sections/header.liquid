{%- liquid
  assign main_menu = section.settings.menu | default: 'main-menu'
  assign logo = section.settings.logo | default: settings.logo
  assign sale_keywords = 'sale,Sale,SALE,outlet,Outlet'
  assign new_keywords = 'new,New,NEW,new in,New In,NEW IN,new arrivals,New Arrivals'
-%}

<header class="site-header" id="site-header" role="banner">
  <div class="site-header__inner">

    <!-- Nav (Left) -->
    <nav class="site-header__nav" aria-label="Main navigation">
      <ul class="site-header__nav-list" role="list">

        <li class="site-header__nav-item">
          <a class="site-header__nav-link" href="/collections/all-shoes">Football Boots</a>
        </li>

        <li class="site-header__nav-item">
          <button class="site-header__nav-link" aria-expanded="false" aria-haspopup="true">
            Nike
            <svg width="10" height="6" viewBox="0 0 10 6" fill="none" aria-hidden="true">
              <path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
          </button>
          <div class="mega-menu" role="menu" aria-label="Nike submenu">
            <div class="mega-menu__inner">
              <div class="mega-menu__col">
                <p class="mega-menu__heading">Nike Boots</p>
                <ul class="mega-menu__list" role="list">
                  <li><a class="mega-menu__link" href="/collections/nike" role="menuitem">All Nike</a></li>
                  <li><a class="mega-menu__link" href="/collections/nike-mercurial" role="menuitem">Mercurial</a></li>
                  <li><a class="mega-menu__link" href="/collections/nike-phantom" role="menuitem">Phantom</a></li>
                  <li><a class="mega-menu__link mega-menu__link--accent" href="/collections/nike" role="menuitem">View All →</a></li>
                </ul>
              </div>
            </div>
          </div>
        </li>

        <li class="site-header__nav-item">
          <button class="site-header__nav-link" aria-expanded="false" aria-haspopup="true">
            Adidas
            <svg width="10" height="6" viewBox="0 0 10 6" fill="none" aria-hidden="true">
              <path d="M1 1L5 5L9 1" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
          </button>
          <div class="mega-menu" role="menu" aria-label="Adidas submenu">
            <div class="mega-menu__inner">
              <div class="mega-menu__col">
                <p class="mega-menu__heading">Adidas Boots</p>
                <ul class="mega-menu__list" role="list">
                  <li><a class="mega-menu__link" href="/collections/adidas" role="menuitem">All Adidas</a></li>
                  <li><a class="mega-menu__link" href="/collections/adidas-predator" role="menuitem">Predator</a></li>
                  <li><a class="mega-menu__link" href="/collections/adidas-x" role="menuitem">X Crazyfast</a></li>
                  <li><a class="mega-menu__link mega-menu__link--accent" href="/collections/adidas" role="menuitem">View All →</a></li>
                </ul>
              </div>
            </div>
          </div>
        </li>

        <li class="site-header__nav-item">
          <a class="site-header__nav-link" href="/collections/football-jerseys">Jerseys</a>
        </li>

        <li class="site-header__nav-item">
          <a class="site-header__nav-link" href="/collections/football-equipment">Equipment</a>
        </li>

      </ul>
    </nav>

    <!-- Logo (Center) -->
    <a class="site-header__logo" href="{{ routes.root_url }}" aria-label="{{ shop.name }} home">
      {%- if logo != blank -%}
        <img
          src="{{ logo | image_url: height: 80 }}"
          alt="{{ shop.name }}"
          width="{{ logo.width }}"
          height="{{ logo.height }}"
          loading="eager"
          fetchpriority="high"
        >
      {%- else -%}
        <span style="font-family:var(--font-display);font-size:1.5rem;font-weight:900;letter-spacing:-0.04em;text-transform:uppercase">
          {{ shop.name }}
        </span>
      {%- endif -%}
    </a>

    <!-- Actions (Right) -->
    <div class="site-header__actions">
      <button
        class="icon-btn"
        data-search-trigger
        aria-label="Search"
        aria-expanded="false"
        aria-controls="search-overlay"
      >
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M17.5 17.5L13.875 13.875M15.833 9.167A6.667 6.667 0 1 1 2.5 9.167a6.667 6.667 0 0 1 13.333 0Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
        </svg>
      </button>

      {%- if shop.customer_accounts_enabled -%}
        <a
          class="icon-btn"
          href="{{ routes.account_url }}"
          aria-label="{% if customer %}Account{% else %}Log in{% endif %}"
        >
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M16.667 17.5v-1.667A3.333 3.333 0 0 0 13.333 12.5H6.667a3.333 3.333 0 0 0-3.334 3.333V17.5M10 9.167a3.333 3.333 0 1 0 0-6.667 3.333 3.333 0 0 0 0 6.667Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
        </a>
      {%- endif -%}

      <button
        class="header-cart-btn"
        data-cart-trigger
        aria-label="Open bag"
        aria-expanded="false"
        aria-controls="cart-drawer"
      >
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path d="M2.5 2.5H4.167l2.416 10.816a1.667 1.667 0 0 0 1.667 1.35h7.5a1.667 1.667 0 0 0 1.667-1.35l1.25-7.483H5.417M7.5 17.5a.833.833 0 1 0 0-1.667.833.833 0 0 0 0 1.667ZM15.833 17.5a.833.833 0 1 0 0-1.667.833.833 0 0 0 0 1.667Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <span class="header-cart-count" data-cart-count aria-label="Items in bag">
          {{- cart.item_count -}}
        </span>
      </button>

      <!-- Mobile Toggle -->
      <button
        class="mobile-menu-btn"
        id="mobile-menu-btn"
        aria-label="Open navigation menu"
        aria-expanded="false"
        aria-controls="mobile-drawer"
      >
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>

  </div>
</header>

<!-- Mobile Drawer -->
<div class="mobile-drawer" id="mobile-drawer" aria-modal="true" role="dialog" aria-label="Navigation">
  <div class="mobile-drawer__overlay" id="mobile-drawer-overlay"></div>
  <div class="mobile-drawer__panel">
    <button class="mobile-drawer__close" id="mobile-drawer-close" aria-label="Close navigation">
      <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
        <path d="M1 1L17 17M17 1L1 17" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
      </svg>
    </button>

    <nav aria-label="Mobile navigation">
      <ul class="mobile-nav__list" role="list">

        <li class="mobile-nav__item">
          <a class="mobile-nav__link" href="/collections/all-shoes">Football Boots</a>
        </li>

        <li class="mobile-nav__item">
          <button class="mobile-nav__link" data-has-sub aria-expanded="false">
            Nike
            <svg width="12" height="8" viewBox="0 0 12 8" fill="none" aria-hidden="true">
              <path d="M1 1.5L6 6.5L11 1.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
          </button>
          <ul class="mobile-nav__sub-list" role="list">
            <li><a class="mobile-nav__sub-link" href="/collections/nike">All Nike</a></li>
            <li><a class="mobile-nav__sub-link" href="/collections/nike-mercurial">Mercurial</a></li>
            <li><a class="mobile-nav__sub-link" href="/collections/nike-phantom">Phantom</a></li>
          </ul>
        </li>

        <li class="mobile-nav__item">
          <button class="mobile-nav__link" data-has-sub aria-expanded="false">
            Adidas
            <svg width="12" height="8" viewBox="0 0 12 8" fill="none" aria-hidden="true">
              <path d="M1 1.5L6 6.5L11 1.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
          </button>
          <ul class="mobile-nav__sub-list" role="list">
            <li><a class="mobile-nav__sub-link" href="/collections/adidas">All Adidas</a></li>
            <li><a class="mobile-nav__sub-link" href="/collections/adidas-predator">Predator</a></li>
            <li><a class="mobile-nav__sub-link" href="/collections/adidas-x">X Crazyfast</a></li>
          </ul>
        </li>

        <li class="mobile-nav__item">
          <a class="mobile-nav__link" href="/collections/football-jerseys">Jerseys</a>
        </li>

        <li class="mobile-nav__item">
          <a class="mobile-nav__link" href="/collections/football-equipment">Equipment</a>
        </li>

      </ul>
    </nav>

    <div style="margin-top:auto;padding-top:2rem;border-top:1px solid var(--color-border)">
      {%- if shop.customer_accounts_enabled -%}
        <a href="{{ routes.account_url }}" class="btn btn--outline btn--full" style="margin-bottom:0.75rem">
          {%- if customer -%}My Account{%- else -%}Log In{%- endif -%}
        </a>
      {%- endif -%}
      <button class="btn btn--primary btn--full" data-cart-trigger>
        View Bag
        {%- if cart.item_count > 0 -%}
          <span style="background:var(--color-accent);color:#fff;width:20px;height:20px;border-radius:50%;display:inline-flex;align-items:center;justify-content:center;font-size:11px">
            {{ cart.item_count }}
          </span>
        {%- endif -%}
      </button>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Header",
  "class": "section-header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    },
    {
      "type": "link_list",
      "id": "menu",
      "default": "main-menu",
      "label": "Navigation menu"
    },
    {
      "type": "image_picker",
      "id": "mega_menu_image",
      "label": "Mega menu feature image"
    },
    {
      "type": "url",
      "id": "mega_menu_link",
      "label": "Mega menu feature link"
    },
    {
      "type": "text",
      "id": "mega_menu_label",
      "label": "Mega menu feature label",
      "default": "New Collection"
    }
  ]
}
{% endschema %}
